<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90"><%= @notification_channel.name %></h1>
        <%= status_badge(@notification_channel.enabled? ? "enabled" : "disabled") %>
      </div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @notification_channel.channel_type.titleize %> Notification</p>
    </div>
    <div class="mt-4 flex space-x-3 sm:mt-0">
      <%= button_to test_notification_channel_path(@notification_channel), method: :post, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 2a6 6 0 00-6 6c0 1.887-.454 3.665-1.257 5.234a.75.75 0 00.515 1.076 32.91 32.91 0 003.256.508 3.5 3.5 0 006.972 0 32.903 32.903 0 003.256-.508.75.75 0 00.515-1.076A11.448 11.448 0 0116 8a6 6 0 00-6-6zM8.05 14.943a33.54 33.54 0 003.9 0 2 2 0 01-3.9 0z" clip-rule="evenodd" />
        </svg>
        Send Test
      <% end %>
      <%= link_to edit_notification_channel_path(@notification_channel), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
        </svg>
        Edit
      <% end %>
      <%= button_to notification_channel_path(@notification_channel), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this notification channel?" }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Channel Configuration</h3>
    </div>
    <div class="border-t border-gray-200 dark:border-gray-800">
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Type</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.channel_type.titleize %></dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <%= status_badge(@notification_channel.enabled? ? "enabled" : "disabled") %>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Notify On</dt>
          <dd class="mt-1 text-sm sm:col-span-2 sm:mt-0">
            <div class="flex flex-wrap gap-2">
              <% if @notification_channel.notify_on_success? %>
                <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                  <svg class="-ml-0.5 mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                  Success
                </span>
              <% end %>
              <% if @notification_channel.notify_on_failure? %>
                <span class="inline-flex items-center rounded-full bg-red-50 px-2.5 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                  <svg class="-ml-0.5 mr-1 h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-5a.75.75 0 01.75.75v4.5a.75.75 0 01-1.5 0v-4.5A.75.75 0 0110 5zm0 10a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
                  </svg>
                  Failure
                </span>
              <% end %>
              <% unless @notification_channel.notify_on_success? || @notification_channel.notify_on_failure? %>
                <span class="text-gray-500 text-sm">No events selected</span>
              <% end %>
            </div>
          </dd>
        </div>
        <% case @notification_channel.channel_type %>
        <% when "email" %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">To Address</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.to_address.presence || "(not set)" %></dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">From Address</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.from_address %></dd>
          </div>
        <% when "slack" %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Webhook URL</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono text-xs break-all">
              <%= @notification_channel.webhook_url.present? ? @notification_channel.webhook_url[0..40] + "..." : "(not set)" %>
            </dd>
          </div>
          <% if @notification_channel.channel.present? %>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Channel</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.channel %></dd>
            </div>
          <% end %>
        <% when "discord" %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Webhook URL</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono text-xs break-all">
              <%= @notification_channel.webhook_url.present? ? @notification_channel.webhook_url[0..40] + "..." : "(not set)" %>
            </dd>
          </div>
        <% when "telegram" %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Chat ID</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.chat_id.presence || "(not set)" %></dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Bot Token</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono">
              <%= @notification_channel.bot_token.present? ? "****" + @notification_channel.bot_token[-4..-1].to_s : "(not set)" %>
            </dd>
          </div>
        <% when "webhook" %>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Webhook URL</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono text-xs break-all">
              <%= @notification_channel.url.presence || "(not set)" %>
            </dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">HTTP Method</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.http_method %></dd>
          </div>
          <% if @notification_channel.headers.present? %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Custom Headers</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono text-xs">
                <% @notification_channel.headers.each do |key, value| %>
                  <div><%= key %>: <%= value.to_s[0..20] %><%= "..." if value.to_s.length > 20 %></div>
                <% end %>
              </dd>
            </div>
          <% end %>
        <% end %>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @notification_channel.created_at.strftime("%B %d, %Y at %H:%M") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Backup Jobs Using This Channel</h3>
    </div>
    <div class="border-t border-gray-200 dark:border-gray-800">
      <% if @notification_channel.backup_jobs.any? %>
        <ul class="divide-y divide-gray-200">
          <% @notification_channel.backup_jobs.each do |job| %>
            <li class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div>
                  <%= link_to job.name, backup_job_path(job), class: "text-sm font-medium text-primary-500 hover:text-indigo-500" %>
                  <p class="text-sm text-gray-500"><%= job.database_config.name %> &middot; <%= job.schedule_type.titleize %></p>
                </div>
                <%= status_badge(job.enabled? ? "enabled" : "disabled") %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-4 py-5 sm:px-6 text-center">
          <p class="text-sm text-gray-500">No backup jobs are using this notification channel.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
