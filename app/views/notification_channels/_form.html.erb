<%= form_with model: notification_channel, scope: :notification_channel, url: notification_channel.persisted? ? notification_channel_path(notification_channel) : notification_channels_path, class: "space-y-6", data: { controller: "notification-channel-form" } do |f| %>
  <% if notification_channel.errors.any? %>
    <div class="rounded-lg border border-error-300 bg-error-50 p-4 dark:border-error-500/30 dark:bg-error-500/10">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-error-500" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-error-800 dark:text-error-200">There were errors with your submission</h3>
          <div class="mt-2 text-sm text-error-700 dark:text-error-300">
            <ul class="list-disc space-y-1 pl-5">
              <% notification_channel.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Basic Information Section %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Basic Information</h3>
    </div>
    <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <%# Name Field %>
      <div>
        <%= f.label :name, class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
        <%= f.text_field :name, placeholder: "Production Alerts", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
      </div>

      <%# Channel Type Field %>
      <div>
        <%= f.label :channel_type, "Channel Type", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
        <div class="relative">
          <%= f.select :channel_type, [
            ["Email", "email"],
            ["Slack", "slack"],
            ["Discord", "discord"],
            ["Telegram", "telegram"],
            ["Webhook", "webhook"]
          ], { selected: notification_channel.persisted? ? notification_channel.channel_type : "email" }, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent bg-none px-4 py-2.5 pr-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30", data: { action: "change->notification-channel-form#toggleChannelType", notification_channel_form_target: "typeSelect" } %>
          <span class="pointer-events-none absolute top-1/2 right-4 z-30 -translate-y-1/2 text-gray-500 dark:text-gray-400">
            <svg class="stroke-current" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4.79175 7.396L10.0001 12.6043L15.2084 7.396" stroke="" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </div>
      </div>

      <%# Enabled Checkbox %>
      <div data-controller="checkbox" data-checkbox-checked-value="<%= notification_channel.enabled? %>" data-checkbox-checked-class="border-brand-500 bg-brand-500" data-checkbox-unchecked-class="bg-transparent border-gray-300 dark:border-gray-700">
        <label for="notification_channel_enabled" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400" >
          <div class="relative">
            <%= f.check_box :enabled, { class: "sr-only", data: { checkbox_target: "input" } } %>
            <div data-checkbox-target="box" class="hover:border-brand-500 dark:hover:border-brand-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px] <%= notification_channel.enabled? ? 'border-brand-500 bg-brand-500' : 'bg-transparent border-gray-300 dark:border-gray-700' %>">
              <span data-checkmark class="<%= notification_channel.enabled? ? '' : 'opacity-0' %>">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-800 dark:text-white/90">Enabled</span>
            <p class="text-sm text-gray-500 dark:text-gray-400">Receive notifications through this channel</p>
          </div>
        </label>
      </div>
    </div>
  </div>

  <%# Notification Events Section %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Notification Events</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Choose which events trigger notifications through this channel.</p>
    </div>
    <div class="space-y-5 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <%# Notify on Success %>
      <div data-controller="checkbox" data-checkbox-checked-value="<%= notification_channel.notify_on_success? %>" data-checkbox-checked-class="border-success-500 bg-success-500" data-checkbox-unchecked-class="bg-transparent border-gray-300 dark:border-gray-700">
        <label for="notification_channel_notify_on_success" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400" >
          <div class="relative">
            <%= f.check_box :notify_on_success, { class: "sr-only", data: { checkbox_target: "input" } } %>
            <div data-checkbox-target="box" class="hover:border-success-500 dark:hover:border-success-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px] <%= notification_channel.notify_on_success? ? 'border-success-500 bg-success-500' : 'bg-transparent border-gray-300 dark:border-gray-700' %>">
              <span data-checkmark class="<%= notification_channel.notify_on_success? ? '' : 'opacity-0' %>">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-800 dark:text-white/90">Notify on Success</span>
            <p class="text-sm text-gray-500 dark:text-gray-400">Send notification when a backup completes successfully</p>
          </div>
        </label>
      </div>

      <%# Notify on Failure %>
      <div data-controller="checkbox" data-checkbox-checked-value="<%= notification_channel.notify_on_failure? %>" data-checkbox-checked-class="border-error-500 bg-error-500" data-checkbox-unchecked-class="bg-transparent border-gray-300 dark:border-gray-700">
        <label for="notification_channel_notify_on_failure" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400" >
          <div class="relative">
            <%= f.check_box :notify_on_failure, { class: "sr-only", data: { checkbox_target: "input" } } %>
            <div data-checkbox-target="box" class="hover:border-error-500 dark:hover:border-error-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px] <%= notification_channel.notify_on_failure? ? 'border-error-500 bg-error-500' : 'bg-transparent border-gray-300 dark:border-gray-700' %>">
              <span data-checkmark class="<%= notification_channel.notify_on_failure? ? '' : 'opacity-0' %>">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-800 dark:text-white/90">Notify on Failure</span>
            <p class="text-sm text-gray-500 dark:text-gray-400">Send notification when a backup fails</p>
          </div>
        </label>
      </div>
    </div>
  </div>

  <%# Email Configuration %>
  <div id="email-fields" class="<%= notification_channel.persisted? && notification_channel.channel_type != 'email' ? 'hidden' : '' %>" data-notification-channel-form-target="emailFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Email Configuration</h3>
      </div>
      <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
          <div>
            <%= label_tag "notification_channel_config_to_address", "To Address", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= email_field_tag "notification_channel[config][to_address]", notification_channel.config&.dig(:to_address), id: "notification_channel_config_to_address", placeholder: "alerts@example.com", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          </div>
          <div>
            <%= label_tag "notification_channel_config_from_address", "From Address", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= email_field_tag "notification_channel[config][from_address]", notification_channel.config&.dig(:from_address), id: "notification_channel_config_from_address", placeholder: "backups@example.com", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# Slack Configuration %>
  <div id="slack-fields" class="<%= !notification_channel.persisted? || notification_channel.channel_type != 'slack' ? 'hidden' : '' %>" data-notification-channel-form-target="slackFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Slack Configuration</h3>
      </div>
      <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <%= label_tag "notification_channel_config_slack_webhook_url", "Webhook URL", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= url_field_tag "notification_channel[config][slack_webhook_url]", notification_channel.config&.dig(:webhook_url), id: "notification_channel_config_slack_webhook_url", placeholder: "https://hooks.slack.com/services/...", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Create an Incoming Webhook in your Slack workspace settings</p>
        </div>
        <div>
          <%= label_tag "notification_channel_config_channel", "Channel (Optional)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "notification_channel[config][channel]", notification_channel.config&.dig(:channel), id: "notification_channel_config_channel", placeholder: "#alerts", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Override the default channel configured in the webhook</p>
        </div>
      </div>
    </div>
  </div>

  <%# Discord Configuration %>
  <div id="discord-fields" class="<%= !notification_channel.persisted? || notification_channel.channel_type != 'discord' ? 'hidden' : '' %>" data-notification-channel-form-target="discordFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Discord Configuration</h3>
      </div>
      <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <%= label_tag "notification_channel_config_discord_webhook_url", "Webhook URL", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= url_field_tag "notification_channel[config][discord_webhook_url]", notification_channel.config&.dig(:webhook_url), id: "notification_channel_config_discord_webhook_url", placeholder: "https://discord.com/api/webhooks/...", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Create a Webhook in your Discord server channel settings</p>
        </div>
      </div>
    </div>
  </div>

  <%# Telegram Configuration %>
  <div id="telegram-fields" class="<%= !notification_channel.persisted? || notification_channel.channel_type != 'telegram' ? 'hidden' : '' %>" data-notification-channel-form-target="telegramFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Telegram Configuration</h3>
      </div>
      <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <%= label_tag "notification_channel_config_bot_token", "Bot Token", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div x-data="{ showPassword: false }" class="relative">
            <%= password_field_tag "notification_channel[config][bot_token]", nil, id: "notification_channel_config_bot_token", placeholder: notification_channel.persisted? ? "Leave blank to keep current" : "Enter bot token", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30", "x-bind:type": "showPassword ? 'text' : 'password'" %>
            <span @click="showPassword = !showPassword" class="absolute top-1/2 right-4 z-30 -translate-y-1/2 cursor-pointer">
              <svg x-show="!showPassword" class="fill-gray-500 dark:fill-gray-400" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.0002 13.8619C7.23361 13.8619 4.86803 12.1372 3.92328 9.70241C4.86804 7.26761 7.23361 5.54297 10.0002 5.54297C12.7667 5.54297 15.1323 7.26762 16.0771 9.70243C15.1323 12.1372 12.7667 13.8619 10.0002 13.8619ZM10.0002 4.04297C6.48191 4.04297 3.49489 6.30917 2.4155 9.4593C2.3615 9.61687 2.3615 9.78794 2.41549 9.94552C3.49488 13.0957 6.48191 15.3619 10.0002 15.3619C13.5184 15.3619 16.5055 13.0957 17.5849 9.94555C17.6389 9.78797 17.6389 9.6169 17.5849 9.45932C16.5055 6.30919 13.5184 4.04297 10.0002 4.04297ZM9.99151 7.84413C8.96527 7.84413 8.13333 8.67606 8.13333 9.70231C8.13333 10.7286 8.96527 11.5605 9.99151 11.5605H10.0064C11.0326 11.5605 11.8646 10.7286 11.8646 9.70231C11.8646 8.67606 11.0326 7.84413 10.0064 7.84413H9.99151Z"></path>
              </svg>
              <svg x-show="showPassword" class="fill-gray-500 dark:fill-gray-400" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: none;">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M4.63803 3.57709C4.34513 3.2842 3.87026 3.2842 3.57737 3.57709C3.28447 3.86999 3.28447 4.34486 3.57737 4.63775L4.85323 5.91362C3.74609 6.84199 2.89363 8.06395 2.4155 9.45936C2.3615 9.61694 2.3615 9.78801 2.41549 9.94558C3.49488 13.0957 6.48191 15.3619 10.0002 15.3619C11.255 15.3619 12.4422 15.0737 13.4994 14.5598L15.3625 16.4229C15.6554 16.7158 16.1302 16.7158 16.4231 16.4229C16.716 16.13 16.716 15.6551 16.4231 15.3622L4.63803 3.57709ZM12.3608 13.4212L10.4475 11.5079C10.3061 11.5423 10.1584 11.5606 10.0064 11.5606H9.99151C8.96527 11.5606 8.13333 10.7286 8.13333 9.70237C8.13333 9.5461 8.15262 9.39434 8.18895 9.24933L5.91885 6.97923C5.03505 7.69015 4.34057 8.62704 3.92328 9.70247C4.86803 12.1373 7.23361 13.8619 10.0002 13.8619C10.8326 13.8619 11.6287 13.7058 12.3608 13.4212ZM16.0771 9.70249C15.7843 10.4569 15.3552 11.1432 14.8199 11.7311L15.8813 12.7925C16.6329 11.9813 17.2187 11.0143 17.5849 9.94561C17.6389 9.78803 17.6389 9.61696 17.5849 9.45938C16.5055 6.30925 13.5184 4.04303 10.0002 4.04303C9.13525 4.04303 8.30244 4.17999 7.52218 4.43338L8.75139 5.66259C9.1556 5.58413 9.57311 5.54303 10.0002 5.54303C12.7667 5.54303 15.1323 7.26768 16.0771 9.70249Z"></path>
              </svg>
            </span>
          </div>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Get a bot token from @BotFather on Telegram</p>
        </div>
        <div>
          <%= label_tag "notification_channel_config_chat_id", "Chat ID", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "notification_channel[config][chat_id]", notification_channel.config&.dig(:chat_id), id: "notification_channel_config_chat_id", placeholder: "-1001234567890", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">The chat, group, or channel ID to send messages to</p>
        </div>
      </div>
    </div>
  </div>

  <%# Webhook Configuration %>
  <div id="webhook-fields" class="<%= !notification_channel.persisted? || notification_channel.channel_type != 'webhook' ? 'hidden' : '' %>" data-notification-channel-form-target="webhookFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-medium text-gray-800 dark:text-white/90">Webhook Configuration</h3>
      </div>
      <div class="space-y-6 border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <%= label_tag "notification_channel_config_url", "Webhook URL", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= url_field_tag "notification_channel[config][url]", notification_channel.config&.dig(:url), id: "notification_channel_config_url", placeholder: "https://example.com/webhook", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">URL to receive POST requests with backup event data</p>
        </div>
        <div>
          <%= label_tag "notification_channel_config_method", "HTTP Method", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= select_tag "notification_channel[config][method]", options_for_select([["POST", "POST"], ["PUT", "PUT"]], notification_channel.config&.dig(:method) || "POST"), id: "notification_channel_config_method", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent bg-none px-4 py-2.5 pr-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
            <span class="pointer-events-none absolute top-1/2 right-4 z-30 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="stroke-current" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4.79175 7.396L10.0001 12.6043L15.2084 7.396" stroke="" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </span>
          </div>
        </div>
        <div>
          <%= label_tag "notification_channel_config_headers", "Custom Headers (Optional)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_area_tag "notification_channel[config][headers]", notification_channel.config&.dig(:headers)&.map { |k, v| "#{k}: #{v}" }&.join("\n"), id: "notification_channel_config_headers", placeholder: "Authorization: Bearer token\nX-Custom-Header: value", rows: 3, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">One header per line in format: Header-Name: value</p>
        </div>
      </div>
    </div>
  </div>

  <%# Form Actions %>
  <div class="flex justify-end gap-3">
    <%= link_to "Cancel", notification_channels_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 hover:text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-gray-200" %>
    <%= f.submit notification_channel.persisted? ? "Update Channel" : "Create Channel", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer" %>
  </div>
<% end %>
