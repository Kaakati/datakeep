<%# Plan Identity Banner — Section 1 of billing redesign
     Shows current plan tier, price, billing interval, and status alerts.

     Expected instance variables:
       @current_tier    — Symbol (:free, :starter, :professional, :business, :enterprise)
       @subscription    — Subscription or nil
       @quote           — EnterpriseQuote or nil (enterprise tier only)
%>
<%
  badge_classes = {
    free:         "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400",
    starter:      "bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300",
    professional: "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300",
    business:     "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
    enterprise:   "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300"
  }
%>

<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] border-l-4 <%= plan_accent_class(@current_tier) %> overflow-hidden">
  <div class="px-5 py-4 sm:px-6 sm:py-5">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <%# Left: Badge + plan name + member since %>
      <div class="flex flex-col gap-1">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold tracking-wide uppercase <%= badge_classes[@current_tier] || badge_classes[:free] %>">
            <%= current_user.plan_name %>
          </span>
          <% if @current_tier == :free %>
            <span class="text-sm text-gray-500 dark:text-gray-400">Free forever &mdash; no credit card required</span>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Member since <%= current_user.created_at.strftime("%b %Y") %>
        </p>
      </div>

      <%# Right: Price + interval + renewal %>
      <% if @current_tier != :free %>
        <div class="text-left sm:text-right">
          <% if @current_tier == :enterprise && @quote %>
            <p class="text-lg font-bold text-gray-900 dark:text-white">
              <%= format_plan_price(@quote.total_monthly_cents, "monthly") %>
              <span class="text-sm font-normal text-gray-500 dark:text-gray-400">Enterprise</span>
            </p>
          <% elsif @subscription&.active_access? %>
            <p class="text-lg font-bold text-gray-900 dark:text-white">
              <%= format_plan_price(
                @tier_definitions[@current_tier]&.dig(:monthly_price_cents),
                @subscription.billing_interval
              ) %>
              <span class="text-sm font-normal text-gray-500 dark:text-gray-400">
                &middot; <%= @subscription.billing_interval.capitalize %>
              </span>
            </p>
            <% unless @subscription.cancel_at_period_end? %>
              <p class="text-sm text-gray-500 dark:text-gray-400">
                Renews <%= @subscription.current_period_end.strftime("%b %-d") %>
              </p>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Canceling warning strip %>
  <% if @subscription&.cancel_at_period_end? %>
    <div class="border-t border-amber-200 bg-amber-50 px-5 py-3 sm:px-6 dark:border-amber-800/40 dark:bg-amber-900/20">
      <p class="text-sm font-medium text-amber-800 dark:text-amber-300">
        Canceling &mdash; access through <%= @subscription.current_period_end.strftime("%b %-d, %Y") %>
      </p>
    </div>
  <% end %>

  <%# Past-due warning strip %>
  <% if @subscription&.past_due? %>
    <div class="border-t border-red-200 bg-red-50 px-5 py-3 sm:px-6 dark:border-red-800/40 dark:bg-red-900/20">
      <p class="text-sm font-medium text-red-800 dark:text-red-300">
        Payment issue &mdash; update your payment method
      </p>
    </div>
  <% end %>
</div>
