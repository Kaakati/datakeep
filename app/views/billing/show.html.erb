<div class="w-full space-y-6">
  <%# Page Header %>
  <div>
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Billing & Plan</h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your subscription and view usage</p>
  </div>

  <%# Checkout result flash %>
  <% if params[:checkout] == "success" %>
    <div class="rounded-lg bg-green-50 p-4 dark:bg-green-900/20">
      <p class="text-sm font-medium text-green-800 dark:text-green-300">Your subscription is being activated. It may take a moment to reflect here.</p>
    </div>
  <% elsif params[:checkout] == "canceled" %>
    <div class="rounded-lg bg-amber-50 p-4 dark:bg-amber-900/20">
      <p class="text-sm font-medium text-amber-800 dark:text-amber-300">Checkout was canceled. No charges were made.</p>
    </div>
  <% end %>

  <%# Section 1: Plan Identity Banner %>
  <%= render "billing/plan_identity_banner" %>

  <%# Section 2: Usage Pulse Grid %>
  <%= render "billing/usage_pulse" %>

  <%# Section 3: What's Next %>
  <%= render "billing/whats_next" %>

  <%# Section 4: Billing Management (paid/enterprise only) %>
  <% if @subscription&.active_access? %>
    <%= render "billing/billing_management" %>
  <% end %>
</div>
