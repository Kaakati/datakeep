<%# Subscription Management — billing date, portal link, cancel button %>
<% if @subscription&.active_access? %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Subscription Management</h3>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="space-y-4">
        <%# Next billing date %>
        <% if @subscription.current_period_end %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-500 dark:text-gray-400">
              <%= @subscription.cancel_at_period_end? ? "Access until" : "Next billing date" %>
            </span>
            <span class="text-sm font-medium text-gray-900 dark:text-white">
              <%= @subscription.current_period_end.strftime("%B %d, %Y") %>
            </span>
          </div>
        <% end %>

        <%# Billing interval %>
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-500 dark:text-gray-400">Billing interval</span>
          <span class="text-sm font-medium text-gray-900 dark:text-white capitalize"><%= @subscription.billing_interval %></span>
        </div>

        <%# Cancellation notice %>
        <% if @subscription.cancel_at_period_end? %>
          <div class="rounded-lg bg-amber-50 p-3 dark:bg-amber-900/20">
            <p class="text-sm text-amber-800 dark:text-amber-300">
              Your subscription is set to cancel. You'll retain access until
              <strong><%= @subscription.current_period_end&.strftime("%B %d, %Y") %></strong>,
              then revert to the Free plan.
            </p>
          </div>
        <% end %>

        <%# Action buttons %>
        <div class="flex items-center gap-3 pt-2">
          <%= form_with url: stripe_portal_path, method: :post do %>
            <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" /></svg>
              Manage Billing
            </button>
          <% end %>

          <% unless @subscription.cancel_at_period_end? %>
            <%= form_with url: subscription_path, method: :delete, data: { turbo_confirm: "Are you sure you want to cancel your subscription? You'll retain access until the end of your billing period." } do %>
              <button type="submit" class="inline-flex items-center gap-1.5 rounded-lg border border-red-300 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition dark:border-red-800 dark:bg-gray-800 dark:text-red-400 dark:hover:bg-red-900/20">
                Cancel Subscription
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
