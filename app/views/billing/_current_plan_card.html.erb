<%# Current Plan Card — shows plan name, price, usage bars %>
<%#
  Locals:
    plan_limits       — Hash from User#plan_limits
    usage             — Hash from User#resource_usage
    current_tier      — Symbol (:free, :starter, :professional, :business, :enterprise)
    tier_definitions  — PlanTierLimits::TIER_DEFINITIONS
    subscription      — Subscription or nil
%>
<% tier_def = tier_definitions[current_tier] || tier_definitions[:free] %>

<div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
  <div class="px-5 py-4 sm:px-6 sm:py-5">
    <div class="flex items-center justify-between">
      <div>
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Current Plan</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Your resource usage</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-semibold
          <%= current_tier == :free ? 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400' :
              current_tier == :enterprise ? 'bg-primary-100 text-primary-800 dark:bg-primary-900/30 dark:text-primary-300' :
              'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300' %>">
          <%= current_user.plan_name %>
        </span>
        <% if subscription&.active_access? && !current_user.enterprise_plan? %>
          <div class="text-right">
            <p class="text-lg font-bold text-gray-900 dark:text-white">
              $<%= "%.2f" % (tier_def[:monthly_price_cents] / 100.0) %><span class="text-sm font-normal text-gray-500">/mo</span>
            </p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
    <div class="space-y-4">
      <%= usage_bar "Databases",       used: usage[:database_configs],  limit: plan_limits[:max_database_configs] %>
      <%= usage_bar "Backup Jobs",     used: usage[:backup_jobs],       limit: plan_limits[:max_backup_jobs] %>

      <%# Retention — display only, no bar %>
      <div>
        <div class="flex justify-between mb-1.5">
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Retention</span>
          <span class="text-sm text-gray-500 dark:text-gray-400"><%= plan_limits[:max_retention_days] %> days</span>
        </div>
      </div>

      <%= usage_bar "Sync Jobs",       used: usage[:sync_jobs],         limit: plan_limits[:max_sync_jobs] %>
      <%= usage_bar "Restores (30d)",  used: usage[:restores_this_month], limit: plan_limits[:max_restores_per_month] %>

      <%# S3 Access — boolean feature flag %>
      <div>
        <div class="flex items-center gap-2">
          <% if plan_limits[:s3_allowed] %>
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          <% else %>
            <svg class="h-4 w-4 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          <% end %>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">S3 Cloud Storage</span>
        </div>
      </div>
    </div>
  </div>
</div>
