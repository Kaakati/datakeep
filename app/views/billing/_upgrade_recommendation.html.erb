<%# Upgrade Recommendation — shown to free-tier users
     Gradient banner with personalized nudge + inline coupon, then full pricing grid below %>

<%# Gradient upgrade banner %>
<div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-700 to-primary-900 dark:from-primary-800 dark:to-primary-950">
  <%# Decorative circles %>
  <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10"></div>
  <div class="pointer-events-none absolute -bottom-6 -left-6 h-24 w-24 rounded-full bg-white/5"></div>

  <div class="relative px-6 py-6 sm:px-8 sm:py-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex-1">
        <h3 class="text-lg font-semibold text-white">
          <% if @hit_limits.any? %>
            Unlock more from DataKeep
          <% else %>
            Ready to grow?
          <% end %>
        </h3>
        <p class="mt-1.5 text-sm text-primary-200">
          <% if @hit_limits.any? %>
            You've hit your <strong class="text-white"><%= @hit_limits.first.downcase %></strong> limit.
            <strong class="text-white">Starter</strong> unlocks
            <%= @hit_limits.first.downcase == "databases" ? "3 databases" : "more #{@hit_limits.first.downcase}" %>,
            Cloud storage (AWS/GCP), and 14-day retention &mdash; from <strong class="text-white">$39/mo</strong>.
          <% else %>
            Upgrade to unlock more databases, faster backup intervals, and cloud storage.
            Plans start at <strong class="text-white">$39/mo</strong>.
          <% end %>
        </p>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a href="#pricing-grid"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-600 shadow-sm transition">
            View Plans
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3" />
            </svg>
          </a>

          <%# Inline coupon %>
          <details class="group">
            <summary class="cursor-pointer text-sm font-medium text-primary-300 hover:text-white transition select-none">
              Have a coupon?
            </summary>
            <div class="mt-2 flex items-center gap-2" data-controller="coupon-code">
              <input type="text" placeholder="Enter code" data-coupon-code-target="input"
                class="rounded-lg border border-primary-400/30 bg-white/15 px-3 py-1.5 text-sm uppercase text-white placeholder-primary-200 backdrop-blur focus:border-white/50 focus:ring focus:ring-white/20 focus:outline-none">
              <button type="button" data-action="click->coupon-code#apply"
                class="rounded-lg bg-white/15 px-3 py-1.5 text-sm font-medium text-white hover:bg-white/25 transition">
                Apply
              </button>
              <span data-coupon-code-target="feedback" class="hidden text-sm text-primary-200"></span>
              <input type="hidden" value="" data-coupon-code-target="hiddenFields">
            </div>
          </details>
        </div>
      </div>

      <%# Feature highlights — right side on desktop %>
      <div class="flex shrink-0 flex-col gap-2 sm:items-end">
        <div class="flex items-center gap-2 text-sm text-primary-200">
          <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          Up to 30 databases
        </div>
        <div class="flex items-center gap-2 text-sm text-primary-200">
          <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          Cloud storage (AWS/GCP)
        </div>
        <div class="flex items-center gap-2 text-sm text-primary-200">
          <svg class="h-4 w-4 text-accent-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
          Up to 365-day retention
        </div>
      </div>
    </div>
  </div>
</div>

<%# Full pricing grid %>
<div id="pricing-grid">
  <%= render "billing/pricing_grid" %>
</div>
