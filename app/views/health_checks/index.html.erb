<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Health Checks</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Monitor database connectivity over time</p>
    </div>
    <div class="mt-4 sm:mt-0 flex items-center gap-3">
      <span class="text-sm text-gray-500">Period:</span>
      <div class="inline-flex rounded-lg border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800 p-1" role="group">
        <%= link_to "Today", health_checks_path(period: "today"),
            class: "px-3 py-1.5 text-sm font-medium rounded-md transition-colors #{@period == 'today' ? 'bg-primary-500 text-white' : 'text-gray-600 hover:bg-gray-50'}" %>
        <%= link_to "7 Days", health_checks_path(period: "7days"),
            class: "px-3 py-1.5 text-sm font-medium rounded-md transition-colors #{@period == '7days' ? 'bg-primary-500 text-white' : 'text-gray-600 hover:bg-gray-50'}" %>
        <%= link_to "30 Days", health_checks_path(period: "30days"),
            class: "px-3 py-1.5 text-sm font-medium rounded-md transition-colors #{@period == '30days' ? 'bg-primary-500 text-white' : 'text-gray-600 hover:bg-gray-50'}" %>
      </div>
    </div>
  </div>

  <% if @database_configs.any? %>
    <div class="space-y-4">
      <% @database_configs.each do |db| %>
        <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
          <div class="px-5 py-4 sm:px-6 border-b border-gray-100">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-5">
                <% if db.healthy? %>
                  <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-green-50 text-green-500">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                  </div>
                <% elsif db.unhealthy? %>
                  <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-red-50 text-red-500">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                  </div>
                <% else %>
                  <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-gray-100 text-gray-600">
                    <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
                    </svg>
                  </div>
                <% end %>
                <div>
                  <%= link_to db.name, db, class: "text-base font-semibold text-gray-900 hover:text-primary-600" %>
                  <p class="text-sm text-gray-500"><%= db.host %>:<%= db.port %>/<%= db.database_name %></p>
                </div>
              </div>
              <div class="text-right">
                <% checks = @health_checks_by_config&.dig(db.id) || [] %>
                <% healthy_count = checks.count(&:healthy?) %>
                <% total_count = checks.count %>
                <% uptime = total_count > 0 ? (healthy_count.to_f / total_count * 100).round(1) : 0 %>
                <span class="text-lg font-bold <%= uptime >= 99 ? 'text-green-600' : uptime >= 95 ? 'text-yellow-600' : 'text-red-600' %>">
                  <%= uptime %>%
                </span>
                <p class="text-xs text-gray-500"><%= total_count %> checks</p>
              </div>
            </div>
          </div>
          <div class="px-5 py-4 sm:px-6">
            <% checks = @health_checks_by_config&.dig(db.id) || [] %>
            <% if checks.any? %>
              <div class="flex flex-wrap gap-1" data-controller="tooltip">
                <% checks.each do |check| %>
                  <div class="relative group">
                    <div
                      class="w-3 h-3 rounded-sm cursor-pointer transition-transform hover:scale-110 <%= check.healthy? ? 'bg-green-500' : 'bg-red-500' %>"
                    ></div>
                    <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-900 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none whitespace-nowrap z-10">
                      <div class="font-medium"><%= check.checked_at.strftime("%b %d, %Y %H:%M:%S") %></div>
                      <div class="<%= check.healthy? ? 'text-green-400' : 'text-red-400' %>">
                        <%= check.status.titleize %>
                        <% if check.response_time_ms %>
                          (<%= check.response_time_ms %>ms)
                        <% end %>
                      </div>
                      <% if check.error_message.present? %>
                        <div class="text-red-300 mt-1 max-w-xs truncate"><%= check.error_message %></div>
                      <% end %>
                      <div class="absolute top-full left-1/2 transform -translate-x-1/2 -mt-1">
                        <div class="border-4 border-transparent border-t-gray-900"></div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="mt-4 flex items-center gap-6 text-xs text-gray-500">
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 rounded-sm bg-green-500"></div>
                  <span>Healthy</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <div class="w-3 h-3 rounded-sm bg-red-500"></div>
                  <span>Unreachable</span>
                </div>
              </div>
            <% else %>
              <div class="text-center py-8">
                <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <p class="mt-2 text-sm text-gray-500">No health checks recorded yet for this period</p>
                <p class="text-xs text-gray-400">Health checks run automatically every 15 minutes</p>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] px-5 py-12 text-center sm:px-6">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
      </svg>
      <h3 class="mt-2 text-sm font-semibold text-gray-900">No databases configured</h3>
      <p class="mt-1 text-sm text-gray-500">Add a database to start monitoring health checks.</p>
      <div class="mt-4">
        <%= link_to new_database_config_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          Add Database
        <% end %>
      </div>
    </div>
  <% end %>
</div>
