<%# Admin Sidebar - TailAdmin style %>
<aside
  data-sidebar-target="sidebar"
  class="fixed left-0 top-0 z-40 flex h-screen w-[290px] flex-col overflow-y-hidden border-r border-gray-200 bg-white px-5 transition-all duration-300 ease-linear dark:border-gray-800 dark:bg-gray-900 lg:static lg:translate-x-0 lg:w-[290px] -translate-x-full"
  aria-label="Admin navigation"
  aria-hidden="true"
>
  <%# Sidebar Header %>
  <div class="flex items-center gap-2 pt-8 pb-7" data-sidebar-target="headerContent">
    <%= link_to admin_root_path, class: "flex items-center gap-3", data: { action: "click->sidebar#navigate" } do %>
      <%= image_tag "logo.svg", class: "h-10 w-10 shrink-0", alt: "DataKeep" %>
      <span class="menu-item-text font-bold text-xl text-gray-900 dark:text-white">DataKeep</span>
      <span class="menu-item-text inline-flex items-center rounded-md bg-primary-50 px-2 py-1 text-xs font-medium text-primary-700 ring-1 ring-inset ring-primary-600/20 dark:bg-primary-900/50 dark:text-primary-400">Admin</span>
    <% end %>

    <button
      type="button"
      class="lg:hidden ml-auto flex items-center justify-center p-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500"
      data-action="click->sidebar#closeMobile"
      aria-label="Close sidebar"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <%# Scrollable Navigation Container %>
  <div class="flex flex-col overflow-y-auto duration-300 ease-linear no-scrollbar">
    <nav>
      <%# Menu Group %>
      <div class="mb-6">
        <h3 class="mb-4 text-xs uppercase leading-5 text-gray-400 font-semibold tracking-wider">
          <span class="menu-group-title">Menu</span>
        </h3>
        <ul class="flex flex-col gap-0">
          <li>
            <%= link_to admin_root_path,
                class: "menu-item group #{current_page?(admin_root_path) ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= current_page?(admin_root_path) ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
              </svg>
              <span class="menu-item-text">Admin Dashboard</span>
            <% end %>
          </li>
        </ul>
      </div>

      <%# Management Group %>
      <div class="mb-6">
        <h3 class="mb-4 text-xs uppercase leading-5 text-gray-400 font-semibold tracking-wider">
          <span class="menu-group-title">Management</span>
        </h3>
        <ul class="flex flex-col gap-0">
          <li>
            <%= link_to admin_users_path,
                class: "menu-item group #{controller_name == 'users' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'users' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
              </svg>
              <span class="menu-item-text">Users</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_storage_backends_path,
                class: "menu-item group #{controller_name == 'storage_backends' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'storage_backends' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" />
              </svg>
              <span class="menu-item-text">Storage Backends</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_subscription_plans_path,
                class: "menu-item group #{controller_name == 'subscription_plans' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'subscription_plans' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
              </svg>
              <span class="menu-item-text">Subscription Plans</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_coupons_path,
                class: "menu-item group #{controller_name == 'coupons' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'coupons' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
              </svg>
              <span class="menu-item-text">Coupons</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_enterprise_quote_calculator_path,
                class: "menu-item group #{controller_name == 'quote_calculator' && controller.class.module_parent_name == 'Admin::Enterprise' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'quote_calculator' && controller.class.module_parent_name == 'Admin::Enterprise' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008H18v-.008zm0 2.25h.008v.008H18V13.5zM9.75 9h4.5m-4.5 3h4.5m-4.5 3h4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="menu-item-text">Enterprise Quote</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_enterprise_quotes_path,
                class: "menu-item group #{controller_name == 'quotes' && controller.class.module_parent_name == 'Admin::Enterprise' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'quotes' && controller.class.module_parent_name == 'Admin::Enterprise' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
              </svg>
              <span class="menu-item-text">Quote History</span>
            <% end %>
          </li>
        </ul>
      </div>

      <%# Overview Group %>
      <div class="mb-6">
        <h3 class="mb-4 text-xs uppercase leading-5 text-gray-400 font-semibold tracking-wider">
          <span class="menu-group-title">Overview</span>
        </h3>
        <ul class="flex flex-col gap-0">
          <li>
            <%= link_to admin_database_configs_path,
                class: "menu-item group #{controller_name == 'database_configs' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'database_configs' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
              </svg>
              <span class="menu-item-text">Databases</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_backup_jobs_path,
                class: "menu-item group #{controller_name == 'backup_jobs' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'backup_jobs' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="menu-item-text">Backup Jobs</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_backups_path,
                class: "menu-item group #{controller_name == 'backups' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'backups' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
              </svg>
              <span class="menu-item-text">Backups</span>
            <% end %>
          </li>
          <li>
            <%= link_to admin_audit_logs_path,
                class: "menu-item group #{controller_name == 'audit_logs' ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= controller_name == 'audit_logs' ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
              <span class="menu-item-text">Audit Logs</span>
            <% end %>
          </li>
        </ul>
      </div>

      <%# System Group %>
      <div class="mb-6">
        <h3 class="mb-4 text-xs uppercase leading-5 text-gray-400 font-semibold tracking-wider">
          <span class="menu-group-title">System</span>
        </h3>
        <ul class="flex flex-col gap-0">
          <li>
            <%= link_to "/sidekiq",
                class: "menu-item group menu-item-inactive",
                target: "_blank",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 menu-item-icon-inactive" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
              </svg>
              <span class="menu-item-text">Sidekiq</span>
              <svg class="h-4 w-4 ml-auto text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
            <% end %>
          </li>
        </ul>
      </div>
    </nav>
  </div>

  <%# User Profile Footer %>
  <div class="mt-auto border-t border-gray-200 dark:border-gray-800 py-4">
    <div class="flex items-center gap-3">
      <div class="h-10 w-10 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center shrink-0 ring-2 ring-white dark:ring-gray-800 shadow-sm">
        <span class="text-sm font-semibold text-white"><%= current_user.name.first.upcase %></span>
      </div>
      <div class="flex-1 min-w-0 menu-item-text">
        <p class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= current_user.name %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= current_user.email %></p>
      </div>
      <%= button_to logout_path,
          method: :delete,
          class: "p-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-colors",
          title: "Sign out",
          "aria-label": "Sign out" do %>
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
        </svg>
      <% end %>
    </div>
  </div>
</aside>
