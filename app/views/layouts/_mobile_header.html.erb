<%# Mobile header - sticky header, only visible on screens smaller than lg %>
<header class="lg:hidden sticky top-0 z-30 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 shadow-sm">
  <div class="flex h-16 items-center justify-between px-4">
    <%# Hamburger menu button %>
    <button
      type="button"
      class="flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500"
      data-action="click->sidebar#openMobile"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="sidebar"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

    <%# Logo/App name %>
    <%= link_to dashboard_path, class: "flex items-center gap-2" do %>
      <%= image_tag "logo.svg", class: "h-8 w-8", alt: "DataKeep" %>
      <span class="font-bold text-lg text-gray-900 dark:text-white">DataKeep</span>
    <% end %>

    <%# User avatar (for visual balance, tapping goes to audit logs) %>
    <%= link_to audit_logs_path, class: "flex items-center justify-center h-8 w-8 rounded-full bg-primary-500", "aria-label": "View audit logs" do %>
      <span class="text-sm font-medium text-white"><%= current_user.name.first.upcase %></span>
    <% end %>
  </div>
</header>
