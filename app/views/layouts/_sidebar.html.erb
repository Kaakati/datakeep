<%# Sidebar - TailAdmin style with collapse/expand %>
<aside
  data-sidebar-target="sidebar"
  class="fixed left-0 top-0 z-40 flex h-screen w-[290px] flex-col overflow-y-hidden border-r border-gray-200 bg-white px-5 transition-all duration-300 ease-linear dark:border-gray-800 dark:bg-gray-900 lg:static lg:translate-x-0 lg:w-[290px] -translate-x-full"
  aria-label="Main navigation"
  aria-hidden="true"
>
  <%# Sidebar Header %>
  <div class="flex items-center gap-2 pt-8 pb-7" data-sidebar-target="headerContent">
    <%= link_to dashboard_path, class: "flex items-center gap-3", data: { action: "click->sidebar#navigate" } do %>
      <%# Logo Icon %>
      <%= image_tag "logo.svg", class: "h-10 w-10 shrink-0", alt: "DataKeep" %>
      <%# Logo Text %>
      <span class="menu-item-text font-bold text-xl text-gray-900 dark:text-white">DataKeep</span>
    <% end %>

    <%# Close button (mobile only) %>
    <button
      type="button"
      class="lg:hidden ml-auto flex items-center justify-center p-2 rounded-lg text-gray-400 hover:text-gray-600 hover:bg-gray-100 dark:hover:text-gray-300 dark:hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-primary-500"
      data-action="click->sidebar#closeMobile"
      aria-label="Close sidebar"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <%# Scrollable Navigation Container %>
  <div class="flex flex-col overflow-y-auto duration-300 ease-linear no-scrollbar">
    <nav data-controller="sidebar-menu">
      <%# Menu Group: Overview %>
      <div class="mb-6">
        <h3 class="mb-4 text-xs uppercase leading-5 text-gray-400 font-semibold tracking-wider">
          <span class="menu-group-title">Menu</span>
          <%# Three dots icon for collapsed state %>
          <svg class="hidden menu-group-icon mx-auto" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M5.99915 10.2451C6.96564 10.2451 7.74915 11.0286 7.74915 11.9951V12.0051C7.74915 12.9716 6.96564 13.7551 5.99915 13.7551C5.03265 13.7551 4.24915 12.9716 4.24915 12.0051V11.9951C4.24915 11.0286 5.03265 10.2451 5.99915 10.2451ZM17.9991 10.2451C18.9656 10.2451 19.7491 11.0286 19.7491 11.9951V12.0051C19.7491 12.9716 18.9656 13.7551 17.9991 13.7551C17.0326 13.7551 16.2491 12.9716 16.2491 12.0051V11.9951C16.2491 11.0286 17.0326 10.2451 17.9991 10.2451ZM13.7491 11.9951C13.7491 11.0286 12.9656 10.2451 11.9991 10.2451C11.0326 10.2451 10.2491 11.0286 10.2491 11.9951V12.0051C10.2491 12.9716 11.0326 13.7551 11.9991 13.7551C12.9656 13.7551 13.7491 12.9716 13.7491 12.0051V11.9951Z" />
          </svg>
        </h3>

        <ul class="flex flex-col gap-2">
          <%# Dashboard %>
          <li>
            <%= link_to dashboard_path,
                class: "menu-item group #{current_page?(dashboard_path) ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
              <svg class="h-5 w-5 shrink-0 <%= current_page?(dashboard_path) ? 'menu-item-icon-active' : 'menu-item-icon-inactive' %>" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M5.5 3.25C4.25736 3.25 3.25 4.25736 3.25 5.5V8.99998C3.25 10.2426 4.25736 11.25 5.5 11.25H9C10.2426 11.25 11.25 10.2426 11.25 8.99998V5.5C11.25 4.25736 10.2426 3.25 9 3.25H5.5ZM4.75 5.5C4.75 5.08579 5.08579 4.75 5.5 4.75H9C9.41421 4.75 9.75 5.08579 9.75 5.5V8.99998C9.75 9.41419 9.41421 9.74998 9 9.74998H5.5C5.08579 9.74998 4.75 9.41419 4.75 8.99998V5.5ZM5.5 12.75C4.25736 12.75 3.25 13.7574 3.25 15V18.5C3.25 19.7426 4.25736 20.75 5.5 20.75H9C10.2426 20.75 11.25 19.7427 11.25 18.5V15C11.25 13.7574 10.2426 12.75 9 12.75H5.5ZM4.75 15C4.75 14.5858 5.08579 14.25 5.5 14.25H9C9.41421 14.25 9.75 14.5858 9.75 15V18.5C9.75 18.9142 9.41421 19.25 9 19.25H5.5C5.08579 19.25 4.75 18.9142 4.75 18.5V15ZM12.75 5.5C12.75 4.25736 13.7574 3.25 15 3.25H18.5C19.7426 3.25 20.75 4.25736 20.75 5.5V8.99998C20.75 10.2426 19.7426 11.25 18.5 11.25H15C13.7574 11.25 12.75 10.2426 12.75 8.99998V5.5ZM15 4.75C14.5858 4.75 14.25 5.08579 14.25 5.5V8.99998C14.25 9.41419 14.5858 9.74998 15 9.74998H18.5C18.9142 9.74998 19.25 9.41419 19.25 8.99998V5.5C19.25 5.08579 18.9142 4.75 18.5 4.75H15ZM15 12.75C13.7574 12.75 12.75 13.7574 12.75 15V18.5C12.75 19.7426 13.7574 20.75 15 20.75H18.5C19.7426 20.75 20.75 19.7427 20.75 18.5V15C20.75 13.7574 19.7426 12.75 18.5 12.75H15ZM14.25 15C14.25 14.5858 14.5858 14.25 15 14.25H18.5C18.9142 14.25 19.25 14.5858 19.25 15V18.5C19.25 18.9142 18.9142 19.25 18.5 19.25H15C14.5858 19.25 14.25 18.9142 14.25 18.5V15Z" />
              </svg>
              <span class="menu-item-text">Dashboard</span>
            <% end %>
          </li>

          <%# Health %>
          <li>
            <%= link_to health_checks_path,
                class: "menu-item group #{current_page?(health_checks_path) ? 'menu-item-active' : 'menu-item-inactive'}",
                data: { action: "click->sidebar#navigate" } do %>
