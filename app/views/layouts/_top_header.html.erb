<%# Top header bar with plan badge and user avatar dropdown %>
<header class="sticky top-0 z-20 flex h-14 items-center justify-end gap-3 border-b border-gray-200 bg-white px-4 dark:border-gray-800 dark:bg-gray-900 md:px-6">
  <%# Current plan badge %>
  <% plan = current_user.plan_name %>
  <% badge_classes = case current_user.plan_tier_key
     when :enterprise then "bg-purple-50 text-purple-700 ring-purple-600/20 dark:bg-purple-900/50 dark:text-purple-400"
     when :business then "bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-900/50 dark:text-blue-400"
     when :professional then "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-900/50 dark:text-emerald-400"
     when :starter then "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/50 dark:text-amber-400"
     else "bg-gray-50 text-gray-600 ring-gray-500/20 dark:bg-gray-800 dark:text-gray-400"
     end %>
  <%= link_to billing_path, class: "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset #{badge_classes} hover:opacity-80 transition-opacity" do %>
    <%= plan %> Plan
  <% end %>

  <%# User avatar dropdown %>
  <div class="relative" data-controller="dropdown">
    <button
      type="button"
      class="flex items-center gap-2 rounded-lg p-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
      data-action="click->dropdown#toggle"
      data-dropdown-target="button"
      aria-haspopup="true"
      aria-expanded="false"
    >
      <div class="h-8 w-8 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center shrink-0">
        <span class="text-sm font-semibold text-white"><%= current_user.name.first.upcase %></span>
      </div>
      <span class="hidden text-sm font-medium text-gray-700 dark:text-gray-300 sm:block"><%= current_user.name %></span>
      <svg class="hidden h-4 w-4 text-gray-400 sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </button>

    <%# Dropdown menu %>
    <div
      data-dropdown-target="menu"
      class="hidden absolute right-0 mt-1 w-56 origin-top-right rounded-lg border border-gray-200 bg-white py-1 shadow-lg dark:border-gray-700 dark:bg-gray-800"
      role="menu"
      aria-orientation="vertical"
    >
      <div class="border-b border-gray-100 px-4 py-2.5 dark:border-gray-700">
        <p class="text-sm font-medium text-gray-900 dark:text-white truncate"><%= current_user.name %></p>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate"><%= current_user.email %></p>
      </div>

      <%= link_to profile_path, class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700/50", role: "menuitem" do %>
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        Profile
      <% end %>

      <%= link_to billing_path, class: "flex items-center gap-2 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 dark:text-gray-300 dark:hover:bg-gray-700/50", role: "menuitem" do %>
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
        </svg>
        Billing
      <% end %>

      <div class="border-t border-gray-100 dark:border-gray-700">
        <%= button_to logout_path, method: :delete, class: "flex w-full items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/20", role: "menuitem" do %>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
          Sign Out
        <% end %>
      </div>
    </div>
  </div>
</header>
