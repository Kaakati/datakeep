<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-50">
  <head>
    <title><%= content_for(:title) || "DataKeep — Database Backup & Sync Platform" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="DataKeep">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:meta_description) || "Database backup, sync, and monitoring platform. Automated backups, point-in-time restores, and real-time health monitoring for PostgreSQL, MySQL, and MongoDB." %>">

    <%# Open Graph %>
    <meta property="og:title" content="<%= content_for(:title) || "DataKeep — Database Backup & Sync Platform" %>">
    <meta property="og:description" content="<%= content_for(:meta_description) || "Automated database backups, sync, and monitoring. Protect your data with scheduled backups, encryption, and multi-cloud storage." %>">
    <meta property="og:image" content="<%= image_url("logo.jpg") %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="DataKeep">
    <meta property="og:url" content="<%= request.original_url %>">

    <%# Twitter Card %>
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= content_for(:title) || "DataKeep — Database Backup & Sync Platform" %>">
    <meta name="twitter:description" content="<%= content_for(:meta_description) || "Automated database backups, sync, and monitoring for PostgreSQL, MySQL, and MongoDB." %>">
    <meta name="twitter:image" content="<%= image_url("logo.jpg") %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="<%= image_path("logo.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= turnstile_javascript_tag %>
  </head>

  <body class="h-full bg-gray-50 dark:bg-gray-900">
    <% if logged_in? %>
      <%# Page Wrapper - TailAdmin flex container %>
      <div class="flex h-screen overflow-hidden" data-controller="sidebar">
        <%# Sidebar %>
        <%= render sidebar_partial %>

        <%# Content Area Wrapper %>
        <div class="relative flex flex-1 flex-col overflow-x-hidden overflow-y-auto">
          <%# Backdrop for mobile sidebar %>
          <div
            data-sidebar-target="backdrop"
            data-action="click->sidebar#backdropClick"
            class="fixed inset-0 z-30 bg-gray-900/50 hidden lg:hidden"
            aria-hidden="true"
          ></div>

          <%# Mobile header %>
          <%= render "layouts/mobile_header" %>

          <%# Top header with plan badge and user dropdown %>
          <%= render "layouts/top_header" %>

          <%# Main content area %>
          <main class="flex-1">
            <div class="w-full p-4 pb-20 md:p-6 2xl:p-10">
              <%= render "layouts/flash" %>
              <%= yield %>
            </div>
          </main>
        </div>
      </div>
    <% else %>
      <main class="min-h-full">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
      <% unless content_for?(:custom_footer) %>
        <footer class="py-6 text-center text-xs text-gray-400 dark:text-gray-500">
          <div class="space-x-3">
            <%= link_to "Terms of Service", terms_path, class: "hover:text-gray-600 dark:hover:text-gray-300" %>
            <span>&middot;</span>
            <%= link_to "Privacy Policy", privacy_path, class: "hover:text-gray-600 dark:hover:text-gray-300" %>
          </div>
        </footer>
      <% end %>
    <% end %>
  </body>
</html>
