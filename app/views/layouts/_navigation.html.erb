<nav class="bg-primary-500 w-full" data-controller="navigation">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <div class="shrink-0">
          <%= link_to dashboard_path, class: "flex items-center" do %>
            <%= image_tag "logo.svg", class: "h-8 w-8", alt: "DataKeep" %>
            <span class="ml-2 text-white font-bold text-lg">Database-Ops</span>
          <% end %>
        </div>
        <div class="hidden md:block">
          <div class="ml-10 flex items-baseline space-x-4">
            <%= link_to "Dashboard", dashboard_path, class: nav_link_class(dashboard_path) %>
            <%= link_to "Databases", database_configs_path, class: nav_link_class(database_configs_path) %>
            <%= link_to "Backup Jobs", backup_jobs_path, class: nav_link_class(backup_jobs_path) %>
            <%= link_to "Backups", backups_path, class: nav_link_class(backups_path) %>
            <%= link_to "Storage", storage_backends_path, class: nav_link_class(storage_backends_path) %>
            <%= link_to "Notifications", notification_channels_path, class: nav_link_class(notification_channels_path) %>
            <%= link_to "Restore", new_restore_path, class: nav_link_class(new_restore_path) %>
            <%= link_to "Health", health_checks_path, class: nav_link_class(health_checks_path) %>
          </div>
        </div>
      </div>
      <div class="hidden md:block">
        <div class="ml-4 flex items-center md:ml-6">
          <%= link_to audit_logs_path, class: "relative rounded-full bg-primary-500 p-1 text-primary-200 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-500" do %>
            <span class="sr-only">View audit logs</span>
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          <% end %>

          <div class="relative ml-3" data-controller="dropdown">
            <div>
              <button type="button" class="relative flex max-w-xs items-center rounded-full bg-primary-500 text-sm text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-500" data-action="click->dropdown#toggle" data-dropdown-target="button">
                <span class="sr-only">Open user menu</span>
                <div class="h-8 w-8 rounded-full bg-primary-400 flex items-center justify-center">
                  <span class="text-sm font-medium"><%= current_user.name.first.upcase %></span>
                </div>
              </button>
            </div>

            <div class="hidden absolute right-0 z-10 mt-2 w-48 origin-top-right rounded-md bg-white py-1 shadow-lg ring-1 ring-black/5 focus:outline-none" data-dropdown-target="menu">
              <div class="px-4 py-2 text-sm text-gray-700 border-b border-gray-100">
                <p class="font-medium"><%= current_user.name %></p>
                <p class="text-gray-500 truncate"><%= current_user.email %></p>
              </div>
              <%= button_to "Sign out", logout_path, method: :delete, class: "block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
            </div>
          </div>
        </div>
      </div>

      <div class="-mr-2 flex md:hidden">
        <button type="button" class="relative inline-flex items-center justify-center rounded-md bg-primary-500 p-2 text-primary-200 hover:bg-primary-600 hover:text-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary-500" data-action="click->navigation#toggle">
          <span class="sr-only">Open main menu</span>
          <svg class="block h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="hidden md:hidden" data-navigation-target="mobileMenu">
    <div class="space-y-1 px-2 pb-3 pt-2 sm:px-3">
      <%= link_to "Dashboard", dashboard_path, class: mobile_nav_link_class(dashboard_path) %>
      <%= link_to "Databases", database_configs_path, class: mobile_nav_link_class(database_configs_path) %>
      <%= link_to "Backup Jobs", backup_jobs_path, class: mobile_nav_link_class(backup_jobs_path) %>
      <%= link_to "Backups", backups_path, class: mobile_nav_link_class(backups_path) %>
      <%= link_to "Storage", storage_backends_path, class: mobile_nav_link_class(storage_backends_path) %>
      <%= link_to "Notifications", notification_channels_path, class: mobile_nav_link_class(notification_channels_path) %>
      <%= link_to "Restore", new_restore_path, class: mobile_nav_link_class(new_restore_path) %>
      <%= link_to "Health", health_checks_path, class: mobile_nav_link_class(health_checks_path) %>
    </div>
    <div class="border-t border-primary-700 pb-3 pt-4">
      <div class="flex items-center px-5">
        <div class="shrink-0">
          <div class="h-10 w-10 rounded-full bg-primary-400 flex items-center justify-center">
            <span class="text-white font-medium"><%= current_user.name.first.upcase %></span>
          </div>
        </div>
        <div class="ml-3">
          <div class="text-base font-medium text-white"><%= current_user.name %></div>
          <div class="text-sm font-medium text-primary-300"><%= current_user.email %></div>
        </div>
      </div>
      <div class="mt-3 space-y-1 px-2">
        <%= link_to "Audit Logs", audit_logs_path, class: "block rounded-md px-3 py-2 text-base font-medium text-primary-200 hover:bg-primary-600 hover:text-white" %>
        <%= button_to "Sign out", logout_path, method: :delete, class: "block w-full text-left rounded-md px-3 py-2 text-base font-medium text-primary-200 hover:bg-primary-600 hover:text-white" %>
      </div>
    </div>
  </div>
</nav>
