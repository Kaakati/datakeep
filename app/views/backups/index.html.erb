<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">All Backups</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">View all backup records across all jobs</p>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800">Backup History</h3>
    </div>

    <% if @backups.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100">
            <tr>
              <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Backup Job</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Date</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Status</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Size</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Duration</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-right">
                <p class="text-sm text-gray-500">Actions</p>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @backups.each do |backup| %>
              <tr>
                <td class="py-3 pr-5 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="h-8 w-8 rounded-full bg-primary-100 flex items-center justify-center">
                      <svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                      </svg>
                    </div>
                    <div>
                      <%= link_to backup.backup_job.name, backup.backup_job, class: "text-sm font-medium text-gray-700 hover:text-primary-600" %>
                      <p class="text-xs text-gray-500"><%= backup.backup_job.database_config.name %></p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700"><%= backup.created_at.strftime("%b %d, %Y") %></p>
                  <p class="text-xs text-gray-500"><%= backup.created_at.strftime("%H:%M") %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% case backup.status %>
                  <% when "completed" %>
                    <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Completed</span>
                  <% when "failed" %>
                    <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Failed</span>
                  <% when "running" %>
                    <span class="bg-yellow-50 text-yellow-600 rounded-full px-2 py-0.5 text-xs font-medium">Running</span>
                  <% when "pending" %>
                    <span class="bg-blue-50 text-blue-600 rounded-full px-2 py-0.5 text-xs font-medium">Pending</span>
                  <% else %>
                    <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium"><%= backup.status.titleize %></span>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700"><%= backup.formatted_size %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700"><%= backup.formatted_duration %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right">
                  <div class="flex items-center justify-end gap-1">
                    <%# View action %>
                    <%= link_to backup_job_backup_path(backup.backup_job, backup),
                        class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-primary-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-primary-400 dark:hover:bg-gray-800 transition-colors",
                        aria: { label: "View backup details" },
                        title: "View" do %>
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                    <% end %>

                    <%# Restore action (only for completed backups) %>
                    <% if backup.completed? %>
                      <%= link_to restore_backup_job_backup_path(backup.backup_job, backup),
                          class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-green-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-green-400 dark:hover:bg-gray-800 transition-colors",
                          aria: { label: "Restore backup from #{backup.created_at.strftime('%b %d, %Y')}" },
                          title: "Restore",
                          data: { turbo_method: :post, turbo_confirm: "Are you sure you want to restore this backup? This will overwrite the current database." } do %>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                      <% end %>
                    <% else %>
                      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed"
                            title="Only completed backups can be restored"
                            aria-label="Restore not available">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                      </span>
                    <% end %>

                    <%# Delete action %>
                    <% if backup.deletable? %>
                      <%= button_to backup_job_backup_path(backup.backup_job, backup),
                          method: :delete,
                          data: {
                            turbo_confirm: "Are you sure you want to delete this backup? This will permanently remove the backup file. This action cannot be undone."
                          },
                          class: "inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-500 hover:text-red-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-red-400 dark:hover:bg-gray-800 transition-colors",
                          aria: { label: "Delete backup from #{backup.created_at.strftime('%b %d, %Y')}" },
                          title: "Delete" do %>
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                        </svg>
                      <% end %>
                    <% else %>
                      <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-gray-300 dark:text-gray-600 cursor-not-allowed"
                            title="<%= backup.deletion_prevented_reason %>"
                            aria-label="<%= backup.deletion_prevented_reason %>">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                        </svg>
                      </span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="border-t border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
          <p class="text-sm text-gray-700">
            Showing <span class="font-medium"><%= @backups.count %></span> backups
          </p>
        </div>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center sm:px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900">No backups</h3>
        <p class="mt-1 text-sm text-gray-500">No backups have been created yet.</p>
        <div class="mt-6">
          <%= link_to backup_jobs_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
            View Backup Jobs
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
