<%= form_with model: database_config, class: "space-y-6", data: { controller: "database-url" } do |f| %>
  <% if database_config.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">There were errors with your submission</h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-300">
            <ul class="list-disc space-y-1 pl-5">
              <% database_config.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Step 1: Engine Selector — top-level card with visual cards %>
  <% current_engine = database_config.database_type || "postgresql" %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Choose Database Engine</h3>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <%# Hidden select stays synced for form submission %>
      <div class="hidden">
        <%= f.select :database_type,
          engine_select_options,
          {},
          data: { database_type_target: "select", action: "change->database-type#changed" },
          class: "hidden" %>
      </div>

      <div role="radiogroup" aria-label="Database engine" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <% %w[postgresql mysql mongodb].each do |engine| %>
          <% colors = engine_card_colors(engine) %>
          <% is_selected = current_engine == engine %>
          <label
            data-database-type-target="engineCard"
            data-engine="<%= engine %>"
            data-action="click->database-type#selectEngine"
            data-selected="<%= is_selected %>"
            role="radio"
            aria-checked="<%= is_selected %>"
            aria-label="<%= engine_label(engine) %>"
            tabindex="<%= engine == current_engine ? '0' : '-1' %>"
            class="relative flex cursor-pointer rounded-xl border-2 p-4 transition-all duration-150
              <%= is_selected ? colors[:selected] : colors[:unselected] %>"
          >
            <input type="radio" name="engine_card" value="<%= engine %>" class="sr-only" <%= "checked" if is_selected %> tabindex="-1" />
            <div class="flex w-full items-start gap-3">
              <div class="shrink-0 mt-0.5">
                <svg class="h-8 w-8 <%= colors[:icon] %>" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <span class="text-sm font-semibold text-gray-900 dark:text-white/90"><%= engine_label(engine) %></span>
                  <svg data-check-icon class="h-5 w-5 text-current <%= colors[:icon] %>" viewBox="0 0 20 20" fill="currentColor" <% unless is_selected %>style="display: none;"<% end %>>
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                  </svg>
                </div>
                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400"><%= engine_description(engine) %></p>
                <p class="mt-1 text-xs font-medium text-gray-400 dark:text-gray-500">Port <%= engine_default_port(engine) %></p>
              </div>
            </div>
          </label>
        <% end %>
      </div>

      <%# Engine change warning for edit flow %>
      <% if database_config.persisted? %>
        <div data-database-type-target="engineWarning" class="mt-3 hidden rounded-lg bg-amber-50 p-3 text-sm text-amber-800 dark:bg-amber-900/20 dark:text-amber-200">
          <div class="flex items-center gap-2">
            <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
            </svg>
            Changing the engine will reset port and SSL settings.
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# Step 2: Quick Connect URL Section — now below engine selector %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <div class="flex items-center gap-2">
        <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
        </svg>
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Quick Connect</h3>
      </div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400" data-database-type-target="urlHelpText">Paste a <strong><%= engine_label(current_engine) %></strong> connection URL to auto-fill all fields below</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div>
        <label for="connection_url" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Connection URL</label>
        <div class="flex gap-3">
          <input
            type="text"
            id="connection_url"
            placeholder="<%= "#{current_engine}://user:pass@host:#{engine_default_port(current_engine)}/db" %>"
            data-database-url-target="url"
            data-action="input->database-url#parse"
            class="shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30 transition-colors"
          />
          <button
            type="button"
            data-action="click->database-url#clear"
            class="inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-3 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03]"
            title="Clear URL"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">
          Supports <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-gray-800">postgresql://</code>, <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-gray-800">mysql://</code>, and <code class="rounded bg-gray-100 px-1.5 py-0.5 text-xs dark:bg-gray-800">mongodb://</code> URLs
        </p>
      </div>
    </div>
  </div>

  <% if defined?(@available_slots) && @available_slots.present? %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Plan Database Slot</h3>
        </div>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Assign this database to one of your purchased Enterprise plan slots</p>
      </div>
      <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <label for="database_config_quote_database_index" class="mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400">Database Slot</label>
          <div class="relative">
            <select name="database_config[quote_database_index]" id="database_config_quote_database_index" class="shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
              <option value="">Select a slot...</option>
              <% @available_slots.each do |slot| %>
                <option value="<%= slot[:index] %>"
                  <%= 'selected' if database_config.quote_database_index == slot[:index] %>>
                  <%= slot[:name] %> (<%= slot[:engine]&.capitalize || 'PostgreSQL' %>, <%= slot[:size_gb] %> GB)
                </option>
              <% end %>
            </select>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Each slot determines the maximum database size for backups</p>
        </div>
      </div>
    </div>
  <% end %>

  <%# Step 3: Connection Details — engine selector removed, fields reordered %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Database Connection</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400" data-database-type-target="descriptionText">Configure your <strong><%= engine_label(current_engine) %></strong> connection details</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <%# Row 1: Configuration Name (full width) — identity %>
        <div class="sm:col-span-2">
          <%= f.label :name, "Configuration Name", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :name, placeholder: "My Production Database", class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">A friendly name to identify this database configuration</p>
        </div>

        <%# Row 2: Host + Port — "where is it?" %>
        <div>
          <%= f.label :host, "Host", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :host, placeholder: "localhost or db.example.com", data: { database_url_target: "host" }, class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div>
          <%= f.label :port, "Port", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.number_field :port, data: { database_url_target: "port" }, class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <%# Row 3: Database Name + Username — "which DB, who are you?" %>
        <div>
          <%= f.label :database_name, "Database Name", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :database_name, placeholder: "myapp_production", data: { database_url_target: "database", database_type_target: "databaseNameField" }, class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <% db_name_example = case current_engine
             when "mysql" then "e.g. myapp"
             when "mongodb" then "e.g. mydb"
             else "e.g. myapp_production"
             end %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400" data-database-type-target="databaseNameHelp"><%= db_name_example %></p>
        </div>

        <div>
          <%= f.label :username, "Username", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :username, autocomplete: "off", data: { database_url_target: "username" }, class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <%# Row 4: Password + SSL Mode — "credentials & security" %>
        <div x-data="{ showPassword: false }">
          <%= f.label :password, "Password", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <input
              type="password"
              name="database_config[password]"
              id="database_config_password"
              autocomplete="new-password"
              placeholder="<%= database_config.persisted? ? "Leave blank to keep current" : "" %>"
              :type="showPassword ? 'text' : 'password'"
              data-database-url-target="password"
              class="shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"
            />
            <button
              type="button"
              @click="showPassword = !showPassword"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
            >
              <svg x-show="!showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <svg x-show="showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
              </svg>
            </button>
          </div>
          <% if database_config.persisted? %>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Leave blank to keep the current password</p>
          <% end %>
        </div>

        <div data-database-type-target="sslField">
          <%= f.label :ssl_mode, "SSL Mode", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= f.select :ssl_mode, DatabaseConfig::SSL_MODES.map { |m| [m.titleize, m] }, {}, data: { database_url_target: "sslMode" }, class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">SSL connection mode (PostgreSQL and MySQL only)</p>
        </div>
      </div>
    </div>
  </div>

  <%# VPN Configuration Section %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]" data-controller="vpn-toggle">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">VPN Configuration</h3>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Connect through a VPN tunnel to reach databases in private networks</p>
        </div>
        <label class="relative inline-flex cursor-pointer items-center">
          <%= f.check_box :vpn_enabled,
            class: "sr-only peer",
            data: { vpn_checkbox: true, action: "change->vpn-toggle#toggle" } %>
          <div class="peer h-6 w-11 rounded-full bg-gray-200 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:border after:border-gray-300 after:bg-white after:transition-all after:content-[''] peer-checked:bg-primary-500 peer-checked:after:translate-x-full peer-checked:after:border-white peer-focus:outline-none peer-focus:ring-3 peer-focus:ring-primary-500/10 dark:border-gray-700 dark:bg-gray-700"></div>
        </label>
      </div>
    </div>

    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800 <%= 'hidden' unless database_config.vpn_enabled? %>" data-vpn-toggle-target="fields">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :vpn_type, "VPN Protocol", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= f.select :vpn_type,
              DatabaseConfig::VPN_TYPES.map { |t| [t == "openvpn" ? "OpenVPN" : "IPSec (strongSwan)", t] },
              { include_blank: "Select protocol..." },
              class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90",
              disabled: !database_config.vpn_enabled? %>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </div>

        <div>
          <%= f.label :vpn_gateway_ip, "VPN Gateway IP", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :vpn_gateway_ip,
            placeholder: "10.0.0.1 or vpn.example.com",
            class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30",
            disabled: !database_config.vpn_enabled? %>
        </div>

        <div>
          <%= f.label :vpn_tunnel_name, "Tunnel Name", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :vpn_tunnel_name,
            placeholder: "Auto-generated if blank",
            maxlength: 15,
            class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30",
            disabled: !database_config.vpn_enabled? %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Max 15 characters. Leave blank to auto-generate from database name.</p>
        </div>

        <div class="sm:col-span-2">
          <%= f.label :vpn_config_data, "VPN Configuration", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_area :vpn_config_data,
            rows: 8,
            placeholder: "Paste your OpenVPN (.ovpn) or swanctl configuration here...",
            class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 font-mono placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30",
            disabled: !database_config.vpn_enabled? %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Configuration is encrypted at rest. For OpenVPN, paste the full .ovpn file content. For IPSec, paste the swanctl connection config.</p>
        </div>
      </div>
    </div>
  </div>

  <%# Step 5: Engine-aware submit button %>
  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", database_configs_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03]" %>
    <%= f.submit database_config.persisted? ? "Update #{engine_label(current_engine)} Database" : "Create #{engine_label(current_engine)} Database",
      data: { database_type_target: "submitButton" },
      class: "inline-flex items-center justify-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-primary-600 cursor-pointer" %>
  </div>
<% end %>
