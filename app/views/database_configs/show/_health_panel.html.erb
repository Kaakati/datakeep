<%# Health History Panel %>
<div data-tabs-target="panel"
     data-tab="health"
     id="panel-health"
     role="tabpanel"
     aria-labelledby="tab-health"
     tabindex="0"
     class="hidden p-5 sm:p-6 space-y-6">

  <%# Health Check History Table Section %>
  <section aria-labelledby="health-history-heading">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <h3 id="health-history-heading" class="text-lg font-semibold text-gray-800 dark:text-white/90">Health Check History</h3>
      </div>

      <% if health_checks.any? %>
        <div class="overflow-x-auto px-5 sm:px-6">
          <table class="min-w-full">
            <thead class="border-y border-gray-100 dark:border-gray-700">
              <tr>
                <th scope="col" class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500 dark:text-gray-400">Time</p>
                </th>
                <th scope="col" class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500 dark:text-gray-400">Status</p>
                </th>
                <th scope="col" class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500 dark:text-gray-400">Response Time</p>
                </th>
                <th scope="col" class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500 dark:text-gray-400">Error</p>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
              <% health_checks.limit(20).each do |check| %>
                <tr>
                  <td class="py-3 pr-5 whitespace-nowrap">
                    <div class="flex items-center gap-3">
                      <% if check.healthy? %>
                        <div class="h-8 w-8 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                          <svg class="h-4 w-4 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                          </svg>
                        </div>
                      <% else %>
                        <div class="h-8 w-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
                          <svg class="h-4 w-4 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                          </svg>
                        </div>
                      <% end %>
                      <div>
                        <p class="text-sm text-gray-700 dark:text-gray-300"><%= check.checked_at.strftime("%b %d, %Y") %></p>
                        <p class="text-xs text-gray-500 dark:text-gray-400"><%= check.checked_at.strftime("%H:%M:%S") %></p>
                      </div>
                    </div>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <% if check.healthy? %>
                      <span class="bg-green-50 text-green-600 dark:bg-green-900/20 dark:text-green-400 rounded-full px-2 py-0.5 text-xs font-medium">Healthy</span>
                    <% else %>
                      <span class="bg-red-50 text-red-600 dark:bg-red-900/20 dark:text-red-400 rounded-full px-2 py-0.5 text-xs font-medium">Unhealthy</span>
                    <% end %>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <% if check.response_time_ms %>
                      <p class="text-sm text-gray-700 dark:text-gray-300"><%= check.response_time_ms %> ms</p>
                    <% else %>
                      <p class="text-sm text-gray-400 dark:text-gray-500">-</p>
                    <% end %>
                  </td>
                  <td class="px-5 py-3">
                    <% if check.error_message.present? %>
                      <p class="text-sm text-red-600 dark:text-red-400 max-w-xs truncate" title="<%= check.error_message %>"><%= check.error_message %></p>
                    <% else %>
                      <p class="text-sm text-gray-400 dark:text-gray-500">-</p>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-700 px-6 py-4">
          <p class="text-sm text-gray-700 dark:text-gray-300">
            Showing <span class="font-medium"><%= [health_checks.count, 20].min %></span> of <span class="font-medium"><%= health_checks.count %></span> health check<%= health_checks.count == 1 ? '' : 's' %>
          </p>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h4 class="mt-2 text-sm font-semibold text-gray-900 dark:text-white/90">No health checks</h4>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Health checks will appear here once they start running.</p>
        </div>
      <% end %>
    </div>
  </section>
</div>
