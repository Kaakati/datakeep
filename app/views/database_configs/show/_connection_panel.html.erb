<%# Connection Panel %>
<div data-tabs-target="panel"
     data-tab="connection"
     id="panel-connection"
     role="tabpanel"
     aria-labelledby="tab-connection"
     tabindex="0"
     class="hidden p-5 sm:p-6">
  <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Connection Details</h3>
  <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Host</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90 font-mono"><%= database_config.host %></dd>
    </div>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Port</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90 font-mono"><%= database_config.port %></dd>
    </div>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Database</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90 font-mono"><%= database_config.database_name %></dd>
    </div>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Username</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90 font-mono"><%= database_config.username %></dd>
    </div>
    <% unless database_config.database_type == "mongodb" %>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">SSL Mode</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= database_config.ssl_mode %></dd>
    </div>
    <% end %>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= engine_label(database_config.database_type) %> Version</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= database_config.engine_version || "Not detected" %></dd>
    </div>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30 sm:col-span-2">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Health Check</dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white/90"><%= time_ago_or_never(database_config.last_health_check_at) %></dd>
    </div>
    <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30 sm:col-span-2">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-2">Connection String</dt>
      <dd class="flex items-center gap-3">
        <div class="flex-1 min-w-0 relative group">
          <code class="block text-sm text-gray-900 dark:text-white/90 font-mono truncate bg-white dark:bg-gray-900/50 px-3 py-2 rounded-md border border-gray-200 dark:border-gray-700"
                title="<%= database_config.connection_string %>">
            <%= database_config.connection_string %>
          </code>
          <%# Hover tooltip showing full URL %>
          <div class="absolute left-0 right-0 bottom-full mb-2 hidden group-hover:block z-10">
            <div class="bg-gray-900 dark:bg-gray-700 text-white text-xs font-mono p-3 rounded-lg shadow-lg break-all max-w-full">
              <%= database_config.connection_string %>
              <div class="absolute bottom-0 left-4 transform translate-y-1/2 rotate-45 w-2 h-2 bg-gray-900 dark:bg-gray-700"></div>
            </div>
          </div>
        </div>
        <button type="button"
                onclick="navigator.clipboard.writeText('<%= j database_config.connection_string %>').then(() => { this.querySelector('svg').classList.add('text-green-500'); setTimeout(() => this.querySelector('svg').classList.remove('text-green-500'), 1500); })"
                class="flex-shrink-0 p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md transition-colors"
                title="Copy to clipboard">
          <svg class="w-5 h-5 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </button>
      </dd>
    </div>
  </dl>
</div>
