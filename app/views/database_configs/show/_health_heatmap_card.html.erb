<%# Leading Health Check Heatmap Card - Last 24 Hours %>
<% if health_checks.any? %>
  <section aria-labelledby="health-heatmap-leading-heading">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-full <%= database_config.healthy? ? 'bg-green-100 dark:bg-green-900/30' : 'bg-red-100 dark:bg-red-900/30' %>">
            <% if database_config.healthy? %>
              <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            <% else %>
              <svg class="h-5 w-5 text-red-600 dark:text-red-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
            <% end %>
          </div>
          <div>
            <h3 id="health-heatmap-leading-heading" class="text-lg font-semibold text-gray-800 dark:text-white/90">Last 24 Hours</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">
              <% healthy_count = health_checks.first(48).count(&:healthy?) %>
              <% total_count = health_checks.first(48).count %>
              <% uptime_percent = total_count > 0 ? ((healthy_count.to_f / total_count) * 100).round(1) : 0 %>
              <%= uptime_percent %>% uptime (<%= healthy_count %>/<%= total_count %> checks passed)
            </p>
          </div>
        </div>
        <%= link_to database_config_health_checks_path(database_config),
            class: "inline-flex items-center justify-center min-h-[44px] rounded-lg bg-white px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:bg-gray-800 dark:text-gray-200 dark:ring-gray-700 dark:hover:bg-gray-700" do %>
          View Full Grid
        <% end %>
      </div>

      <div class="px-5 pb-5 sm:px-6">
        <div class="flex flex-wrap gap-1" role="img" aria-label="Health check status for the last 24 hours">
          <% health_checks.first(48).each do |check| %>
            <div class="group relative">
              <div class="w-3 h-3 rounded-sm <%= check.healthy? ? 'bg-green-500' : 'bg-red-500' %>" aria-label="<%= check.healthy? ? 'Healthy' : 'Unhealthy' %> at <%= check.checked_at.strftime('%H:%M') %>"></div>
              <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-10 pointer-events-none">
                <div class="rounded-lg bg-gray-900 px-3 py-2 text-xs text-white whitespace-nowrap shadow-lg">
                  <p class="font-medium"><%= check.healthy? ? 'Healthy' : 'Unhealthy' %></p>
                  <p><%= check.checked_at.strftime("%b %d, %H:%M") %></p>
                  <% if check.response_time_ms %>
                    <p><%= check.response_time_ms %>ms</p>
                  <% end %>
                  <% if check.error_message.present? %>
                    <p class="text-red-300 max-w-xs truncate"><%= check.error_message %></p>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>
