<%# Performance Panel %>
<div data-tabs-target="panel"
     data-tab="performance"
     id="panel-performance"
     role="tabpanel"
     aria-labelledby="tab-performance"
     tabindex="0"
     class="p-5 sm:p-6 space-y-6">
  <% if db_stats && !db_stats[:error] %>
    <%# Storage & Maintenance %>
    <section aria-labelledby="storage-heading">
      <h3 id="storage-heading" class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Storage & Maintenance</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-50 text-primary-500 dark:bg-primary-900/20 dark:text-primary-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Database Size</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= database_config.format_bytes(db_stats[:database_size]) %></span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-blue-500 dark:bg-blue-900/20 dark:text-blue-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Tables / Indexes</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= number_with_delimiter(db_stats[:table_count]) %> / <%= number_with_delimiter(db_stats[:index_count]) %></span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= db_stats[:dead_tuples] > 10000 ? 'bg-yellow-50 text-yellow-500 dark:bg-yellow-900/20 dark:text-yellow-400' : 'bg-purple-50 text-purple-500 dark:bg-purple-900/20 dark:text-purple-400' %>">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Live / Dead Rows</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90">
              <%= number_with_delimiter(db_stats[:total_rows]) %> /
              <span class="<%= db_stats[:dead_tuples] > 10000 ? 'text-yellow-600 dark:text-yellow-400' : '' %>"><%= number_with_delimiter(db_stats[:dead_tuples]) %></span>
            </span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= db_stats[:xid_percent] && db_stats[:xid_percent] > 50 ? 'bg-red-50 text-red-500 dark:bg-red-900/20 dark:text-red-400' : db_stats[:xid_percent] && db_stats[:xid_percent] > 25 ? 'bg-yellow-50 text-yellow-500 dark:bg-yellow-900/20 dark:text-yellow-400' : 'bg-teal-50 text-teal-500 dark:bg-teal-900/20 dark:text-teal-400' %>">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">XID Age</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= db_stats[:xid_percent] || 0 %>%</span>
          </div>
        </article>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mt-4">
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Vacuum</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white/90">
            <% if db_stats[:last_vacuum] %>
              <%= time_ago_in_words(Time.parse(db_stats[:last_vacuum])) %> ago
            <% else %>
              <span class="text-yellow-600 dark:text-yellow-400">Never</span>
            <% end %>
          </dd>
        </div>
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 dark:border-gray-700 dark:bg-gray-800/30">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Analyze</dt>
          <dd class="mt-1 text-sm text-gray-900 dark:text-white/90">
            <% if db_stats[:last_analyze] %>
              <%= time_ago_in_words(Time.parse(db_stats[:last_analyze])) %> ago
            <% else %>
              <span class="text-yellow-600 dark:text-yellow-400">Never</span>
            <% end %>
          </dd>
        </div>
      </div>
    </section>

    <%# Connection States %>
    <% if db_stats[:connections] %>
    <section aria-labelledby="connections-heading">
      <h3 id="connections-heading" class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Connection States</h3>
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/30">
          <p class="text-2xl font-semibold text-green-600 dark:text-green-400"><%= db_stats[:connections][:active] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Active</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/30">
          <p class="text-2xl font-semibold text-gray-600 dark:text-gray-300"><%= db_stats[:connections][:idle] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Idle</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/30">
          <p class="text-2xl font-semibold <%= db_stats[:connections][:idle_in_transaction] > 0 ? 'text-yellow-600 dark:text-yellow-400' : 'text-gray-600 dark:text-gray-300' %>"><%= db_stats[:connections][:idle_in_transaction] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Idle in Txn</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/30">
          <p class="text-2xl font-semibold <%= db_stats[:connections][:waiting] > 0 ? 'text-orange-600 dark:text-orange-400' : 'text-gray-600 dark:text-gray-300' %>"><%= db_stats[:connections][:waiting] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Waiting</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center dark:border-gray-700 dark:bg-gray-800/30">
          <p class="text-2xl font-semibold text-primary-600 dark:text-primary-400"><%= db_stats[:connections][:total] %></p>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Total</p>
        </div>
      </div>
    </section>
    <% end %>

    <%# Activity %>
    <section aria-labelledby="activity-heading">
      <h3 id="activity-heading" class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Activity</h3>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-green-50 text-green-500 dark:bg-green-900/20 dark:text-green-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Commits</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= number_with_delimiter(db_stats[:commits]) %></span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= db_stats[:rollbacks] > 0 ? 'bg-red-50 text-red-500 dark:bg-red-900/20 dark:text-red-400' : 'bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400' %>">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Rollbacks</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= number_with_delimiter(db_stats[:rollbacks]) %></span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= db_stats[:deadlocks] > 0 ? 'bg-red-50 text-red-500 dark:bg-red-900/20 dark:text-red-400' : 'bg-gray-50 text-gray-500 dark:bg-gray-800 dark:text-gray-400' %>">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Deadlocks</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= number_with_delimiter(db_stats[:deadlocks]) %></span>
          </div>
        </article>

        <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-orange-50 text-orange-500 dark:bg-orange-900/20 dark:text-orange-400">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 dark:text-gray-400">Temp Files</p>
            <span class="text-lg font-semibold text-gray-800 dark:text-white/90"><%= number_with_delimiter(db_stats[:temp_files]) %></span>
          </div>
        </article>
      </div>
    </section>

    <%# Longest Running Query %>
    <% if db_stats[:longest_query] %>
    <section aria-labelledby="longest-query-heading">
      <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800/50">
        <div class="flex items-center justify-between mb-3">
          <h3 id="longest-query-heading" class="text-sm font-semibold text-gray-800 dark:text-white/90">Longest Running Query</h3>
          <div class="flex items-center gap-2">
            <span class="text-xs text-gray-500 dark:text-gray-400">PID: <%= db_stats[:longest_query][:pid] %></span>
            <%= button_to kill_query_database_config_path(database_config, pid: db_stats[:longest_query][:pid]),
                method: :post,
                data: { turbo_confirm: "Terminate this query (PID: #{db_stats[:longest_query][:pid]})?" },
                class: "inline-flex items-center justify-center min-h-[36px] min-w-[36px] rounded-md bg-red-50 px-2 py-1 text-xs font-semibold text-red-700 hover:bg-red-100 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:bg-red-900/20 dark:text-red-400 dark:hover:bg-red-900/40",
                aria: { label: "Kill query with PID #{db_stats[:longest_query][:pid]}" } do %>
              Kill Query
            <% end %>
          </div>
        </div>
        <div class="flex items-center gap-2 mb-2">
          <span class="bg-yellow-50 text-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-400 rounded-full px-2 py-0.5 text-xs font-medium"><%= db_stats[:longest_query][:state] %></span>
          <span class="text-sm text-gray-600 dark:text-gray-400"><%= db_stats[:longest_query][:duration] %></span>
        </div>
        <pre class="text-xs text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 rounded p-3 overflow-x-auto"><%= db_stats[:longest_query][:query] %></pre>
      </div>
    </section>
    <% end %>

  <% elsif db_stats && db_stats[:error] %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 dark:border-red-800 dark:bg-red-900/20" role="alert">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
        </svg>
        <p class="text-sm text-red-700 dark:text-red-300">Failed to fetch database statistics: <%= db_stats[:error] %></p>
      </div>
    </div>
  <% elsif !database_config.healthy? %>
    <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4 dark:border-yellow-800 dark:bg-yellow-900/20" role="alert">
      <div class="flex items-center gap-3">
        <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
        <p class="text-sm text-yellow-700 dark:text-yellow-300">Database statistics unavailable. Test the connection first to verify connectivity.</p>
      </div>
    </div>
  <% end %>
</div>
