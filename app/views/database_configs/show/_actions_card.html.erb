<%# Actions Card %>
<div class="rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
  <h3 class="text-sm font-semibold text-gray-800 dark:text-white/90 mb-3">Actions</h3>

  <div class="space-y-2">
    <%= button_to test_connection_database_config_path(database_config),
        method: :post,
        class: "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 dark:bg-gray-800/50 dark:hover:bg-gray-800 transition-colors group",
        aria: { label: "Test database connection" } do %>
      <svg class="w-5 h-5 text-blue-500 dark:text-blue-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span class="flex-1 text-left min-w-0">
        <span class="block text-sm font-medium text-gray-900 dark:text-white">Test Connection</span>
        <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Verify database connectivity</span>
      </span>
      <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>

    <% if database_config.healthy? && database_config.database_type == "postgresql" %>
      <%= button_to vacuum_database_config_path(database_config),
          method: :post,
          data: { turbo_confirm: "Run VACUUM ANALYZE on this database? This may take a while on large databases." },
          class: "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 dark:bg-gray-800/50 dark:hover:bg-gray-800 transition-colors group",
          aria: { label: "Run VACUUM ANALYZE" } do %>
        <svg class="w-5 h-5 text-purple-500 dark:text-purple-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span class="flex-1 text-left min-w-0">
          <span class="block text-sm font-medium text-gray-900 dark:text-white">Vacuum Analyze</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Optimize performance</span>
        </span>
        <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    <% end %>

    <% if backup_jobs.any? %>
      <%= button_to run_now_backup_job_path(backup_jobs.first),
          method: :post,
          data: { turbo_confirm: "Run backup now?" },
          class: "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 dark:bg-gray-800/50 dark:hover:bg-gray-800 transition-colors group",
          aria: { label: "Run backup now" } do %>
        <svg class="w-5 h-5 text-green-500 dark:text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10" />
        </svg>
        <span class="flex-1 text-left min-w-0">
          <span class="block text-sm font-medium text-gray-900 dark:text-white">Run Backup</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Create immediate backup</span>
        </span>
        <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    <% end %>

    <div class="pt-2 mt-2 border-t border-gray-200 dark:border-gray-700">
      <%= button_to database_config_path(database_config),
          method: :delete,
          data: { turbo_confirm: "Remove this connection from DataKeep? This only removes the configuration — your actual database will not be affected." },
          class: "w-full flex items-center gap-3 px-3 py-2.5 rounded-lg bg-gray-50 hover:bg-gray-100 dark:bg-gray-800/50 dark:hover:bg-gray-800 transition-colors group",
          aria: { label: "Remove database configuration" } do %>
        <svg class="w-5 h-5 text-gray-500 dark:text-gray-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
        <span class="flex-1 text-left min-w-0">
          <span class="block text-sm font-medium text-gray-700 dark:text-gray-200">Remove Connection</span>
          <span class="block text-xs text-gray-500 dark:text-gray-400 truncate">Database won't be affected</span>
        </span>
        <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
