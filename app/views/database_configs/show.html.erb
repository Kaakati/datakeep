<div class="space-y-8" data-controller="tabs" data-tabs-active-tab-value="performance">
  <%= render "database_configs/show/header",
             database_config: @database_config %>

  <%= render "database_configs/show/alerts",
             database_config: @database_config,
             db_stats: @db_stats,
             long_running_queries: @long_running_queries %>

  <%# Leading Health Heatmap Card %>
  <%= render "database_configs/show/health_heatmap_card",
             database_config: @database_config,
             health_checks: @health_checks %>

  <%# Summary Cards + Actions in grid layout %>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
    <div class="lg:col-span-2 space-y-6">
      <%= render "database_configs/show/summary_cards",
                 database_config: @database_config,
                 db_stats: @db_stats %>
      <%= render "database_configs/show/connection_summary",
                 database_config: @database_config %>
    </div>
    <div class="lg:col-span-1">
      <%= render "database_configs/show/actions_card",
                 database_config: @database_config,
                 backup_jobs: @backup_jobs %>
    </div>
  </div>

  <%# Tabbed Content %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <%= render "database_configs/show/tabs_navigation",
               backup_jobs: @backup_jobs,
               backups: @backups %>

    <%= render "database_configs/show/performance_panel",
               database_config: @database_config,
               db_stats: @db_stats %>

    <%= render "database_configs/show/backups_panel",
               database_config: @database_config,
               backup_jobs: @backup_jobs,
               backups: @backups %>

    <%= render "database_configs/show/health_panel",
               database_config: @database_config,
               health_checks: @health_checks %>

    <%= render "database_configs/show/connection_panel",
               database_config: @database_config %>
  </div>
</div>
