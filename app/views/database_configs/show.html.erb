<div class="space-y-6" data-controller="tabs" data-tabs-active-tab-value="overview">
  <!-- Header -->
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90"><%= @database_config.name %></h1>
        <%= status_badge(@database_config.health_status) %>
      </div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= @database_config.connection_string %></p>
    </div>
    <div class="mt-4 flex space-x-3 sm:mt-0">
      <%= button_to test_connection_database_config_path(@database_config), method: :post, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h2.433a.75.75 0 000-1.5H3.989a.75.75 0 00-.75.75v4.242a.75.75 0 001.5 0v-2.43l.31.31a7 7 0 0011.712-3.138.75.75 0 00-1.449-.39zm1.23-3.723a.75.75 0 00.219-.53V2.929a.75.75 0 00-1.5 0V5.36l-.31-.31A7 7 0 003.239 8.188a.75.75 0 101.448.389A5.5 5.5 0 0113.89 6.11l.311.31h-2.432a.75.75 0 000 1.5h4.243a.75.75 0 00.53-.219z" clip-rule="evenodd" />
        </svg>
        Test Connection
      <% end %>
      <%= link_to edit_database_config_path(@database_config), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
        </svg>
        Edit
      <% end %>
      <%= button_to database_config_path(@database_config), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this database configuration?" }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <!-- Tabs Navigation -->
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="border-b border-gray-200 dark:border-gray-800">
      <nav class="flex -mb-px px-5" aria-label="Tabs">
        <button type="button" data-tabs-target="tab" data-tab="overview" data-action="click->tabs#switch"
                class="whitespace-nowrap border-b-2 px-4 py-4 text-sm font-medium border-primary-500 text-primary-600">
          Overview
        </button>
        <button type="button" data-tabs-target="tab" data-tab="jobs" data-action="click->tabs#switch"
                class="whitespace-nowrap border-b-2 px-4 py-4 text-sm font-medium border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Backup Jobs (<%= @backup_jobs.count %>)
        </button>
        <button type="button" data-tabs-target="tab" data-tab="backups" data-action="click->tabs#switch"
                class="whitespace-nowrap border-b-2 px-4 py-4 text-sm font-medium border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Backups (<%= @backups.count %>)
        </button>
        <button type="button" data-tabs-target="tab" data-tab="health" data-action="click->tabs#switch"
                class="whitespace-nowrap border-b-2 px-4 py-4 text-sm font-medium border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Health Checks
        </button>
      </nav>
    </div>

    <!-- Overview Panel -->
    <div data-tabs-target="panel" data-tab="overview" class="p-5 sm:p-6 space-y-6">
      <% if @db_stats && !@db_stats[:error] %>
        <!-- Key Performance Metrics -->
        <div>
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Performance Overview</h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <!-- Cache Hit Ratio -->
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= @db_stats[:cache_hit_ratio] >= 99 ? 'bg-green-50 text-green-500' : @db_stats[:cache_hit_ratio] >= 95 ? 'bg-yellow-50 text-yellow-500' : 'bg-red-50 text-red-500' %>">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Cache Hit Ratio</p>
                <span class="text-lg font-semibold text-gray-800"><%= @db_stats[:cache_hit_ratio] %>%</span>
              </div>
            </article>

            <!-- Database Size -->
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-primary-50 text-primary-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Database Size</p>
                <span class="text-lg font-semibold text-gray-800"><%= @database_config.format_bytes(@db_stats[:database_size]) %></span>
              </div>
            </article>

            <!-- Connections -->
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-green-50 text-green-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Connections</p>
                <span class="text-lg font-semibold text-gray-800"><%= @db_stats[:active_connections] %> / <%= @db_stats[:max_connections] %></span>
              </div>
            </article>

            <!-- Deadlocks -->
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= @db_stats[:deadlocks] > 0 ? 'bg-red-50 text-red-500' : 'bg-gray-50 text-gray-500' %>">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Deadlocks</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:deadlocks]) %></span>
              </div>
            </article>
          </div>
        </div>

        <!-- Connection States -->
        <% if @db_stats[:connections] %>
        <div>
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Connection States</h3>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center">
              <p class="text-2xl font-semibold text-green-600"><%= @db_stats[:connections][:active] %></p>
              <p class="text-xs text-gray-500 mt-1">Active</p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center">
              <p class="text-2xl font-semibold text-gray-600"><%= @db_stats[:connections][:idle] %></p>
              <p class="text-xs text-gray-500 mt-1">Idle</p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center">
              <p class="text-2xl font-semibold <%= @db_stats[:connections][:idle_in_transaction] > 0 ? 'text-yellow-600' : 'text-gray-600' %>"><%= @db_stats[:connections][:idle_in_transaction] %></p>
              <p class="text-xs text-gray-500 mt-1">Idle in Txn</p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center">
              <p class="text-2xl font-semibold <%= @db_stats[:connections][:waiting] > 0 ? 'text-orange-600' : 'text-gray-600' %>"><%= @db_stats[:connections][:waiting] %></p>
              <p class="text-xs text-gray-500 mt-1">Waiting</p>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 text-center">
              <p class="text-2xl font-semibold text-primary-600"><%= @db_stats[:connections][:total] %></p>
              <p class="text-xs text-gray-500 mt-1">Total</p>
            </div>
          </div>
        </div>
        <% end %>

        <!-- Storage & Maintenance -->
        <div>
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Storage & Maintenance</h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-blue-50 text-blue-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Tables / Indexes</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:table_count]) %> / <%= number_with_delimiter(@db_stats[:index_count]) %></span>
              </div>
            </article>

            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-purple-50 text-purple-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Live / Dead Rows</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:total_rows]) %> / <span class="<%= @db_stats[:dead_tuples] > 10000 ? 'text-yellow-600' : '' %>"><%= number_with_delimiter(@db_stats[:dead_tuples]) %></span></span>
              </div>
            </article>

            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-orange-50 text-orange-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Temp Files</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:temp_files]) %> (<%= @database_config.format_bytes(@db_stats[:temp_bytes]) %>)</span>
              </div>
            </article>

            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= @db_stats[:xid_percent] && @db_stats[:xid_percent] > 50 ? 'bg-red-50 text-red-500' : @db_stats[:xid_percent] && @db_stats[:xid_percent] > 25 ? 'bg-yellow-50 text-yellow-500' : 'bg-teal-50 text-teal-500' %>">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">XID Age</p>
                <span class="text-lg font-semibold text-gray-800"><%= @db_stats[:xid_percent] || 0 %>%</span>
              </div>
            </article>
          </div>

          <!-- Last Vacuum -->
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mt-4">
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
              <dt class="text-sm font-medium text-gray-500">Last Vacuum</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @db_stats[:last_vacuum] %>
                  <%= time_ago_in_words(Time.parse(@db_stats[:last_vacuum])) %> ago
                <% else %>
                  <span class="text-yellow-600">Never</span>
                <% end %>
              </dd>
            </div>
            <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
              <dt class="text-sm font-medium text-gray-500">Last Analyze</dt>
              <dd class="mt-1 text-sm text-gray-900">
                <% if @db_stats[:last_analyze] %>
                  <%= time_ago_in_words(Time.parse(@db_stats[:last_analyze])) %> ago
                <% else %>
                  <span class="text-yellow-600">Never</span>
                <% end %>
              </dd>
            </div>
          </div>
        </div>

        <!-- Transactions & Longest Query -->
        <div>
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Activity</h3>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-green-50 text-green-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Commits</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:commits]) %></span>
              </div>
            </article>

            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg <%= @db_stats[:rollbacks] > 0 ? 'bg-red-50 text-red-500' : 'bg-gray-50 text-gray-500' %>">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Rollbacks</p>
                <span class="text-lg font-semibold text-gray-800"><%= number_with_delimiter(@db_stats[:rollbacks]) %></span>
              </div>
            </article>

            <article class="flex items-center gap-4 rounded-xl border border-gray-200 bg-white p-4">
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-teal-50 text-teal-500">
                <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500">Server Uptime</p>
                <% if @db_stats[:server_start_time] %>
                  <span class="text-lg font-semibold text-gray-800"><%= time_ago_in_words(Time.parse(@db_stats[:server_start_time])) %></span>
                <% else %>
                  <span class="text-lg font-semibold text-gray-800">Unknown</span>
                <% end %>
              </div>
            </article>
          </div>

          <% if @db_stats[:longest_query] %>
          <div class="mt-4 rounded-lg border border-gray-200 bg-white p-4">
            <div class="flex items-center justify-between mb-2">
              <h4 class="text-sm font-medium text-gray-700">Longest Running Query</h4>
              <span class="text-xs text-gray-500">PID: <%= @db_stats[:longest_query][:pid] %></span>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <span class="bg-yellow-50 text-yellow-700 rounded-full px-2 py-0.5 text-xs font-medium"><%= @db_stats[:longest_query][:state] %></span>
              <span class="text-sm text-gray-600"><%= @db_stats[:longest_query][:duration] %></span>
            </div>
            <pre class="text-xs text-gray-600 bg-gray-50 rounded p-2 overflow-x-auto"><%= @db_stats[:longest_query][:query] %></pre>
          </div>
          <% end %>
        </div>
      <% elsif @db_stats && @db_stats[:error] %>
        <div class="rounded-lg border border-red-200 bg-red-50 p-4">
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm text-red-700">Failed to fetch database statistics: <%= @db_stats[:error] %></p>
          </div>
        </div>
      <% elsif !@database_config.healthy? %>
        <div class="rounded-lg border border-yellow-200 bg-yellow-50 p-4">
          <div class="flex items-center gap-3">
            <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
            </svg>
            <p class="text-sm text-yellow-700">Database statistics unavailable. Test the connection first to verify connectivity.</p>
          </div>
        </div>
      <% end %>

      <div>
        <h3 class="text-lg font-semibold text-gray-800 mb-4">Connection Details</h3>
        <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">Host</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.host %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">Port</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.port %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">Database</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.database_name %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">Username</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.username %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">SSL Mode</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.ssl_mode %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4">
            <dt class="text-sm font-medium text-gray-500">PostgreSQL Version</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @database_config.pg_version || "Not detected" %></dd>
          </div>
          <div class="rounded-lg border border-gray-100 bg-gray-50 p-4 sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Last Health Check</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= time_ago_or_never(@database_config.last_health_check_at) %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Backup Jobs Panel -->
    <div data-tabs-target="panel" data-tab="jobs" class="hidden">
      <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 pt-4">
        <h3 class="text-lg font-semibold text-gray-800">Backup Jobs</h3>
        <%= link_to new_backup_job_path(database_config_id: @database_config.id), class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          Create Backup Job
        <% end %>
      </div>

      <% if @backup_jobs.any? %>
        <div class="overflow-x-auto px-5 sm:px-6">
          <table class="min-w-full">
            <thead class="border-y border-gray-100">
              <tr>
                <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Name</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Schedule</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Storage</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Next Run</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Status</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-right">
                  <p class="text-sm text-gray-500">Actions</p>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @backup_jobs.each do |job| %>
                <tr>
                  <td class="py-3 pr-5 whitespace-nowrap">
                    <%= link_to job.name, job, class: "text-sm font-medium text-primary-500 hover:text-primary-700" %>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700"><%= job.schedule_type.titleize %></p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700"><%= job.storage_backend.name %></p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700">
                      <% if job.next_run_at %>
                        <%= job.next_run_at.strftime("%b %d, %H:%M") %>
                      <% else %>
                        -
                      <% end %>
                    </p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <% if job.enabled? %>
                      <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Enabled</span>
                    <% else %>
                      <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium">Disabled</span>
                    <% end %>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap text-right">
                    <%= link_to "View", job, class: "text-sm text-primary-500 hover:text-primary-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No backup jobs</h3>
          <p class="mt-1 text-sm text-gray-500">Create a backup job to start scheduling backups for this database.</p>
        </div>
      <% end %>
      <div class="px-5 py-4 sm:px-6"></div>
    </div>

    <!-- Backups Panel -->
    <div data-tabs-target="panel" data-tab="backups" class="hidden">
      <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 pt-4">
        <h3 class="text-lg font-semibold text-gray-800">Recent Backups</h3>
      </div>

      <% if @backups.any? %>
        <div class="overflow-x-auto px-5 sm:px-6">
          <table class="min-w-full">
            <thead class="border-y border-gray-100">
              <tr>
                <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Backup Job</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Date</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Size</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Duration</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                  <p class="text-sm text-gray-500">Status</p>
                </th>
                <th class="px-5 py-3 font-normal whitespace-nowrap text-right">
                  <p class="text-sm text-gray-500">Actions</p>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% @backups.each do |backup| %>
                <tr>
                  <td class="py-3 pr-5 whitespace-nowrap">
                    <%= link_to backup.backup_job.name, backup.backup_job, class: "text-sm font-medium text-primary-500 hover:text-primary-700" %>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700"><%= backup.created_at.strftime("%b %d, %Y %H:%M") %></p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700"><%= backup.formatted_size %></p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700"><%= backup.formatted_duration %></p>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap">
                    <% case backup.status %>
                    <% when "completed" %>
                      <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Completed</span>
                    <% when "failed" %>
                      <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Failed</span>
                    <% when "running" %>
                      <span class="bg-yellow-50 text-yellow-600 rounded-full px-2 py-0.5 text-xs font-medium">Running</span>
                    <% else %>
                      <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium"><%= backup.status.titleize %></span>
                    <% end %>
                  </td>
                  <td class="px-5 py-3 whitespace-nowrap text-right">
                    <%= link_to "View", backup_job_backup_path(backup.backup_job, backup), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No backups</h3>
          <p class="mt-1 text-sm text-gray-500">No backups have been created for this database yet.</p>
        </div>
      <% end %>
      <div class="px-5 py-4 sm:px-6"></div>
    </div>

    <!-- Health Checks Panel -->
    <div data-tabs-target="panel" data-tab="health" class="hidden">
      <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6 pt-4">
        <h3 class="text-lg font-semibold text-gray-800">Health Check History</h3>
        <%= link_to "View Full Grid", database_config_health_checks_path(@database_config), class: "text-sm font-medium text-primary-500 hover:text-primary-700" %>
      </div>

      <% if @health_checks.any? %>
        <div class="px-5 sm:px-6 pb-4">
          <div class="mb-4">
            <p class="text-sm text-gray-500">Last 24 hours at a glance:</p>
            <div class="mt-2 flex flex-wrap gap-1">
              <% @health_checks.first(48).each do |check| %>
                <div class="group relative">
                  <div class="h-6 w-3 rounded-sm <%= check.healthy? ? 'bg-green-500' : 'bg-red-500' %>"></div>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-10">
                    <div class="rounded-lg bg-gray-900 px-3 py-2 text-xs text-white whitespace-nowrap">
                      <p class="font-medium"><%= check.healthy? ? 'Healthy' : 'Unhealthy' %></p>
                      <p><%= check.checked_at.strftime("%b %d, %H:%M") %></p>
                      <% if check.response_time_ms %>
                        <p><%= check.response_time_ms %>ms</p>
                      <% end %>
                      <% if check.error_message.present? %>
                        <p class="text-red-300 max-w-xs truncate"><%= check.error_message %></p>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full">
              <thead class="border-y border-gray-100">
                <tr>
                  <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                    <p class="text-sm text-gray-500">Time</p>
                  </th>
                  <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                    <p class="text-sm text-gray-500">Status</p>
                  </th>
                  <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                    <p class="text-sm text-gray-500">Response Time</p>
                  </th>
                  <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                    <p class="text-sm text-gray-500">Error</p>
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @health_checks.limit(20).each do |check| %>
                  <tr>
                    <td class="py-3 pr-5 whitespace-nowrap">
                      <p class="text-sm text-gray-700"><%= check.checked_at.strftime("%b %d, %Y %H:%M:%S") %></p>
                    </td>
                    <td class="px-5 py-3 whitespace-nowrap">
                      <% if check.healthy? %>
                        <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Healthy</span>
                      <% else %>
                        <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Unhealthy</span>
                      <% end %>
                    </td>
                    <td class="px-5 py-3 whitespace-nowrap">
                      <p class="text-sm text-gray-700">
                        <% if check.response_time_ms %>
                          <%= check.response_time_ms %> ms
                        <% else %>
                          -
                        <% end %>
                      </p>
                    </td>
                    <td class="px-5 py-3">
                      <% if check.error_message.present? %>
                        <p class="text-sm text-red-600 max-w-xs truncate" title="<%= check.error_message %>"><%= check.error_message %></p>
                      <% else %>
                        <p class="text-sm text-gray-400">-</p>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-sm font-semibold text-gray-900">No health checks</h3>
          <p class="mt-1 text-sm text-gray-500">Health checks will appear here once they start running.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
