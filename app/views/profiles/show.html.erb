<div class="w-full space-y-6">
  <%# Page Header %>
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Profile</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your account settings and security</p>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <%# Left Column — Profile Card %>
    <div class="lg:col-span-1">
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-col items-center text-center">
          <%# Avatar %>
          <div class="h-20 w-20 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center ring-4 ring-white dark:ring-gray-800 shadow-lg">
            <% if @user.avatar_url.present? %>
              <img src="<%= @user.avatar_url %>" alt="<%= @user.name %>" class="h-20 w-20 rounded-full object-cover" />
            <% else %>
              <span class="text-2xl font-bold text-white"><%= @user.name.first.upcase %></span>
            <% end %>
          </div>

          <h2 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white"><%= @user.name %></h2>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= @user.email %></p>

          <%# Plan Badge %>
          <% badge_classes = case @user.plan_tier_key
             when :enterprise then "bg-purple-50 text-purple-700 ring-purple-600/20 dark:bg-purple-900/50 dark:text-purple-400"
             when :business then "bg-blue-50 text-blue-700 ring-blue-600/20 dark:bg-blue-900/50 dark:text-blue-400"
             when :professional then "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-900/50 dark:text-emerald-400"
             when :starter then "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-900/50 dark:text-amber-400"
             else "bg-gray-50 text-gray-600 ring-gray-500/20 dark:bg-gray-800 dark:text-gray-400"
             end %>
          <span class="mt-3 inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset <%= badge_classes %>">
            <%= @user.plan_name %> Plan
          </span>

          <div class="mt-4 w-full border-t border-gray-200 pt-4 dark:border-gray-700">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500 dark:text-gray-400">Member since</span>
              <span class="font-medium text-gray-900 dark:text-white"><%= @user.created_at.strftime("%b %d, %Y") %></span>
            </div>
            <% if @user.oauth_user? %>
              <div class="mt-2 flex items-center justify-between text-sm">
                <span class="text-gray-500 dark:text-gray-400">Sign-in method</span>
                <span class="inline-flex items-center gap-1 font-medium text-gray-900 dark:text-white">
                  <svg class="h-4 w-4" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                  Google
                </span>
              </div>
            <% end %>
          </div>

          <div class="mt-4 w-full">
            <%= link_to edit_profile_path, class: "flex w-full justify-center rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800" do %>
              <svg class="mr-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
              </svg>
              Edit Profile
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Right Column — Settings %>
    <div class="lg:col-span-2 space-y-6">
      <%# Security Section %>
      <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-700">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Security</h3>
          <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Protect your account with additional security</p>
        </div>

        <div class="divide-y divide-gray-200 dark:divide-gray-700">
          <%# Two-Factor Authentication %>
          <div class="flex items-center justify-between px-6 py-5">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary-50 dark:bg-primary-900/30">
                <svg class="h-5 w-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">Two-factor authentication (Email OTP)</p>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
                  Receive a one-time code via email each time you sign in.
                </p>
                <% if @user.otp_required? %>
                  <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20 dark:bg-green-900/30 dark:text-green-400 dark:ring-green-500/30">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                    Enabled
                  </span>
                <% else %>
                  <span class="mt-2 inline-flex items-center rounded-full bg-gray-50 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20 dark:bg-gray-800 dark:text-gray-400 dark:ring-gray-600/30">
                    Disabled
                  </span>
                <% end %>
              </div>
            </div>
            <div>
              <% if @user.otp_required? %>
                <%= button_to disable_otp_profile_path, method: :delete, class: "rounded-lg border border-red-300 px-3.5 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition-colors dark:border-red-700 dark:text-red-400 dark:hover:bg-red-900/20", data: { turbo_confirm: "Are you sure you want to disable two-factor authentication?" } do %>
                  Disable
                <% end %>
              <% else %>
                <%= button_to enable_otp_profile_path, method: :post, class: "rounded-lg bg-primary-500 px-3.5 py-2 text-sm font-medium text-white hover:bg-primary-600 transition-colors" do %>
                  Enable
                <% end %>
              <% end %>
            </div>
          </div>

          <%# Password — only for non-OAuth users %>
          <% unless @user.oauth_user? %>
            <div class="flex items-center justify-between px-6 py-5">
              <div class="flex items-start gap-3">
                <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800">
                  <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm font-medium text-gray-900 dark:text-white">Password</p>
                  <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
                    Change your account password.
                  </p>
                </div>
              </div>
              <div>
                <%= link_to edit_profile_path(anchor: "password"), class: "rounded-lg border border-gray-300 px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800" do %>
                  Change
                <% end %>
              </div>
            </div>
          <% end %>

          <%# Email Verification Status %>
          <div class="flex items-center justify-between px-6 py-5">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800">
                <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">Email verification</p>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400"><%= @user.email %></p>
                <% if @user.email_verified? %>
                  <span class="mt-2 inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20 dark:bg-green-900/30 dark:text-green-400 dark:ring-green-500/30">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                    </svg>
                    Verified
                  </span>
                <% else %>
                  <span class="mt-2 inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20 dark:bg-amber-900/30 dark:text-amber-400 dark:ring-amber-500/30">
                    Unverified
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <%# Account Section %>
      <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="border-b border-gray-200 px-6 py-4 dark:border-gray-700">
          <h3 class="text-base font-semibold text-gray-900 dark:text-white">Account</h3>
        </div>

        <div class="divide-y divide-gray-200 dark:divide-gray-700">
          <div class="flex items-center justify-between px-6 py-5">
            <div class="flex items-start gap-3">
              <div class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800">
                <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" />
                </svg>
              </div>
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">Billing & Subscription</p>
                <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">Manage your plan, payment methods, and invoices.</p>
              </div>
            </div>
            <div>
              <%= link_to billing_path, class: "rounded-lg border border-gray-300 px-3.5 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800" do %>
                Manage
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
