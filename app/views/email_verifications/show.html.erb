<div class="flex min-h-full flex-col justify-center py-12 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-lg">
    <div class="flex justify-center">
      <svg class="h-14 w-14 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
      </svg>
    </div>
    <h2 class="mt-6 text-center text-3xl font-bold tracking-tight text-gray-800 dark:text-white/90">
      Check your email
    </h2>
    <p class="mt-3 text-center text-base text-gray-600 dark:text-gray-400">
      We sent a verification link to <strong class="text-gray-800 dark:text-white/90"><%= current_user.email %></strong>
    </p>
  </div>

  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-lg">
    <div class="rounded-2xl border border-gray-200 bg-white py-10 px-8 shadow-theme-sm dark:border-gray-800 dark:bg-white/[0.03] sm:px-12">
      <% if @expired %>
        <div class="mb-6 rounded-lg bg-amber-50 p-4 dark:bg-amber-900/20">
          <div class="flex">
            <div class="shrink-0">
              <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <h3 class="text-sm font-medium text-amber-800 dark:text-amber-200">Verification link expired</h3>
              <p class="mt-1 text-sm text-amber-700 dark:text-amber-300">Your verification link has expired. Click below to send a new one.</p>
            </div>
          </div>
        </div>
      <% end %>

      <div class="text-center space-y-6">
        <div class="rounded-lg bg-gray-50 p-6 dark:bg-gray-800/50">
          <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 3.75H6.912a2.25 2.25 0 00-2.15 1.588L2.35 13.177a2.25 2.25 0 00-.1.661V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 00-2.15-1.588H15M2.25 13.5h3.86a2.25 2.25 0 012.012 1.244l.256.512a2.25 2.25 0 002.013 1.244h3.218a2.25 2.25 0 002.013-1.244l.256-.512a2.25 2.25 0 012.013-1.244h3.859" />
          </svg>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">
            Click the link in the email to verify your account. The link expires in 24 hours.
          </p>
        </div>

        <div data-controller="resend-cooldown">
          <%= form_with url: resend_email_verification_path, method: :post do |f| %>
            <%= f.submit "Resend verification email",
              data: { resend_cooldown_target: "button", action: "click->resend-cooldown#startCooldown" },
              class: "flex w-full justify-center rounded-lg bg-primary-500 px-4 py-3 text-sm font-semibold text-white shadow-theme-xs hover:bg-primary-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 cursor-pointer transition-colors duration-150 disabled:opacity-50 disabled:cursor-not-allowed" %>
          <% end %>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400" data-resend-cooldown-target="countdown" hidden></p>
        </div>

        <div class="pt-2 border-t border-gray-200 dark:border-gray-700">
          <%= link_to "Log out", logout_path, data: { turbo_method: :delete }, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" %>
        </div>
      </div>
    </div>
  </div>
</div>
