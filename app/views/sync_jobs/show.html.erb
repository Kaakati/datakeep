<div class="space-y-6">
  <%# Header %>
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <%= link_to sync_jobs_path, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400" do %>
          <svg class="h-4 w-4 inline -mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Sync Jobs
        <% end %>
      </div>
      <h1 class="mt-1 text-2xl font-bold text-gray-800 dark:text-white/90"><%= @sync_job.name %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <%= @sync_job.source_database_config.name %> &rarr; <%= @sync_job.target_database_configs.map(&:name).join(", ") %>
        &middot; <%= @sync_job.interval_label %>
      </p>
    </div>
    <div class="mt-4 flex gap-2 sm:mt-0">
      <%= link_to edit_sync_job_path(@sync_job), class: "inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" do %>
        <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
        </svg>
        Edit
      <% end %>

      <% if @sync_job.enabled? %>
        <%= button_to pause_sync_job_path(@sync_job), method: :post, class: "inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400" do %>
          <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5 0V9M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Pause
        <% end %>
      <% else %>
        <%= button_to resume_sync_job_path(@sync_job), method: :post, class: "inline-flex items-center rounded-lg border border-green-300 bg-green-50 px-3 py-2 text-sm font-medium text-green-700 hover:bg-green-100" do %>
          <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
          </svg>
          Resume
        <% end %>
      <% end %>

      <%= button_to run_now_sync_job_path(@sync_job), method: :post, disabled: @sync_job.running?, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600 disabled:opacity-50 disabled:cursor-not-allowed" do %>
        <svg class="-ml-0.5 mr-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" />
        </svg>
        Run Now
      <% end %>
    </div>
  </div>

  <%# Stats Row %>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
      <p class="text-sm text-gray-500 dark:text-gray-400">Total Syncs</p>
      <p class="mt-1 text-2xl font-bold text-gray-800 dark:text-white/90"><%= @stats[:total] %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
      <p class="text-sm text-gray-500 dark:text-gray-400">Successful</p>
      <p class="mt-1 text-2xl font-bold text-green-600"><%= @stats[:successful] %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
      <p class="text-sm text-gray-500 dark:text-gray-400">Failed</p>
      <p class="mt-1 text-2xl font-bold text-red-600"><%= @stats[:failed] %></p>
    </div>
    <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03]">
      <p class="text-sm text-gray-500 dark:text-gray-400">Success Rate</p>
      <p class="mt-1 text-2xl font-bold text-gray-800 dark:text-white/90"><%= @stats[:success_rate] %>%</p>
    </div>
  </div>

  <%# Configuration Card %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Configuration</h3>
    </div>
    <div class="border-t border-gray-100 dark:border-gray-800">
      <dl class="divide-y divide-gray-100 dark:divide-gray-800">
        <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Source Database</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90 sm:col-span-2 sm:mt-0">
            <%= link_to @sync_job.source_database_config.name, @sync_job.source_database_config, class: "text-primary-500 hover:text-primary-700" %>
            <span class="text-gray-400 ml-1">(<%= @sync_job.source_database_config.host %>:<%= @sync_job.source_database_config.port %>)</span>
          </dd>
        </div>
        <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Target Databases</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90 sm:col-span-2 sm:mt-0">
            <% @sync_job.target_database_configs.each do |target| %>
              <div><%= link_to target.name, target, class: "text-primary-500 hover:text-primary-700" %> <span class="text-gray-400">(<%= target.host %>:<%= target.port %>)</span></div>
            <% end %>
          </dd>
        </div>
        <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Interval</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90 sm:col-span-2 sm:mt-0"><%= @sync_job.interval_label %> (<%= @sync_job.interval_minutes %> minutes)</dd>
        </div>
        <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Status</dt>
          <dd class="mt-1 sm:col-span-2 sm:mt-0">
            <% if @sync_job.running? %>
              <span class="bg-blue-50 text-blue-600 rounded-full px-2 py-0.5 text-xs font-medium">Running</span>
            <% elsif @sync_job.failed? %>
              <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Failed</span>
            <% elsif @sync_job.enabled? %>
              <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Enabled</span>
            <% else %>
              <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium">Disabled</span>
            <% end %>
          </dd>
        </div>
        <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Next Run</dt>
          <dd class="mt-1 text-sm text-gray-800 dark:text-white/90 sm:col-span-2 sm:mt-0">
            <% if @sync_job.next_run_at && @sync_job.enabled? %>
              <%= @sync_job.next_run_at.strftime("%b %d, %Y at %H:%M") %>
            <% else %>
              <span class="text-gray-400">Not scheduled</span>
            <% end %>
          </dd>
        </div>
        <% if @sync_job.last_run_at %>
          <div class="px-5 py-4 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500 dark:text-gray-400">Last Run</dt>
            <dd class="mt-1 text-sm text-gray-800 dark:text-white/90 sm:col-span-2 sm:mt-0"><%= @sync_job.last_run_at.strftime("%b %d, %Y at %H:%M") %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <%# Execution History %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 px-5 sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Execution History</h3>
    </div>

    <% if @recent_executions.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-5 font-normal whitespace-nowrap text-left"><p class="text-sm text-gray-500">Started</p></th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left"><p class="text-sm text-gray-500">Duration</p></th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left"><p class="text-sm text-gray-500">Targets</p></th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left"><p class="text-sm text-gray-500">Status</p></th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left"><p class="text-sm text-gray-500">Details</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @recent_executions.each do |execution| %>
              <tr>
                <td class="py-3 pr-5 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-white/90"><%= execution.started_at&.strftime("%b %d, %Y") || "—" %></p>
                  <p class="text-xs text-gray-500"><%= execution.started_at&.strftime("%H:%M:%S") %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% if execution.duration %>
                    <p class="text-sm text-gray-700 dark:text-white/90"><%= execution.duration.round(1) %>s</p>
                  <% else %>
                    <p class="text-sm text-gray-400">—</p>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-white/90"><%= execution.targets_succeeded %>/<%= execution.targets_count %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% case execution.status %>
                  <% when "completed" %>
                    <% if execution.partially_failed? %>
                      <span class="bg-yellow-50 text-yellow-600 rounded-full px-2 py-0.5 text-xs font-medium">Partial</span>
                    <% else %>
                      <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Completed</span>
                    <% end %>
                  <% when "failed" %>
                    <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Failed</span>
                  <% when "running" %>
                    <span class="bg-blue-50 text-blue-600 rounded-full px-2 py-0.5 text-xs font-medium">Running</span>
                  <% else %>
                    <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium">Pending</span>
                  <% end %>
                </td>
                <td class="px-5 py-3">
                  <% if execution.error_message.present? %>
                    <p class="text-xs text-red-600 truncate max-w-xs" title="<%= execution.error_message %>"><%= execution.error_message %></p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-200 dark:border-gray-800 px-6 py-4">
        <p class="text-sm text-gray-500">Showing last <%= @recent_executions.count %> executions</p>
      </div>
    <% else %>
      <div class="px-5 py-10 text-center sm:px-6">
        <p class="text-sm text-gray-500">No executions yet. Click "Run Now" to trigger the first sync.</p>
      </div>
    <% end %>
  </div>

  <%# Danger Zone %>
  <div class="rounded-2xl border border-red-200 bg-white dark:border-red-900/30 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-red-600">Danger Zone</h3>
    </div>
    <div class="border-t border-red-100 p-5 sm:p-6 dark:border-red-900/30">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-gray-800 dark:text-white/90">Delete this sync job</p>
          <p class="text-sm text-gray-500 dark:text-gray-400">Permanently delete this sync job and all execution history.</p>
        </div>
        <%= button_to @sync_job, method: :delete,
            data: { turbo_confirm: "Are you sure you want to delete '#{@sync_job.name}'? This cannot be undone." },
            class: "inline-flex items-center rounded-lg border border-red-300 bg-white px-3 py-2 text-sm font-medium text-red-700 hover:bg-red-50" do %>
          Delete Sync Job
        <% end %>
      </div>
    </div>
  </div>
</div>
