<%= form_with model: sync_job, class: "space-y-6", data: { controller: "sync-job-form" } do |f| %>
  <% if sync_job.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">There were errors with your submission</h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-300">
            <ul class="list-disc space-y-1 pl-5">
              <% sync_job.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%# Basic Information %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Basic Information</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Configure the name and source database for this sync job</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :name, "Job Name", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :name, placeholder: "Production to Staging Sync", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div class="sm:col-span-2">
          <%= f.label :source_database_config_id, "Source Database", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= f.collection_select :source_database_config_id,
                current_user.database_configs, :id, :name,
                { prompt: "Select source database" },
                class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90",
                data: { action: "change->sync-job-form#updateTargets", sync_job_form_target: "sourceSelect" } %>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Data will be read from this database and pushed to all targets</p>
        </div>
      </div>
    </div>
  </div>

  <%# Schedule %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Sync Interval</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">How often should this sync run?</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <%= f.label :interval_minutes, "Interval (minutes)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.number_field :interval_minutes, min: 1, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Minimum 1 minute. Examples: 5 (every 5 min), 60 (hourly), 1440 (daily)</p>
        </div>
      </div>
    </div>
  </div>

  <%# Target Databases %>
  <% other_databases = current_user.database_configs.where.not(id: sync_job.source_database_config_id) %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Target Databases</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Select one or more databases to sync data into. <strong class="text-red-600">Warning:</strong> target databases will be overwritten on each sync.
      </p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800" data-sync-job-form-target="targetsContainer">
      <% all_databases = current_user.database_configs %>
      <% if all_databases.count < 2 %>
        <p class="text-sm text-gray-500 dark:text-gray-400">You need at least 2 database connections to configure sync targets. <%= link_to "Add a database", new_database_config_path, class: "text-primary-500 hover:text-primary-700" %>.</p>
      <% else %>
        <div class="space-y-4" data-sync-job-form-target="targetsList">
          <% all_databases.each do |db| %>
            <% target_checked = sync_job.target_database_config_ids.include?(db.id) %>
            <div class="target-item" data-db-id="<%= db.id %>" data-sync-job-form-target="targetItem">
              <div data-controller="checkbox"
                   data-checkbox-checked-value="<%= target_checked %>"
                   data-checkbox-checked-class="border-brand-500 bg-brand-500"
                   data-checkbox-unchecked-class="bg-transparent border-gray-300 dark:border-gray-700">
                <label for="target_db_<%= db.id %>" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400">
                  <div class="relative">
                    <%= check_box_tag "sync_job[target_database_config_ids][]", db.id, target_checked,
                        id: "target_db_#{db.id}",
                        class: "sr-only",
                        data: { checkbox_target: "input" } %>
                    <div data-checkbox-target="box" class="hover:border-brand-500 dark:hover:border-brand-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px] <%= target_checked ? 'border-brand-500 bg-brand-500' : 'bg-transparent border-gray-300 dark:border-gray-700' %>">
                      <span data-checkmark class="<%= target_checked ? '' : 'opacity-0' %>">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                    </div>
                  </div>
                  <div>
                    <span class="text-sm font-medium text-gray-800 dark:text-white/90"><%= db.name %></span>
                    <p class="text-sm text-gray-500 dark:text-gray-400"><%= db.host %>:<%= db.port %> / <%= db.database_name %></p>
                  </div>
                </label>
              </div>
            </div>
          <% end %>
        </div>
        <p class="mt-3 text-xs text-gray-400 dark:text-gray-500">The source database is automatically excluded from the target list.</p>
      <% end %>
    </div>
  </div>

  <%# Enabled %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Options</h3>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div data-controller="checkbox"
           data-checkbox-checked-value="<%= sync_job.enabled? %>"
           data-checkbox-checked-class="border-success-500 bg-success-500"
           data-checkbox-unchecked-class="bg-transparent border-gray-300 dark:border-gray-700">
        <label for="sync_job_enabled" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400">
          <div class="relative">
            <%= f.check_box :enabled, { class: "sr-only", data: { checkbox_target: "input" } } %>
            <div data-checkbox-target="box" class="hover:border-success-500 dark:hover:border-success-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px] <%= sync_job.enabled? ? 'border-success-500 bg-success-500' : 'bg-transparent border-gray-300 dark:border-gray-700' %>">
              <span data-checkmark class="<%= sync_job.enabled? ? '' : 'opacity-0' %>">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              </span>
            </div>
          </div>
          <div>
            <span class="text-sm font-medium text-gray-800 dark:text-white/90">Enabled</span>
            <p class="text-sm text-gray-500 dark:text-gray-400">Enable automatic scheduled syncing on the configured interval</p>
          </div>
        </label>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", sync_jobs_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03]" %>
    <%= f.submit sync_job.persisted? ? "Update Sync Job" : "Create Sync Job", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer" %>
  </div>
<% end %>
