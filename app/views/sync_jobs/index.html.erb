<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Sync Jobs</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Automatically copy data from a source database to target servers on a set interval</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_sync_job_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New Sync Job
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Scheduled Syncs</h3>
    </div>

    <% if @sync_jobs.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Name</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Source</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Targets</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Interval</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Next Run</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Status</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-right">
                <p class="text-sm text-gray-500">Actions</p>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @sync_jobs.each do |job| %>
              <tr>
                <td class="py-3 pr-5 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <% if job.enabled? %>
                      <div class="h-8 w-8 rounded-full bg-blue-100 flex items-center justify-center">
                        <svg class="h-4 w-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                      </div>
                    <% else %>
                      <div class="h-8 w-8 rounded-full bg-gray-100 flex items-center justify-center">
                        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5 0V9M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    <% end %>
                    <div>
                      <%= link_to job.name, job, class: "text-sm font-medium text-gray-700 hover:text-primary-600 dark:text-white/90" %>
                      <p class="text-xs text-gray-500"><%= job.success_rate %>% success</p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <%= link_to job.source_database_config.name, job.source_database_config, class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-white/90"><%= job.target_database_configs.count %> target<%= job.target_database_configs.count == 1 ? '' : 's' %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-white/90"><%= job.interval_label %></p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% if job.next_run_at && job.enabled? %>
                    <p class="text-sm text-gray-700 dark:text-white/90"><%= job.next_run_at.strftime("%b %d, %Y") %></p>
                    <p class="text-xs text-gray-500"><%= job.next_run_at.strftime("%H:%M") %></p>
                  <% else %>
                    <p class="text-sm text-gray-400">Paused</p>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% if job.running? %>
                    <span class="bg-blue-50 text-blue-600 rounded-full px-2 py-0.5 text-xs font-medium">Running</span>
                  <% elsif job.failed? %>
                    <span class="bg-red-50 text-red-600 rounded-full px-2 py-0.5 text-xs font-medium">Failed</span>
                  <% elsif job.enabled? %>
                    <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Enabled</span>
                  <% else %>
                    <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium">Disabled</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right">
                  <%= link_to "View", job, class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="border-t border-gray-200 dark:border-gray-800 px-6 py-4">
        <p class="text-sm text-gray-700 dark:text-gray-400">
          Showing <span class="font-medium"><%= @sync_jobs.count %></span> sync job<%= @sync_jobs.count == 1 ? '' : 's' %>
        </p>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center sm:px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900 dark:text-white">No sync jobs</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating your first sync job.</p>
        <div class="mt-6">
          <%= link_to new_sync_job_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
            <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            New Sync Job
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
