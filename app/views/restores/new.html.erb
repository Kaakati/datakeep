<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Restore Database</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Restore a database from a backup or uploaded file</p>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Restore from Existing Backup</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Select a completed backup to restore from</p>
      </div>
      <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <%= form_with url: restores_path, method: :post, class: "space-y-5" do |f| %>
          <div>
            <%= f.label :database_config_id, "Target Database", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <%= f.collection_select :database_config_id, current_user.database_configs, :id, :name, { prompt: "Select a database" }, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
              <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </span>
            </div>
          </div>

          <div>
            <%= f.label :backup_id, "Backup", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <%= f.collection_select :backup_id, @available_backups, :id, :display_name, { prompt: "Select a backup" }, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
              <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </span>
            </div>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Only completed backups are shown</p>
          </div>

          <div class="pt-2">
            <%= f.submit "Start Restore", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer", data: { turbo_confirm: "Are you sure you want to restore this backup? This will overwrite the target database." } %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Restore from Uploaded File</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Upload a PostgreSQL dump file to restore</p>
      </div>
      <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <%= form_with url: upload_restore_path, method: :post, multipart: true, class: "space-y-5" do |f| %>
          <div>
            <%= f.label :database_config_id, "Target Database", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <%= f.collection_select :database_config_id, current_user.database_configs, :id, :name, { prompt: "Select a database" }, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
              <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </span>
            </div>
          </div>

          <div>
            <%= f.label :dump_file, "Dump File", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <%= f.file_field :dump_file, accept: ".sql,.dump,.gz,.sql.gz", class: "shadow-theme-xs h-11 w-full rounded-lg border border-gray-300 bg-transparent text-sm text-gray-500 file:mr-4 file:h-full file:border-0 file:bg-brand-50 file:px-4 file:text-sm file:font-medium file:text-brand-700 hover:file:bg-brand-100 focus:border-brand-300 focus:ring-brand-500/10 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/70 dark:file:bg-gray-800 dark:file:text-white/90" %>
            </div>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Accepts .sql, .dump, .gz, or .sql.gz files</p>
          </div>

          <div class="pt-2">
            <%= f.submit "Upload and Restore", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer", data: { turbo_confirm: "Are you sure you want to restore from this file? This will overwrite the target database." } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="rounded-lg bg-warning-50 p-4 dark:bg-warning-900/20">
    <div class="flex">
      <div class="shrink-0">
        <svg class="h-5 w-5 text-warning-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495zM10 5a.75.75 0 01.75.75v3.5a.75.75 0 01-1.5 0v-3.5A.75.75 0 0110 5zm0 9a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd" />
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-warning-800 dark:text-warning-200">Warning</h3>
        <div class="mt-2 text-sm text-warning-700 dark:text-warning-300">
          <p>Restoring a database will <strong>overwrite all existing data</strong> in the target database. Make sure you have a backup of any important data before proceeding.</p>
        </div>
      </div>
    </div>
  </div>
</div>
