<%= render "shared/session_nav", context: :login %>

<div class="flex min-h-screen">
  <%# Left panel — storytelling %>
  <div class="hidden lg:flex lg:w-1/2 flex-col justify-between bg-gradient-to-br from-primary-600 via-primary-700 to-blue-800 px-12 pt-24 pb-12">
    <div class="max-w-md">
      <h1 class="text-3xl font-bold text-white leading-tight">
        Your databases are running.<br>
        <span class="text-primary-200">We make sure they're safe.</span>
      </h1>
      <p class="mt-4 text-base text-primary-100/80 leading-relaxed">
        DataKeep watches over your PostgreSQL, MySQL, and MongoDB databases around the clock. Automated backups, instant alerts, one-click restores.
      </p>
    </div>

    <%# Social proof %>
    <div class="space-y-6">
      <div class="flex items-start gap-4 rounded-xl bg-white/10 backdrop-blur-sm p-5">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/20 text-white font-bold text-sm">MK</div>
        <div>
          <p class="text-sm text-white/90 leading-relaxed">"We went from manual pg_dump scripts to fully automated backups with VPN support in under an hour. DataKeep just works."</p>
          <p class="mt-2 text-xs text-primary-200">Engineering Lead, SaaS Company</p>
        </div>
      </div>

      <div class="flex items-center gap-6 text-primary-200 text-sm">
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
          <span>Encrypted at rest</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
          <span>VPN tunnel support</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" /></svg>
          <span>Multi-cloud storage</span>
        </div>
      </div>
    </div>
  </div>

  <%# Right panel — login form %>
  <div class="flex w-full flex-col justify-center px-6 pt-24 pb-12 sm:px-12 lg:w-1/2 lg:px-16">
    <div class="mx-auto w-full max-w-md">
      <%# Mobile-only logo %>
      <div class="mb-8 flex justify-center lg:hidden">
        <%= image_tag "logo.svg", class: "h-12 w-12", alt: "DataKeep" %>
      </div>

      <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        Welcome back
      </h2>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
        Sign in to your account to continue where you left off.
      </p>

      <div class="mt-8">
        <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-white/[0.03]">
          <%= form_with url: login_path, method: :post, class: "space-y-5" do |f| %>
            <div>
              <%= f.label :email, class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
              <%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
            </div>

            <div x-data="{ showPassword: false }">
              <%= f.label :password, class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
              <div class="relative">
                <input
                  type="password"
                  name="password"
                  id="password"
                  required
                  autocomplete="current-password"
                  placeholder="Enter your password"
                  :type="showPassword ? 'text' : 'password'"
                  class="shadow-theme-xs focus:border-primary-300 focus:ring-primary-500/10 dark:focus:border-primary-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-12 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"
                />
                <button type="button" @click="showPassword = !showPassword"
                  class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300">
                  <svg x-show="!showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <svg x-show="showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                  </svg>
                </button>
              </div>
            </div>

            <%= turnstile_tag %>

            <div class="pt-1">
              <%= f.submit "Sign in", class: "flex w-full justify-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 cursor-pointer transition-colors duration-150" %>
            </div>
          <% end %>

          <div class="mt-6">
            <div class="relative">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200 dark:border-gray-700"></div>
              </div>
              <div class="relative flex justify-center text-xs">
                <span class="bg-white px-3 text-gray-500 dark:bg-gray-900 dark:text-gray-400">or</span>
              </div>
            </div>

            <div class="mt-4">
              <%= render "shared/google_oauth_button" %>
            </div>
          </div>
        </div>

        <%# Mobile-only signup CTA %>
        <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400 lg:hidden">
          Don't have an account?
          <%= link_to "Create one for free", signup_path, class: "font-medium text-primary-500 hover:text-primary-600" %>
        </p>
      </div>
    </div>
  </div>
</div>
