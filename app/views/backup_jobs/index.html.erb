<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Backup Jobs</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage your scheduled backup jobs</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_backup_job_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New Backup Job
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800">Scheduled Jobs</h3>
    </div>

    <% if @backup_jobs.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100">
            <tr>
              <th class="py-3 pr-5 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Name</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Database</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Schedule</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Next Run</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Stats</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-left">
                <p class="text-sm text-gray-500">Status</p>
              </th>
              <th class="px-5 py-3 font-normal whitespace-nowrap text-right">
                <p class="text-sm text-gray-500">Actions</p>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @backup_jobs.each do |job| %>
              <tr>
                <td class="py-3 pr-5 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <% if job.enabled? %>
                      <div class="h-8 w-8 rounded-full bg-green-100 flex items-center justify-center">
                        <svg class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    <% else %>
                      <div class="h-8 w-8 rounded-full bg-gray-100 flex items-center justify-center">
                        <svg class="h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9v6m-4.5 0V9M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      </div>
                    <% end %>
                    <div>
                      <%= link_to job.name, job, class: "text-sm font-medium text-gray-700 hover:text-primary-600" %>
                      <p class="text-xs text-gray-500"><%= job.storage_backend.name %></p>
                    </div>
                  </div>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <%= link_to job.database_config.name, job.database_config, class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700"><%= job.schedule_type.titleize %></p>
                  <% if job.schedule_type == "custom" && job.cron_expression.present? %>
                    <p class="text-xs text-gray-500"><%= job.cron_expression %></p>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% if job.next_run_at %>
                    <p class="text-sm text-gray-700"><%= job.next_run_at.strftime("%b %d, %Y") %></p>
                    <p class="text-xs text-gray-500"><%= job.next_run_at.strftime("%H:%M") %></p>
                  <% else %>
                    <p class="text-sm text-gray-400">Not scheduled</p>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700"><%= job.backups.count %> backup<%= job.backups.count == 1 ? '' : 's' %></p>
                  <p class="text-xs text-gray-500"><%= job.success_rate %>% success</p>
                </td>
                <td class="px-5 py-3 whitespace-nowrap">
                  <% if job.enabled? %>
                    <span class="bg-green-50 text-green-600 rounded-full px-2 py-0.5 text-xs font-medium">Enabled</span>
                  <% else %>
                    <span class="bg-gray-50 text-gray-600 rounded-full px-2 py-0.5 text-xs font-medium">Disabled</span>
                  <% end %>
                </td>
                <td class="px-5 py-3 whitespace-nowrap text-right">
                  <%= link_to "View", job, class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="border-t border-gray-200 px-6 py-4">
        <div class="flex items-center justify-between">
          <p class="text-sm text-gray-700">
            Showing <span class="font-medium"><%= @backup_jobs.count %></span> backup jobs
          </p>
        </div>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center sm:px-6">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h3 class="mt-2 text-sm font-semibold text-gray-900">No backup jobs</h3>
        <p class="mt-1 text-sm text-gray-500">Get started by creating your first backup job.</p>
        <div class="mt-6">
          <%= link_to new_backup_job_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white hover:bg-primary-600" do %>
            <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
            </svg>
            New Backup Job
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
