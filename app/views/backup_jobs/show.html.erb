<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90"><%= @backup_job.name %></h1>
        <%= status_badge(@backup_job.enabled? ? "enabled" : "disabled") %>
      </div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <%= @backup_job.database_config.name %> &rarr; <%= @backup_job.storage_backend.name %>
      </p>
    </div>
    <div class="mt-4 flex flex-wrap gap-3 sm:mt-0">
      <% if @backup_job.enabled? %>
        <%= button_to run_now_backup_job_path(@backup_job), method: :post, class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.344-5.891a1.5 1.5 0 000-2.538L6.3 2.84z" />
          </svg>
          Run Now
        <% end %>
        <%= button_to pause_backup_job_path(@backup_job), method: :post, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
            <path d="M5.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75A.75.75 0 007.25 3h-1.5zM12.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75a.75.75 0 00-.75-.75h-1.5z" />
          </svg>
          Pause
        <% end %>
      <% else %>
        <%= button_to resume_backup_job_path(@backup_job), method: :post, class: "inline-flex items-center rounded-md bg-green-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
            <path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.344-5.891a1.5 1.5 0 000-2.538L6.3 2.84z" />
          </svg>
          Resume
        <% end %>
      <% end %>
      <%= link_to edit_backup_job_path(@backup_job), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
        </svg>
        Edit
      <% end %>
      <%= button_to backup_job_path(@backup_job), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this backup job? This will also delete all associated backups." }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    <div class="lg:col-span-2 space-y-6">
      <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Job Configuration</h3>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800">
          <dl>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Database</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <%= link_to @backup_job.database_config.name, @backup_job.database_config, class: "text-primary-500 hover:text-indigo-500" %>
              </dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Storage</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <%= link_to @backup_job.storage_backend.name, storage_backend_path(@backup_job.storage_backend), class: "text-primary-500 hover:text-indigo-500" %>
              </dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Schedule</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <%= @backup_job.schedule_type.titleize %>
                <% if @backup_job.schedule_type == "custom" %>
                  <span class="text-gray-500">(<%= @backup_job.cron_expression %>)</span>
                <% end %>
              </dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Next Run</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <% if @backup_job.next_run_at %>
                  <%= @backup_job.next_run_at.strftime("%B %d, %Y at %H:%M") %>
                  <span class="text-gray-500">(<%= time_ago_in_words(@backup_job.next_run_at) %> from now)</span>
                <% else %>
                  Not scheduled
                <% end %>
              </dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Last Run</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <%= time_ago_or_never(@backup_job.last_run_at) %>
              </dd>
            </div>
            <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Retention</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @backup_job.retention_days %> days</dd>
            </div>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Options</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                <div class="flex flex-wrap gap-2">
                  <% if @backup_job.compression? %>
                    <span class="inline-flex items-center rounded-full bg-blue-50 px-2 py-1 text-xs font-medium text-blue-700 ring-1 ring-inset ring-blue-700/10">
                      Compression
                    </span>
                  <% end %>
                  <% if @backup_job.encryption? %>
                    <span class="inline-flex items-center rounded-full bg-purple-50 px-2 py-1 text-xs font-medium text-purple-700 ring-1 ring-inset ring-purple-700/10">
                      Encryption
                    </span>
                  <% end %>
                  <% if !@backup_job.compression? && !@backup_job.encryption? %>
                    <span class="text-gray-500">None</span>
                  <% end %>
                </div>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <% if @backup_job.notification_channels.any? %>
        <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
          <div class="px-4 py-5 sm:px-6">
            <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Notifications</h3>
          </div>
          <div class="border-t border-gray-200 dark:border-gray-800">
            <ul class="divide-y divide-gray-200">
              <% @backup_job.notification_channels.each do |channel| %>
                <li class="px-4 py-4 sm:px-6">
                  <div class="flex items-center justify-between">
                    <div>
                      <%= link_to channel.name, notification_channel_path(channel), class: "text-sm font-medium text-primary-500 hover:text-indigo-500" %>
                      <p class="text-sm text-gray-500"><%= channel.channel_type.titleize %></p>
                    </div>
                    <%= status_badge(channel.enabled? ? "enabled" : "disabled") %>
                  </div>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-6">
      <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Statistics</h3>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800 px-4 py-5 sm:px-6">
          <dl class="space-y-4">
            <div class="flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Total Backups</dt>
              <dd class="text-sm font-semibold text-gray-900"><%= @backup_job.backups.count %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Success Rate</dt>
              <dd class="text-sm font-semibold text-gray-900"><%= @backup_job.success_rate %>%</dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Total Size</dt>
              <dd class="text-sm font-semibold text-gray-900"><%= format_bytes(@backup_job.backups.sum(:file_size)) %></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-sm font-medium text-gray-500">Latest Backup</dt>
              <dd class="text-sm font-semibold text-gray-900">
                <% if @backup_job.backups.any? %>
                  <%= time_ago_or_never(@backup_job.backups.order(created_at: :desc).first.created_at) %>
                <% else %>
                  Never
                <% end %>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
        <div class="px-4 py-5 sm:px-6">
          <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Status</h3>
        </div>
        <div class="border-t border-gray-200 dark:border-gray-800 px-4 py-5 sm:px-6">
          <div class="flex items-center">
            <% case @backup_job.status %>
            <% when "idle" %>
              <span class="flex h-3 w-3 rounded-full bg-gray-400"></span>
              <span class="ml-2 text-sm text-gray-700">Idle</span>
            <% when "running" %>
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span>
              </span>
              <span class="ml-2 text-sm text-gray-700">Running</span>
            <% when "failed" %>
              <span class="flex h-3 w-3 rounded-full bg-red-500"></span>
              <span class="ml-2 text-sm text-gray-700">Failed</span>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
    <div class="px-4 py-5 sm:px-6 flex items-center justify-between">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Recent Backups</h3>
      <%= link_to "View All", backup_job_backups_path(@backup_job), class: "text-sm font-medium text-primary-500 hover:text-indigo-500" %>
    </div>
    <div class="border-t border-gray-200">
      <% if @recent_backups.any? %>
        <table class="min-w-full divide-y divide-gray-300">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Date</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Size</th>
              <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Duration</th>
              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @recent_backups.each do |backup| %>
              <tr>
                <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm text-gray-900 sm:pl-6">
                  <%= backup.created_at.strftime("%b %d, %Y %H:%M") %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm">
                  <%= status_badge(backup.status) %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= backup.formatted_size %>
                </td>
                <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                  <%= backup.formatted_duration %>
                </td>
                <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                  <% if backup.completed? %>
                    <%= link_to "View", backup_job_backup_path(@backup_job, backup), class: "text-primary-500 hover:text-primary-700 mr-3" %>
                    <%= button_to "Restore", restore_backup_job_backup_path(@backup_job, backup), method: :post, data: { turbo_confirm: "Are you sure you want to restore from this backup?" }, class: "text-green-600 hover:text-green-900" %>
                  <% else %>
                    <%= link_to "View", backup_job_backup_path(@backup_job, backup), class: "text-primary-500 hover:text-primary-700" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <div class="px-4 py-5 sm:px-6 text-center">
          <p class="text-sm text-gray-500">No backups yet. Run the backup job to create your first backup.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
