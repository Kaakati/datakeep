<%= form_with model: storage_backend, url: storage_backend.persisted? ? admin_storage_backend_path(storage_backend) : admin_storage_backends_path, class: "space-y-6" do |f| %>
  <% if storage_backend.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">There were errors with your submission</h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-300">
            <ul class="list-disc space-y-1 pl-5">
              <% storage_backend.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Managed Storage Backend</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">S3 storage available to all users as a DataKeep managed region</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :name, class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :name, placeholder: "DataKeep S3 — Cape Town", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div>
          <%= label_tag "storage_backend_config_bucket", "Bucket", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "storage_backend[config][bucket]", storage_backend.config&.dig(:bucket), id: "storage_backend_config_bucket", placeholder: "datakeep-managed-backups", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div>
          <%= label_tag "storage_backend_config_region", "Region", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= select_tag "storage_backend[config][region]", options_for_select(
              [["Select a region", ""]] + StorageBackends::S3Storage::AWS_REGIONS,
              storage_backend.config&.dig(:region)
            ), id: "storage_backend_config_region", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </div>

        <div class="sm:col-span-2">
          <%= label_tag "storage_backend_config_prefix", "Key Prefix (Optional)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "storage_backend[config][prefix]", storage_backend.config&.dig(:prefix), id: "storage_backend_config_prefix", placeholder: "managed/backups/", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div>
          <%= label_tag "storage_backend_config_access_key_id", "Access Key ID", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "storage_backend[config][access_key_id]", storage_backend.config&.dig(:access_key_id), id: "storage_backend_config_access_key_id", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div>
          <%= label_tag "storage_backend_config_secret_access_key", "Secret Access Key", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <input
            type="password"
            name="storage_backend[config][secret_access_key]"
            id="storage_backend_config_secret_access_key"
            placeholder="<%= storage_backend.persisted? ? "Leave blank to keep current" : "" %>"
            class="shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", admin_storage_backends_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03]" %>
    <%= f.submit storage_backend.persisted? ? "Update Managed Storage" : "Create Managed Storage", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer" %>
  </div>
<% end %>
