<%= form_with url: admin_enterprise_quote_calculator_path, method: :post, data: { controller: "database-builder", turbo_frame: "quote-results" } do |f| %>
  <div class="space-y-6">
    <%# Database Rows %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Databases</h3>
        <button type="button"
          data-action="click->database-builder#addRow"
          class="inline-flex items-center rounded-lg bg-primary-500 px-3 py-1.5 text-xs font-medium text-white hover:bg-primary-600">
          <svg class="-ml-0.5 mr-1 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          Add Database
        </button>
      </div>

      <div data-database-builder-target="container" class="space-y-3">
        <%# Template row (cloned by Stimulus) %>
        <template data-database-builder-target="template">
          <div class="database-row grid grid-cols-12 gap-3 items-end" data-database-builder-target="row">
            <div class="col-span-3">
              <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Name</label>
              <input type="text" name="databases[INDEX][name]" placeholder="e.g. Production"
                class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
            </div>
            <div class="col-span-3">
              <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Engine</label>
              <select name="databases[INDEX][engine]"
                class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
                <option value="postgresql">PostgreSQL</option>
                <option value="mysql">MySQL</option>
                <option value="mongodb">MongoDB</option>
                <option value="mssql">MSSQL</option>
                <option value="oracle">Oracle</option>
              </select>
            </div>
            <div class="col-span-2">
              <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Size (GB)</label>
              <input type="number" name="databases[INDEX][size_gb]" min="1" step="1" placeholder="50"
                class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
            </div>
            <div class="col-span-3">
              <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Frequency</label>
              <select name="databases[INDEX][frequency]"
                class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
                <option value="hourly">Hourly</option>
                <option value="every_6h">Every 6h</option>
                <option value="daily">Daily</option>
              </select>
            </div>
            <div class="col-span-1 flex justify-center">
              <button type="button" data-action="click->database-builder#removeRow" class="p-1.5 text-red-400 hover:text-red-600 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20" title="Remove">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          </div>
        </template>

        <%# Pre-populated rows (on re-render after submit) %>
        <% if params[:databases].present? %>
          <% params[:databases].to_unsafe_h.each_with_index do |(idx, db), i| %>
            <div class="database-row grid grid-cols-12 gap-3 items-end" data-database-builder-target="row">
              <div class="col-span-3">
                <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Name</label>
                <input type="text" name="databases[<%= i %>][name]" value="<%= db[:name] %>" placeholder="e.g. Production"
                  class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
              </div>
              <div class="col-span-3">
                <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Engine</label>
                <select name="databases[<%= i %>][engine]"
                  class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
                  <% %w[postgresql mysql mongodb mssql oracle].each do |eng| %>
                    <option value="<%= eng %>" <%= 'selected' if db[:engine] == eng %>><%= eng.titleize %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-span-2">
                <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Size (GB)</label>
                <input type="number" name="databases[<%= i %>][size_gb]" value="<%= db[:size_gb] %>" min="1" step="1" placeholder="50"
                  class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
              </div>
              <div class="col-span-3">
                <label class="mb-1 block text-xs font-medium text-gray-700 dark:text-gray-300">Frequency</label>
                <select name="databases[<%= i %>][frequency]"
                  class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
                  <% { hourly: "Hourly", every_6h: "Every 6h", daily: "Daily" }.each do |val, label| %>
                    <option value="<%= val %>" <%= 'selected' if db[:frequency] == val.to_s %>><%= label %></option>
                  <% end %>
                </select>
              </div>
              <div class="col-span-1 flex justify-center">
                <button type="button" data-action="click->database-builder#removeRow" class="p-1.5 text-red-400 hover:text-red-600 rounded-lg hover:bg-red-50 dark:hover:bg-red-900/20" title="Remove">
                  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Configuration %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Configuration</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Retention (days)</label>
          <input type="number" name="retention_days" value="<%= params[:retention_days] || 30 %>" min="1" max="365"
            class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Regions</label>
          <select name="regions"
            class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
            <% { 1 => "Single Region", 2 => "Dual Region", 3 => "Triple Region", 4 => "Quad Region", 5 => "Global (5 Regions)" }.each do |val, label| %>
              <option value="<%= val %>" <%= 'selected' if params[:regions].to_s == val.to_s %>><%= label %></option>
            <% end %>
          </select>
        </div>
      </div>
    </div>

    <%# Discount %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6" data-controller="discount">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Discount</h3>
      <div class="max-w-xs">
        <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Discount (%)</label>
        <input type="number" name="discount_percent" value="<%= params[:discount_percent] || 0 %>" min="0" max="40" step="1"
          data-action="input->discount#changed"
          class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" />
        <p class="mt-1 text-xs text-gray-400">Max 40%</p>
      </div>
    </div>

    <%# Submit %>
    <button type="submit" class="w-full rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 cursor-pointer">
      Calculate Quote
    </button>
  </div>
<% end %>
