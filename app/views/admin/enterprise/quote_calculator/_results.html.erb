<div class="space-y-6" data-controller="clipboard">
  <%# Line Items Breakdown %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 px-5 sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Quote Breakdown</h3>
    </div>

    <div class="overflow-x-auto px-5 sm:px-6">
      <table class="min-w-full">
        <thead class="border-y border-gray-100 dark:border-gray-800">
          <tr>
            <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Database</p></th>
            <th class="px-3 py-3 text-left font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Engine</p></th>
            <th class="px-3 py-3 text-right font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Raw Size</p></th>
            <th class="px-3 py-3 text-right font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Compressed</p></th>
            <th class="px-3 py-3 text-right font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Stored</p></th>
            <th class="px-3 py-3 text-right font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Storage</p></th>
            <th class="px-3 py-3 text-center font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Regions</p></th>
            <th class="py-3 pl-3 text-right font-normal whitespace-nowrap"><p class="text-xs text-gray-500 dark:text-gray-400">Line Total</p></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% result.line_items.each do |item| %>
            <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
              <td class="py-3 pr-4 whitespace-nowrap"><span class="text-sm font-medium text-gray-700 dark:text-white/90"><%= item.name %></span></td>
              <td class="px-3 py-3 whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= item.engine.titleize %></span></td>
              <td class="px-3 py-3 text-right whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= item.raw_size_gb %> GB</span></td>
              <td class="px-3 py-3 text-right whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= item.compressed_gb %> GB</span></td>
              <td class="px-3 py-3 text-right whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= number_with_delimiter(item.total_stored_gb) %> GB</span></td>
              <td class="px-3 py-3 text-right whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= number_to_currency(item.storage_cost_cents / 100.0) %></span></td>
              <td class="px-3 py-3 text-center whitespace-nowrap"><span class="text-sm text-gray-600 dark:text-gray-300"><%= item.regions %>&times;</span></td>
              <td class="py-3 pl-3 text-right whitespace-nowrap"><span class="text-sm font-medium text-gray-700 dark:text-white/90"><%= number_to_currency(item.line_total_cents / 100.0) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
      <p class="text-sm text-gray-500 dark:text-gray-400"><%= result.line_items.size %> database<%= result.line_items.size == 1 ? '' : 's' %></p>
    </div>
  </div>

  <%# Summary %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Summary</h3>
    <dl class="space-y-3">
      <div class="flex items-center justify-between">
        <dt class="text-sm text-gray-500 dark:text-gray-400">Platform Fee</dt>
        <dd class="text-sm font-medium text-gray-700 dark:text-white/90"><%= number_to_currency(result.platform_fee_cents / 100.0) %></dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-sm text-gray-500 dark:text-gray-400">Storage Total</dt>
        <dd class="text-sm font-medium text-gray-700 dark:text-white/90"><%= number_to_currency(result.line_items.sum(&:line_total_cents) / 100.0) %></dd>
      </div>
      <div class="flex items-center justify-between border-t border-gray-100 dark:border-gray-800 pt-3">
        <dt class="text-sm font-semibold text-gray-700 dark:text-white/90">Subtotal (monthly)</dt>
        <dd class="text-sm font-semibold text-gray-700 dark:text-white/90"><%= number_to_currency(result.subtotal_cents / 100.0) %></dd>
      </div>

      <% if result.discount_percent > 0 %>
        <div class="flex items-center justify-between text-green-600 dark:text-green-400">
          <dt class="text-sm">Discount (<%= result.discount_percent.to_i %>%)</dt>
          <dd class="text-sm font-medium">-<%= number_to_currency(result.discount_amount_cents / 100.0) %></dd>
        </div>
      <% end %>

      <div class="flex items-center justify-between border-t border-gray-200 dark:border-gray-700 pt-3">
        <dt class="text-base font-bold text-gray-800 dark:text-white">Monthly Total</dt>
        <dd class="text-base font-bold text-primary-600 dark:text-primary-400"><%= number_to_currency(result.total_monthly_cents / 100.0) %></dd>
      </div>
      <div class="flex items-center justify-between">
        <dt class="text-sm text-gray-500 dark:text-gray-400">Annual Contract Value</dt>
        <dd class="text-sm font-semibold text-gray-700 dark:text-white/90"><%= number_to_currency(result.annual_contract_value_cents / 100.0) %></dd>
      </div>
      <% if result.savings_amount_cents > 0 %>
        <div class="flex items-center justify-between text-green-600 dark:text-green-400">
          <dt class="text-sm">Annual Savings</dt>
          <dd class="text-sm font-medium"><%= number_to_currency(result.savings_amount_cents / 100.0) %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# Copy Quote Button %>
  <button
    type="button"
    data-action="click->clipboard#copy"
    data-clipboard-text-value="<%= "Enterprise Quote\n#{'=' * 40}\n#{result.line_items.map { |i| "#{i.name} (#{i.engine.titleize}) - #{i.raw_size_gb}GB raw, #{i.compressed_gb}GB compressed, #{number_to_currency(i.line_total_cents / 100.0)}/mo" }.join("\n")}\n\nPlatform Fee: #{number_to_currency(result.platform_fee_cents / 100.0)}/mo\nSubtotal: #{number_to_currency(result.subtotal_cents / 100.0)}/mo#{result.discount_percent > 0 ? "\nDiscount (#{result.discount_percent.to_i}%): -#{number_to_currency(result.discount_amount_cents / 100.0)}" : ""}\nMonthly Total: #{number_to_currency(result.total_monthly_cents / 100.0)}\nAnnual Contract Value: #{number_to_currency(result.annual_contract_value_cents / 100.0)}#{result.savings_amount_cents > 0 ? "\nAnnual Savings: #{number_to_currency(result.savings_amount_cents / 100.0)}" : ""}" %>"
    class="w-full rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 cursor-pointer">
    Copy Quote to Clipboard
  </button>

  <%# Save as Draft %>
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90 mb-4">Save as Draft</h3>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">Select a user to save this quote and optionally send a Stripe invoice later.</p>
    <%= form_with url: admin_enterprise_quotes_path, method: :post do |f| %>
      <div class="mb-4">
        <label for="user_id" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Customer</label>
        <select name="user_id" id="user_id" required
          class="w-full rounded-lg border border-gray-300 bg-transparent px-3 py-2 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10">
          <option value="">Select a user...</option>
          <% User.order(:email).each do |user| %>
            <option value="<%= user.id %>"><%= user.email %> (<%= user.name %>)</option>
          <% end %>
        </select>
      </div>

      <%# Pass through calculator params as hidden fields %>
      <% if params[:databases].present? %>
        <% params[:databases].to_unsafe_h.each do |idx, db| %>
          <% db.each do |key, value| %>
            <input type="hidden" name="databases[<%= idx %>][<%= key %>]" value="<%= value %>">
          <% end %>
        <% end %>
      <% end %>
      <input type="hidden" name="retention_days" value="<%= params[:retention_days] %>">
      <input type="hidden" name="regions" value="<%= params[:regions] %>">
      <input type="hidden" name="discount_percent" value="<%= params[:discount_percent] %>">

      <button type="submit" class="w-full rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 cursor-pointer">
        Save as Draft
      </button>
    <% end %>
  </div>
</div>
