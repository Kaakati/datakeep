<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Enterprise Pricing Calculator</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Build a custom quote for enterprise prospects</p>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
    <%# Left column: Form %>
    <div>
      <%= render "form" %>
    </div>

    <%# Right column: Results %>
    <div>
      <turbo-frame id="quote-results">
        <% if @result.is_a?(DataKeep::EnterpriseQuoteCalculator::Error) %>
          <div class="rounded-2xl border border-red-200 bg-red-50 dark:border-red-800 dark:bg-red-900/20 p-5">
            <p class="text-sm font-medium text-red-700 dark:text-red-400"><%= @result.message %></p>
          </div>
        <% elsif @result.is_a?(DataKeep::EnterpriseQuoteCalculator::Result) %>
          <%= render "results", result: @result %>
        <% else %>
          <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-8 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008H18v-.008zm0 2.25h.008v.008H18V13.5zM9.75 9h4.5" />
            </svg>
            <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">Add databases and submit to generate a quote</p>
          </div>
        <% end %>
      </turbo-frame>
    </div>
  </div>
</div>
