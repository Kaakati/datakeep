<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Edit Pricing Config</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Editing <strong><%= @pricing_config.key %></strong></p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
    <%= form_with(model: @pricing_config, url: admin_pricing_config_path(@pricing_config), method: :patch) do |f| %>
      <% if @pricing_config.errors.any? %>
        <div class="mb-4 rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
          <ul class="list-disc pl-5 text-sm text-red-700 dark:text-red-400">
            <% @pricing_config.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-4">
        <div>
          <label class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Key</label>
          <p class="text-sm text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 px-3 py-2 rounded-lg"><%= @pricing_config.key %></p>
        </div>

        <div>
          <%= f.label :description, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= f.text_field :description, class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" %>
        </div>

        <div>
          <label for="pricing_config_value_json" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">Value (JSON)</label>
          <textarea
            name="pricing_config[value_json]"
            id="pricing_config_value_json"
            rows="6"
            class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm font-mono text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10"
          ><%= JSON.pretty_generate(@pricing_config.value) %></textarea>
        </div>

        <div class="flex items-center gap-3">
          <%= f.submit "Update", class: "rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 cursor-pointer" %>
          <%= link_to "Cancel", admin_pricing_configs_path, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
