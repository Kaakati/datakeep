<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Users</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage all platform users</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_admin_user_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors" do %>
        <svg class="-ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New User
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 flex flex-col gap-2 px-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">All Users</h3>
      <%= form_tag admin_users_path, method: :get, class: "flex gap-2" do %>
        <input type="text" name="search" value="<%= params[:search] %>" placeholder="Search by name or email..."
               class="rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-700 placeholder-gray-400 focus:border-primary-500 focus:outline-none focus:ring-1 focus:ring-primary-500 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:placeholder-gray-500">
        <button type="submit" class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">Search</button>
      <% end %>
    </div>

    <% if @users.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">User</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Role</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Databases</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Joined</p></th>
              <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Actions</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @users.each do |user| %>
              <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                <td class="py-3 pr-4 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <div class="h-8 w-8 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center shrink-0">
                      <span class="text-xs font-semibold text-white"><%= user.name.first.upcase %></span>
                    </div>
                    <div>
                      <%= link_to user.name, admin_user_path(user), class: "text-sm font-medium text-gray-700 dark:text-white/90 hover:text-primary-600" %>
                      <p class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if user.admin? %>
                    <span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">Admin</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">User</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-gray-300"><%= user.database_configs.count %></p>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <p class="text-sm text-gray-700 dark:text-gray-300"><%= user.created_at.strftime("%b %d, %Y") %></p>
                </td>
                <td class="py-3 pl-4 whitespace-nowrap text-right">
                  <%= link_to "View", admin_user_path(user), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  <span class="text-gray-300 dark:text-gray-600 mx-1">|</span>
                  <%= link_to "Edit", edit_admin_user_path(user), class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">Showing <%= @users.count %> user<%= @users.count == 1 ? '' : 's' %></p>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">No users found.</p>
      </div>
    <% end %>
  </div>
</div>
