<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">All Backup Jobs</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Backup jobs across all users</p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <% if @backup_jobs.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Name</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Database</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">User</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Schedule</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Status</p></th>
              <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Last Run</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @backup_jobs.each do |job| %>
              <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                <td class="py-3 pr-4 whitespace-nowrap">
                  <%= link_to job.name, admin_backup_job_path(job), class: "text-sm font-medium text-gray-700 dark:text-white/90 hover:text-primary-600" %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap"><p class="text-sm text-gray-700 dark:text-gray-300"><%= job.database_config.name %></p></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <%= link_to job.user.name, admin_user_path(job.user), class: "text-sm text-primary-500 hover:text-primary-700" %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap"><p class="text-sm text-gray-700 dark:text-gray-300"><%= job.schedule_type.titleize %></p></td>
                <td class="px-4 py-3 whitespace-nowrap"><%= status_badge(job.enabled? ? "enabled" : "disabled") %></td>
                <td class="py-3 pl-4 whitespace-nowrap text-right">
                  <p class="text-sm text-gray-500 dark:text-gray-400"><%= time_ago_or_never(job.last_run_at) %></p>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">Showing <%= @backup_jobs.count %> backup job<%= @backup_jobs.count == 1 ? '' : 's' %></p>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">No backup jobs configured.</p>
      </div>
    <% end %>
  </div>
</div>
