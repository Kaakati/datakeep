<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90"><%= @database_config.name %></h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Owned by <%= link_to @database_config.user.name, admin_user_path(@database_config.user), class: "text-primary-500 hover:text-primary-700" %>
      </p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to "Back to Databases", admin_database_configs_path, class: "inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700" %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Host</p>
        <p class="mt-1 text-sm font-medium text-gray-800 dark:text-white/90"><%= @database_config.host %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Port</p>
        <p class="mt-1 text-sm font-medium text-gray-800 dark:text-white/90"><%= @database_config.port %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Database Name</p>
        <p class="mt-1 text-sm font-medium text-gray-800 dark:text-white/90"><%= @database_config.database_name %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Type</p>
        <p class="mt-1 text-sm font-medium text-gray-800 dark:text-white/90"><%= @database_config.database_type %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Health Status</p>
        <div class="mt-1"><%= status_badge(@database_config.health_status) %></div>
      </div>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Created</p>
        <p class="mt-1 text-sm font-medium text-gray-800 dark:text-white/90"><%= @database_config.created_at.strftime("%b %d, %Y") %></p>
      </div>
    </div>
  </div>

  <!-- Health Checks -->
  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
    <div class="mb-4 px-5 sm:px-6">
      <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Recent Health Checks</h3>
    </div>
    <% if @health_checks.any? %>
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Time</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Status</p></th>
              <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Response Time</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @health_checks.each do |check| %>
              <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                <td class="py-3 pr-4 whitespace-nowrap"><p class="text-sm text-gray-700 dark:text-gray-300"><%= check.created_at.strftime("%b %d, %Y %H:%M") %></p></td>
                <td class="px-4 py-3 whitespace-nowrap"><%= status_badge(check.status) %></td>
                <td class="py-3 pl-4 whitespace-nowrap text-right"><p class="text-sm text-gray-700 dark:text-gray-300"><%= check.response_time_ms ? "#{check.response_time_ms}ms" : "N/A" %></p></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6"></div>
    <% else %>
      <div class="px-5 py-8 text-center sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400">No health checks recorded.</p>
      </div>
    <% end %>
  </div>
</div>
