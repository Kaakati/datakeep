<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Subscription Plans</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage self-service subscription tiers and Stripe pricing</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_admin_subscription_plan_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors" do %>
        <svg class="-ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New Plan
      <% end %>
    </div>
  </div>

  <% if @plans.any? %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Plan</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Tier Key</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Monthly</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Annual</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Stripe</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Status</p></th>
              <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Actions</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @plans.each do |plan| %>
              <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                <td class="py-3 pr-4 whitespace-nowrap">
                  <div>
                    <%= link_to plan.name, admin_subscription_plan_path(plan), class: "text-sm font-medium text-gray-700 dark:text-white/90 hover:text-primary-600" %>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Order: <%= plan.sort_order %></p>
                  </div>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <code class="text-xs text-gray-600 dark:text-gray-300 bg-gray-50 dark:bg-gray-800 px-2 py-1 rounded"><%= plan.tier_key %></code>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-300">$<%= "%.2f" % (plan.monthly_price_cents / 100.0) %></span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-300">$<%= "%.2f" % (plan.annual_price_cents / 100.0) %>/yr</span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if plan.stripe_synced? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">Synced</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">Not synced</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if plan.enabled? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">Enabled</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">Disabled</span>
                  <% end %>
                </td>
                <td class="py-3 pl-4 whitespace-nowrap text-right space-x-1">
                  <%= link_to "View", admin_subscription_plan_path(plan), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  <span class="text-gray-300 dark:text-gray-600">|</span>
                  <%= link_to "Edit", edit_admin_subscription_plan_path(plan), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  <span class="text-gray-300 dark:text-gray-600">|</span>
                  <%= button_to plan.enabled? ? "Disable" : "Enable",
                    toggle_admin_subscription_plan_path(plan),
                    method: :patch,
                    class: "text-sm #{plan.enabled? ? 'text-amber-500 hover:text-amber-700' : 'text-green-500 hover:text-green-700'} inline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= @plans.count %> plan<%= @plans.count == 1 ? '' : 's' %></p>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center dark:border-gray-800 dark:bg-white/[0.03]">
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">No subscription plans configured yet.</p>
      <%= link_to "Seed from defaults", seed_admin_subscription_plans_path, method: :post,
        class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors",
        data: { turbo_method: :post } %>
    </div>
  <% end %>
</div>
