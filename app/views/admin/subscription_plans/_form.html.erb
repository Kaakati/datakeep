<%# Shared form for new/edit subscription plan %>
<%= form_with(model: [:admin, plan], class: "space-y-5") do |f| %>
  <% if plan.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <ul class="list-disc pl-5 text-sm text-red-700 dark:text-red-400">
        <% plan.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <%# Tier Key %>
    <div>
      <%= f.label :tier_key, "Tier Key", class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <% if plan.persisted? %>
        <p class="text-sm text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 px-3 py-2.5 rounded-lg"><%= plan.tier_key %></p>
      <% else %>
        <%= f.select :tier_key,
          options_for_select(SubscriptionPlan::VALID_TIER_KEYS.map { |k| [k.titleize, k] }, plan.tier_key),
          { include_blank: "Select tier..." },
          class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" %>
      <% end %>
    </div>

    <%# Name %>
    <div>
      <%= f.label :name, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.text_field :name,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        placeholder: "e.g. Professional" %>
    </div>

    <%# Monthly Price %>
    <div>
      <%= f.label :monthly_price_cents, "Monthly Price (cents)", class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <div class="relative">
        <span class="absolute left-3 top-2.5 text-sm text-gray-400">$</span>
        <%= f.number_field :monthly_price_cents,
          class: "w-full rounded-lg border border-gray-300 bg-transparent pl-7 pr-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
          min: 0, step: 1 %>
      </div>
      <p class="mt-0.5 text-xs text-gray-400">In cents — e.g. 9900 = $99.00</p>
    </div>

    <%# Annual Price %>
    <div>
      <%= f.label :annual_price_cents, "Annual Price (cents)", class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <div class="relative">
        <span class="absolute left-3 top-2.5 text-sm text-gray-400">$</span>
        <%= f.number_field :annual_price_cents,
          class: "w-full rounded-lg border border-gray-300 bg-transparent pl-7 pr-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
          min: 0, step: 1 %>
      </div>
      <p class="mt-0.5 text-xs text-gray-400">In cents — e.g. 95040 = $950.40/year</p>
    </div>

    <%# Sort Order %>
    <div>
      <%= f.label :sort_order, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.number_field :sort_order,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        min: 0 %>
    </div>

    <%# Enabled %>
    <div class="flex items-center gap-3 pt-6">
      <%= f.check_box :enabled,
        class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800" %>
      <%= f.label :enabled, "Enabled (visible to users on billing page)", class: "text-sm font-medium text-gray-700 dark:text-gray-300" %>
    </div>
  </div>

  <%# Limits JSON %>
  <div>
    <label for="subscription_plan_limits_json" class="mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300">
      Limits Override (JSON)
    </label>
    <p class="mb-2 text-xs text-gray-400">
      Override default tier limits. Omitted keys fall back to built-in defaults.
      Keys: max_database_configs, max_backup_jobs, max_storage_backends, max_notification_channels,
      max_retention_days, max_storage_gb, max_zones, max_jobs_per_month, min_backup_interval, s3_allowed
    </p>
    <textarea
      name="subscription_plan[limits_json]"
      id="subscription_plan_limits_json"
      rows="8"
      class="w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm font-mono text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10"
    ><%= plan.limits.present? ? JSON.pretty_generate(plan.limits) : "{\n}" %></textarea>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit plan.persisted? ? "Update Plan" : "Create Plan",
      class: "rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_subscription_plans_path,
      class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300" %>
  </div>
<% end %>
