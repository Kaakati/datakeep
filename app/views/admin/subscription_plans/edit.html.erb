<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Edit <%= @plan.name %> Plan</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Tier: <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded"><%= @plan.tier_key %></code>
    </p>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5 sm:p-6">
    <%= render "form", plan: @plan %>
  </div>
</div>
