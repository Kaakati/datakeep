<div class="space-y-6">
  <!-- Header -->
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Admin Dashboard</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">System-wide overview of DataKeep</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_admin_user_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors" do %>
        <svg class="-ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New User
      <% end %>
    </div>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <!-- Total Users -->
    <article class="flex items-center gap-5 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-purple-50 text-purple-500">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
      </div>
      <div>
        <p class="text-gray-500 text-sm dark:text-gray-400">Total Users</p>
        <span class="text-2xl font-semibold text-gray-800 dark:text-white/90"><%= @stats[:total_users] %></span>
      </div>
    </article>

    <!-- Databases -->
    <article class="flex items-center gap-5 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-primary-50 text-primary-500">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125" />
        </svg>
      </div>
      <div>
        <p class="text-gray-500 text-sm dark:text-gray-400">Databases</p>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-semibold text-gray-800 dark:text-white/90"><%= @stats[:total_databases] %></span>
          <span class="inline-flex items-center justify-center gap-1 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-600"><%= @stats[:healthy_databases] %> healthy</span>
        </div>
      </div>
    </article>

    <!-- Backups -->
    <article class="flex items-center gap-5 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-green-50 text-green-500">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m8.25 3v6.75m0 0l-3-3m3 3l3-3M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
        </svg>
      </div>
      <div>
        <p class="text-gray-500 text-sm dark:text-gray-400">Backups</p>
        <div class="flex items-baseline gap-2">
          <span class="text-2xl font-semibold text-gray-800 dark:text-white/90"><%= @stats[:total_backups] %></span>
          <span class="inline-flex items-center justify-center gap-1 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-600"><%= @stats[:successful_backups] %> successful</span>
        </div>
      </div>
    </article>

    <!-- Storage Used -->
    <article class="flex items-center gap-5 rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] p-5">
      <div class="inline-flex h-16 w-16 items-center justify-center rounded-xl bg-orange-50 text-orange-500">
        <svg class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 14.25h13.5m-13.5 0a3 3 0 01-3-3m3 3a3 3 0 100 6h13.5a3 3 0 100-6m-16.5-3a3 3 0 013-3h13.5a3 3 0 013 3m-19.5 0a4.5 4.5 0 01.9-2.7L5.737 5.1a3.375 3.375 0 012.7-1.35h7.126c1.062 0 2.062.5 2.7 1.35l2.587 3.45a4.5 4.5 0 01.9 2.7m0 0a3 3 0 01-3 3m0 3h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008zm-3 6h.008v.008h-.008v-.008zm0-6h.008v.008h-.008v-.008z" />
        </svg>
      </div>
      <div>
        <p class="text-gray-500 text-sm dark:text-gray-400">Storage Used</p>
        <span class="text-2xl font-semibold text-gray-800 dark:text-white/90"><%= format_bytes(@stats[:total_storage]) %></span>
      </div>
    </article>
  </div>

  <!-- Two Column Layout -->
  <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
    <!-- Recent Backups -->
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="mb-4 flex items-center justify-between px-5 sm:px-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Recent Backups</h3>
        <%= link_to "View All", admin_backups_path, class: "text-sm font-medium text-primary-500 hover:text-primary-700" %>
      </div>

      <% if @recent_backups.any? %>
        <div class="overflow-x-auto px-5 sm:px-6">
          <table class="min-w-full">
            <thead class="border-y border-gray-100 dark:border-gray-800">
              <tr>
                <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Database</p></th>
                <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">User</p></th>
                <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Status</p></th>
                <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Time</p></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
              <% @recent_backups.each do |backup| %>
                <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                  <td class="py-3 pr-4 whitespace-nowrap">
                    <p class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= backup.database_name %></p>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <p class="text-sm text-gray-700 dark:text-gray-300"><%= backup.backup_job&.user&.name || "N/A" %></p>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <%= status_badge(backup.status) %>
                  </td>
                  <td class="py-3 pl-4 whitespace-nowrap text-right">
                    <p class="text-sm text-gray-500 dark:text-gray-400"><%= time_ago_or_never(backup.created_at) %></p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
          <p class="text-sm text-gray-500 dark:text-gray-400">Showing <%= @recent_backups.count %> most recent backups</p>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <p class="text-sm text-gray-500 dark:text-gray-400">No backups yet.</p>
        </div>
      <% end %>
    </div>

    <!-- Recent Signups -->
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="mb-4 flex items-center justify-between px-5 sm:px-6">
        <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Recent Signups</h3>
        <%= link_to "View All", admin_users_path, class: "text-sm font-medium text-primary-500 hover:text-primary-700" %>
      </div>

      <% if @recent_users.any? %>
        <div class="overflow-x-auto px-5 sm:px-6">
          <table class="min-w-full">
            <thead class="border-y border-gray-100 dark:border-gray-800">
              <tr>
                <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">User</p></th>
                <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Role</p></th>
                <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Joined</p></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
              <% @recent_users.each do |user| %>
                <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                  <td class="py-3 pr-4 whitespace-nowrap">
                    <div class="flex items-center gap-3">
                      <div class="h-8 w-8 rounded-full bg-gradient-to-br from-primary-400 to-primary-600 flex items-center justify-center shrink-0">
                        <span class="text-xs font-semibold text-white"><%= user.name.first.upcase %></span>
                      </div>
                      <div>
                        <%= link_to user.name, admin_user_path(user), class: "text-sm font-medium text-gray-700 dark:text-white/90 hover:text-primary-600" %>
                        <p class="text-xs text-gray-500 dark:text-gray-400"><%= user.email %></p>
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <% if user.admin? %>
                      <span class="inline-flex items-center rounded-full bg-purple-50 px-2.5 py-0.5 text-xs font-medium text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">Admin</span>
                    <% else %>
                      <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">User</span>
                    <% end %>
                  </td>
                  <td class="py-3 pl-4 whitespace-nowrap text-right">
                    <p class="text-sm text-gray-500 dark:text-gray-400"><%= time_ago_or_never(user.created_at) %></p>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
          <p class="text-sm text-gray-500 dark:text-gray-400">Showing <%= @recent_users.count %> most recent users</p>
        </div>
      <% else %>
        <div class="px-5 py-12 text-center sm:px-6">
          <p class="text-sm text-gray-500 dark:text-gray-400">No users yet.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
