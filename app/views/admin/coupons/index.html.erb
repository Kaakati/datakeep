<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90">Coupons</h1>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Manage promotional discount codes for self-service plans</p>
    </div>
    <div class="mt-4 sm:mt-0">
      <%= link_to new_admin_coupon_path, class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors" do %>
        <svg class="-ml-0.5 mr-2 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        New Coupon
      <% end %>
    </div>
  </div>

  <% if @coupons.any? %>
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] pt-4">
      <div class="overflow-x-auto px-5 sm:px-6">
        <table class="min-w-full">
          <thead class="border-y border-gray-100 dark:border-gray-800">
            <tr>
              <th class="py-3 pr-4 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Code</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Discount</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Duration</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Redemptions</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Expires</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Stripe</p></th>
              <th class="px-4 py-3 text-left font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Status</p></th>
              <th class="py-3 pl-4 text-right font-normal whitespace-nowrap"><p class="text-sm text-gray-500 dark:text-gray-400">Actions</p></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            <% @coupons.each do |coupon| %>
              <tr class="hover:bg-gray-50/50 dark:hover:bg-white/[0.02]">
                <td class="py-3 pr-4 whitespace-nowrap">
                  <%= link_to admin_coupon_path(coupon), class: "text-sm font-medium text-gray-700 dark:text-white/90 hover:text-primary-600" do %>
                    <code class="bg-gray-50 dark:bg-gray-800 px-2 py-1 rounded text-xs"><%= coupon.code %></code>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= coupon.discount_display %></span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-sm text-gray-600 dark:text-gray-400">
                    <%= coupon.duration.humanize %>
                    <%= "(#{coupon.duration_in_months}mo)" if coupon.repeating? %>
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="text-sm text-gray-600 dark:text-gray-400">
                    <%= coupon.redemptions_count %><%= " / #{coupon.max_redemptions}" if coupon.max_redemptions.present? %>
                  </span>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if coupon.expired? %>
                    <span class="text-xs text-red-500">Expired</span>
                  <% elsif coupon.expires_at.present? %>
                    <span class="text-sm text-gray-600 dark:text-gray-400"><%= coupon.expires_at.strftime("%b %d, %Y") %></span>
                  <% else %>
                    <span class="text-xs text-gray-400">Never</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if coupon.stripe_synced? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">Synced</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">Not synced</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if coupon.active? && !coupon.expired? && !coupon.max_redemptions_reached? %>
                    <span class="inline-flex items-center rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/30 dark:text-green-400">Active</span>
                  <% elsif coupon.active? %>
                    <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">Exhausted</span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-400">Inactive</span>
                  <% end %>
                </td>
                <td class="py-3 pl-4 whitespace-nowrap text-right space-x-1">
                  <%= link_to "View", admin_coupon_path(coupon), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  <span class="text-gray-300 dark:text-gray-600">|</span>
                  <%= link_to "Edit", edit_admin_coupon_path(coupon), class: "text-sm text-primary-500 hover:text-primary-700" %>
                  <span class="text-gray-300 dark:text-gray-600">|</span>
                  <%= button_to coupon.active? ? "Deactivate" : "Activate",
                    toggle_admin_coupon_path(coupon),
                    method: :patch,
                    class: "text-sm #{coupon.active? ? 'text-amber-500 hover:text-amber-700' : 'text-green-500 hover:text-green-700'} inline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="border-t border-gray-100 dark:border-gray-800 px-5 py-3 sm:px-6">
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= @coupons.count %> coupon<%= @coupons.count == 1 ? '' : 's' %></p>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-gray-200 bg-white p-12 text-center dark:border-gray-800 dark:bg-white/[0.03]">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 6v.75m0 3v.75m0 3v.75m0 3V18m-9-5.25h5.25M7.5 15h3M3.375 5.25c-.621 0-1.125.504-1.125 1.125v3.026a2.999 2.999 0 010 5.198v3.026c0 .621.504 1.125 1.125 1.125h17.25c.621 0 1.125-.504 1.125-1.125v-3.026a2.999 2.999 0 010-5.198V6.375c0-.621-.504-1.125-1.125-1.125H3.375z" />
      </svg>
      <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">No coupons yet. Create one to offer discounts on subscriptions.</p>
      <div class="mt-4">
        <%= link_to "Create First Coupon", new_admin_coupon_path,
          class: "inline-flex items-center rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 transition-colors" %>
      </div>
    </div>
  <% end %>
</div>
