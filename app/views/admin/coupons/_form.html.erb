<%# Shared form for new/edit coupon %>
<%= form_with(model: [:admin, coupon], class: "space-y-5", data: { controller: "coupon-form" }) do |f| %>
  <% if coupon.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <ul class="list-disc pl-5 text-sm text-red-700 dark:text-red-400">
        <% coupon.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-5 sm:grid-cols-2">
    <%# Code %>
    <div>
      <%= f.label :code, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <% if coupon.persisted? %>
        <p class="text-sm text-gray-600 dark:text-gray-400 bg-gray-50 dark:bg-gray-800 px-3 py-2.5 rounded-lg font-mono"><%= coupon.code %></p>
      <% else %>
        <%= f.text_field :code,
          class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm font-mono uppercase text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
          placeholder: "e.g. LAUNCH50" %>
        <p class="mt-0.5 text-xs text-gray-400">Uppercase letters, numbers, hyphens, underscores only</p>
      <% end %>
    </div>

    <%# Discount Type %>
    <div>
      <%= f.label :discount_type, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.select :discount_type,
        options_for_select([["Percent Off", "percent_off"], ["Amount Off (cents)", "amount_off"]], coupon.discount_type),
        {},
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        data: { action: "change->coupon-form#toggleDiscountType", coupon_form_target: "discountType" } %>
    </div>

    <%# Discount Value %>
    <div>
      <%= f.label :discount_value, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.number_field :discount_value,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        min: 1 %>
      <p class="mt-0.5 text-xs text-gray-400" data-coupon-form-target="valueHint">
        <% if coupon.percent_off? || coupon.discount_type.nil? %>
          Percentage (1-100)
        <% else %>
          Amount in cents (e.g. 500 = $5.00)
        <% end %>
      </p>
    </div>

    <%# Currency (shown only for amount_off) %>
    <div data-coupon-form-target="currencyField" class="<%= 'hidden' unless coupon.amount_off? %>">
      <%= f.label :currency, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.select :currency,
        options_for_select([["USD", "usd"], ["EUR", "eur"], ["GBP", "gbp"]], coupon.currency),
        {},
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10" %>
    </div>

    <%# Duration %>
    <div>
      <%= f.label :duration, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.select :duration,
        options_for_select([["Once", "once"], ["Repeating", "repeating"], ["Forever", "forever"]], coupon.duration),
        {},
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        data: { action: "change->coupon-form#toggleDuration", coupon_form_target: "durationSelect" } %>
    </div>

    <%# Duration in Months (shown only for repeating) %>
    <div data-coupon-form-target="durationMonthsField" class="<%= 'hidden' unless coupon.repeating? %>">
      <%= f.label :duration_in_months, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.number_field :duration_in_months,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        min: 1, placeholder: "e.g. 3" %>
    </div>

    <%# Max Redemptions %>
    <div>
      <%= f.label :max_redemptions, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.number_field :max_redemptions,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        min: 1, placeholder: "Leave blank for unlimited" %>
    </div>

    <%# Expires At %>
    <div>
      <%= f.label :expires_at, class: "mb-1 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= f.datetime_local_field :expires_at,
        class: "w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 dark:border-gray-700 dark:text-white/90 focus:border-primary-300 focus:ring focus:ring-primary-500/10",
        value: coupon.expires_at&.strftime("%Y-%m-%dT%H:%M") %>
      <p class="mt-0.5 text-xs text-gray-400">Leave blank for no expiration</p>
    </div>
  </div>

  <%# Applicable Plans %>
  <div>
    <label class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Applicable Plans</label>
    <div class="flex flex-wrap gap-3">
      <% plans = [["All Plans", "all"], ["Starter", "starter"], ["Professional", "professional"], ["Business", "business"]] %>
      <% current_plans = coupon.applicable_plans || "all" %>
      <% plans.each do |label, value| %>
        <label class="inline-flex items-center gap-2 cursor-pointer">
          <input type="radio" name="coupon[applicable_plans]" value="<%= value %>"
            <%= 'checked' if current_plans == value %>
            class="h-4 w-4 border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800">
          <span class="text-sm text-gray-700 dark:text-gray-300"><%= label %></span>
        </label>
      <% end %>
    </div>
    <p class="mt-1 text-xs text-gray-400">Which plans this coupon can be applied to</p>
  </div>

  <%# Active Toggle %>
  <div class="flex items-center gap-3">
    <%= f.check_box :active,
      class: "h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-500 dark:border-gray-600 dark:bg-gray-800" %>
    <%= f.label :active, "Active (available for checkout)", class: "text-sm font-medium text-gray-700 dark:text-gray-300" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit coupon.persisted? ? "Update Coupon" : "Create Coupon",
      class: "rounded-lg bg-primary-500 px-4 py-2.5 text-sm font-medium text-white hover:bg-primary-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_coupons_path,
      class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300" %>
  </div>
<% end %>
