<nav data-controller="landing-nav" data-landing-nav-target="navbar"
     class="fixed top-0 left-0 right-0 z-50 bg-transparent transition-all duration-300">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <%# Logo %>
      <a href="/" class="flex items-center gap-2">
        <%= image_tag "logo.svg", class: "h-8 w-8", alt: "DataKeep" %>
        <span class="text-xl font-bold text-gray-900 dark:text-white">DataKeep</span>
      </a>

      <%# Desktop nav %>
      <div class="hidden items-center gap-6 md:flex">
        <a href="#features" data-action="click->landing-nav#scrollTo" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition">Features</a>
        <a href="#pricing" data-action="click->landing-nav#scrollTo" class="text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition">Pricing</a>
        <%= link_to "Terms", terms_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition" %>
        <%= link_to "Privacy", privacy_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition" %>
      </div>

      <%# Desktop CTA %>
      <div class="hidden items-center gap-3 md:flex">
        <%= link_to "Sign In", login_path, class: "text-sm font-medium text-gray-600 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white transition" %>
        <%= link_to "Get Started", signup_path, class: "rounded-lg bg-primary-500 px-4 py-2 text-sm font-medium text-white hover:bg-primary-600 transition" %>
      </div>

      <%# Mobile hamburger %>
      <button data-action="click->landing-nav#toggleMenu" class="md:hidden rounded-lg p-2 text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800" aria-label="Toggle menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
      </button>
    </div>

    <%# Mobile menu %>
    <div data-landing-nav-target="mobileMenu" class="hidden md:hidden border-t border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 rounded-b-xl shadow-lg -mx-4 px-4 pb-4 pt-2">
      <div class="flex flex-col gap-2">
        <a href="#features" data-action="click->landing-nav#scrollTo" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">Features</a>
        <a href="#pricing" data-action="click->landing-nav#scrollTo" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">Pricing</a>
        <%= link_to "Terms", terms_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800" %>
        <%= link_to "Privacy", privacy_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800" %>
        <hr class="border-gray-200 dark:border-gray-700">
        <%= link_to "Sign In", login_path, class: "rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800" %>
        <%= link_to "Get Started Free", signup_path, class: "rounded-lg bg-primary-500 px-3 py-2 text-sm font-medium text-white text-center hover:bg-primary-600 transition" %>
      </div>
    </div>
  </div>
</nav>
