<% content_for(:title, "DataKeep - Automated Database Backup & Monitoring") %>
<% content_for(:custom_footer, true) %>

<%= render "shared/landing_nav" %>

<%# ── Hero ──────────────────────────────────────────────────────── %>
<section id="top" class="relative overflow-hidden pt-44 pb-20 sm:pt-56 sm:pb-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-6xl leading-[1.1]">
      Automate Your
      <span class="bg-gradient-to-r from-primary-500 to-blue-600 bg-clip-text text-transparent">Database Backups</span>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-400">
      Schedule backups, sync databases, monitor health, and restore with confidence.
      DataKeep protects your data so you can focus on building.
    </p>
    <div class="mt-10 flex items-center justify-center gap-4">
      <%= link_to "Get Started Free", signup_path,
        class: "rounded-lg bg-primary-500 px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-primary-600 transition" %>
      <a href="#pricing" data-controller="landing-nav" data-action="click->landing-nav#scrollTo"
        class="rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
        View Pricing
      </a>
    </div>

    <%# Database illustration %>
    <div class="mt-14 flex justify-center">
      <div class="relative">
        <div class="absolute inset-0 rounded-full bg-primary-500/10 blur-3xl"></div>
        <%= image_tag "logo.svg", class: "relative h-24 w-24", alt: "DataKeep" %>
      </div>
    </div>
  </div>
</section>

<%# ── Features ──────────────────────────────────────────────────── %>
<section id="features" class="scroll-mt-20 py-20 sm:py-24 bg-gray-50 dark:bg-gray-800/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">Everything You Need to Protect Your Data</h2>
      <p class="mt-5 text-lg text-gray-600 dark:text-gray-400">Enterprise-grade backup infrastructure, simple enough for a solo developer.</p>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      <%# Feature 1 — Automated Backups %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-500/10">
          <svg class="h-5 w-5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Automated Backups</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Schedule backups with cron expressions. From every 15 minutes to weekly &mdash; you set the cadence, we handle execution.</p>
      </div>

      <%# Feature 2 — Multi-Engine Support %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-500/10">
          <svg class="h-5 w-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Multi-Engine Support</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">PostgreSQL today, with MySQL, MongoDB, MSSQL, and SQLite on the roadmap. One platform for all your databases.</p>
      </div>

      <%# Feature 3 — AES-256-GCM Encryption %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-yellow-500/10">
          <svg class="h-5 w-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">AES-256-GCM Encryption</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Every backup encrypted at rest with a unique per-job key. Server-managed keys mean zero hassle, maximum security.</p>
      </div>

      <%# Feature 4 — Multi-Cloud Storage %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-500/10">
          <svg class="h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Multi-Cloud Storage</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Store backups locally or on S3-compatible storage. Write to multiple backends simultaneously for redundancy.</p>
      </div>

      <%# Feature 5 — Real-Time Sync %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-500/10">
          <svg class="h-5 w-5 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Real-Time Sync</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Replicate from one source to many targets on a schedule. Keep staging, analytics, and DR copies in sync automatically.</p>
      </div>

      <%# Feature 6 — Smart Notifications %>
      <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-white/[0.03]">
        <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-red-500/10">
          <svg class="h-5 w-5 text-red-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
          </svg>
        </div>
        <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">Smart Notifications</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Get alerted via Slack, Discord, Telegram, email, or custom webhooks. Know instantly when something needs attention.</p>
      </div>
    </div>
  </div>
</section>

<%# ── How It Works ──────────────────────────────────────────────── %>
<section id="how-it-works" class="scroll-mt-20 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">Up and Running in Minutes</h2>
      <p class="mt-5 text-lg text-gray-600 dark:text-gray-400">Three steps to worry-free database backups.</p>
    </div>

    <div class="mt-14 grid gap-12 sm:grid-cols-3">
      <%# Step 1 %>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-500 text-white text-lg font-bold">1</div>
        <h3 class="mt-5 text-lg font-semibold text-gray-900 dark:text-white">Connect</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Add your database connection details. We test connectivity before saving &mdash; no guesswork.</p>
      </div>

      <%# Step 2 %>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-500 text-white text-lg font-bold">2</div>
        <h3 class="mt-5 text-lg font-semibold text-gray-900 dark:text-white">Configure</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Set your backup schedule, choose storage backends, enable encryption, and configure notifications.</p>
      </div>

      <%# Step 3 %>
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-primary-500 text-white text-lg font-bold">3</div>
        <h3 class="mt-5 text-lg font-semibold text-gray-900 dark:text-white">Relax</h3>
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">DataKeep handles execution, retention, and monitoring. Restore any backup with one click when you need it.</p>
      </div>
    </div>
  </div>
</section>

<%# ── Pricing ───────────────────────────────────────────────────── %>
<% tiers = PlanTierLimits::TIER_DEFINITIONS %>
<section id="pricing" class="scroll-mt-20 py-20 sm:py-24 bg-gray-50 dark:bg-gray-800/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">Simple, Transparent Pricing</h2>
      <p class="mt-5 text-lg text-gray-600 dark:text-gray-400">Start free. Scale as you grow. No surprises.</p>
    </div>

    <div class="mt-8" data-controller="pricing-toggle">
      <%# Toggle %>
      <div class="flex justify-center">
        <div class="inline-flex items-center rounded-lg bg-gray-100 p-0.5 dark:bg-gray-800">
          <button type="button"
            data-action="click->pricing-toggle#showMonthly"
            data-pricing-toggle-target="monthlyBtn"
            class="rounded-md px-4 py-2 text-sm font-medium transition bg-white shadow-sm dark:bg-gray-700">
            Monthly
          </button>
          <button type="button"
            data-action="click->pricing-toggle#showAnnual"
            data-pricing-toggle-target="annualBtn"
            class="rounded-md px-4 py-2 text-sm font-medium transition text-gray-500">
            Annual
          </button>
        </div>
      </div>

      <%# Tier Cards %>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <% [:free, :starter, :professional, :business].each do |tier_key| %>
          <% tier = tiers[tier_key] %>
          <% recommended = (tier_key == :professional) %>
          <div class="relative flex flex-col rounded-2xl border p-6
            <%= recommended ? 'border-primary-300 dark:border-primary-700 shadow-lg ring-1 ring-primary-200 dark:ring-primary-800' : 'border-gray-200 dark:border-gray-800' %>
            bg-white dark:bg-white/[0.03]">

            <% if recommended %>
              <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                <span class="inline-flex items-center rounded-full bg-primary-500 px-3 py-0.5 text-xs font-semibold text-white">Most Popular</span>
              </div>
            <% end %>

            <div class="mb-4">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white"><%= tier[:label] %></h3>

              <div data-pricing-toggle-target="monthlyPrice" class="mt-2">
                <% if tier[:monthly_price_cents] == 0 %>
                  <span class="text-3xl font-bold text-gray-900 dark:text-white">Free</span>
                <% else %>
                  <span class="text-3xl font-bold text-gray-900 dark:text-white">$<%= tier[:monthly_price_cents] / 100 %></span>
                  <span class="text-sm text-gray-500 dark:text-gray-400">/month</span>
                <% end %>
              </div>

              <div data-pricing-toggle-target="annualPrice" class="mt-2 hidden">
                <% if tier[:annual_price_cents] == 0 %>
                  <span class="text-3xl font-bold text-gray-900 dark:text-white">Free</span>
                <% else %>
                  <span class="text-3xl font-bold text-gray-900 dark:text-white">$<%= tier[:annual_price_cents] / 100 / 12 %></span>
                  <span class="text-sm text-gray-500 dark:text-gray-400">/month</span>
                  <% savings = ((1.0 - tier[:annual_price_cents].to_f / (tier[:monthly_price_cents] * 12)) * 100).round %>
                  <p class="text-xs text-green-600 dark:text-green-400 mt-0.5">Save <%= savings %>%</p>
                <% end %>
              </div>
            </div>

            <ul class="mb-6 space-y-2.5 flex-1">
              <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <%= tier[:max_database_configs] %> database<%= tier[:max_database_configs] == 1 ? '' : 's' %>
              </li>
              <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <%= tier[:max_backup_jobs] ? "#{tier[:max_backup_jobs]} backup job#{tier[:max_backup_jobs] == 1 ? '' : 's'}" : "Unlimited backup jobs" %>
              </li>
              <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <%= tier[:max_retention_days] %>-day retention
              </li>
              <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <%= tier[:max_storage_gb] %> GB storage
              </li>
              <% if tier[:s3_allowed] %>
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  S3 cloud storage
                </li>
              <% end %>
              <% if tier[:max_sync_jobs] && tier[:max_sync_jobs] > 0 %>
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  <%= tier[:max_sync_jobs] %> sync job<%= tier[:max_sync_jobs] == 1 ? '' : 's' %>
                </li>
              <% elsif tier[:max_sync_jobs].nil? %>
                <li class="flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                  <svg class="h-4 w-4 text-green-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                  Unlimited sync jobs
                </li>
              <% end %>
            </ul>

            <div class="mt-auto">
              <%= link_to tier_key == :free ? "Get Started Free" : "Get Started",
                signup_path,
                class: "block w-full rounded-lg px-4 py-2.5 text-center text-sm font-medium transition #{recommended ? 'bg-primary-500 text-white hover:bg-primary-600' : 'border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700'}" %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Enterprise CTA %>
      <div class="mt-8 rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Enterprise</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">Custom pricing for large-scale deployments with dedicated support, SLAs, and VPN connectivity.</p>
          </div>
          <a href="mailto:support@datakeep.io" class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700">
            Contact Sales
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%# ── Security ──────────────────────────────────────────────────── %>
<section id="security" class="scroll-mt-20 py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">Built for Security</h2>
      <p class="mt-5 text-lg text-gray-600 dark:text-gray-400">Your data protection is our top priority.</p>
    </div>

    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-yellow-500/10">
          <svg class="h-6 w-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold text-gray-900 dark:text-white">AES-256-GCM</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Military-grade encryption for all backup data at rest</p>
      </div>

      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
          <svg class="h-6 w-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold text-gray-900 dark:text-white">Encrypted Credentials</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Database credentials encrypted with Active Record Encryption</p>
      </div>

      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-blue-500/10">
          <svg class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold text-gray-900 dark:text-white">Audit Logging</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Complete audit trail of every action for compliance</p>
      </div>

      <div class="text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-purple-500/10">
          <svg class="h-6 w-6 text-purple-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
        </div>
        <h3 class="mt-3 font-semibold text-gray-900 dark:text-white">VPN Tunneling</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Connect to private databases through OpenVPN or IPSec tunnels</p>
      </div>
    </div>
  </div>
</section>

