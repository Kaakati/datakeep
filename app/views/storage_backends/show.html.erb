<div class="space-y-6">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-800 dark:text-white/90"><%= @storage_backend.name %></h1>
        <% if @storage_backend.is_default? %>
          <span class="inline-flex items-center rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
            Default
          </span>
        <% end %>
      </div>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <% if @storage_backend.is_a?(StorageBackends::S3Storage) %>
          S3 Storage
        <% else %>
          Local Storage
        <% end %>
      </p>
    </div>
    <div class="mt-4 flex space-x-3 sm:mt-0">
      <%= button_to test_connection_storage_backend_path(@storage_backend), method: :post, class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 01-9.201 2.466l-.312-.311h2.433a.75.75 0 000-1.5H3.989a.75.75 0 00-.75.75v4.242a.75.75 0 001.5 0v-2.43l.31.31a7 7 0 0011.712-3.138.75.75 0 00-1.449-.39zm1.23-3.723a.75.75 0 00.219-.53V2.929a.75.75 0 00-1.5 0V5.36l-.31-.31A7 7 0 003.239 8.188a.75.75 0 101.448.389A5.5 5.5 0 0113.89 6.11l.311.31h-2.432a.75.75 0 000 1.5h4.243a.75.75 0 00.53-.219z" clip-rule="evenodd" />
        </svg>
        Test Connection
      <% end %>
      <%= link_to edit_storage_backend_path(@storage_backend), class: "inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor">
          <path d="M2.695 14.763l-1.262 3.154a.5.5 0 00.65.65l3.155-1.262a4 4 0 001.343-.885L17.5 5.5a2.121 2.121 0 00-3-3L3.58 13.42a4 4 0 00-.885 1.343z" />
        </svg>
        Edit
      <% end %>
      <%= button_to storage_backend_path(@storage_backend), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this storage backend? Existing backups stored here may become inaccessible." }, class: "inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 006 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 10.23 1.482l.149-.022.841 10.518A2.75 2.75 0 007.596 19h4.807a2.75 2.75 0 002.742-2.53l.841-10.519.149.023a.75.75 0 00.23-1.482A41.03 41.03 0 0014 4.193V3.75A2.75 2.75 0 0011.25 1h-2.5zM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4zM8.58 7.72a.75.75 0 00-1.5.06l.3 7.5a.75.75 0 101.5-.06l-.3-7.5zm4.34.06a.75.75 0 10-1.5-.06l-.3 7.5a.75.75 0 101.5.06l.3-7.5z" clip-rule="evenodd" />
        </svg>
        Delete
      <% end %>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Storage Details</h3>
    </div>
    <div class="border-t border-gray-200 dark:border-gray-800">
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Type</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
            <% if @storage_backend.is_a?(StorageBackends::S3Storage) %>
              <span class="inline-flex items-center">
                <svg class="mr-1.5 h-5 w-5 text-orange-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                </svg>
                Amazon S3 / S3-Compatible
              </span>
            <% else %>
              <span class="inline-flex items-center">
                <svg class="mr-1.5 h-5 w-5 text-blue-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
                </svg>
                Local Storage
              </span>
            <% end %>
          </dd>
        </div>
        <% if @storage_backend.is_a?(StorageBackends::S3Storage) %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Bucket</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @storage_backend.config&.dig(:bucket) %></dd>
          </div>
          <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Region</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @storage_backend.config&.dig(:region) %></dd>
          </div>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Prefix</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @storage_backend.config&.dig(:prefix).presence || "(none)" %></dd>
          </div>
          <% if @storage_backend.config&.dig(:endpoint).present? %>
            <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Custom Endpoint</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @storage_backend.config&.dig(:endpoint) %></dd>
            </div>
          <% end %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Access Key ID</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono">
              <% access_key = @storage_backend.config&.dig(:access_key_id) %>
              <%= access_key.present? ? access_key[0..3] + "..." + access_key[-4..-1] : "(not set)" %>
            </dd>
          </div>
        <% else %>
          <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Path</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-mono"><%= @storage_backend.config&.dig(:path) %></dd>
          </div>
        <% end %>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= @storage_backend.created_at.strftime("%B %d, %Y at %H:%M") %></dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03] overflow-hidden">
    <div class="px-4 py-5 sm:px-6">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Backup Jobs Using This Storage</h3>
        <%= link_to new_backup_job_path(storage_backend_id: @storage_backend.id), class: "text-sm font-medium text-primary-500 hover:text-indigo-500" do %>
          Create Backup Job
        <% end %>
      </div>
    </div>
    <div class="border-t border-gray-200">
      <% if @backup_jobs.any? %>
        <ul class="divide-y divide-gray-200">
          <% @backup_jobs.each do |job| %>
            <li class="px-4 py-4 sm:px-6">
              <div class="flex items-center justify-between">
                <div>
                  <%= link_to job.name, backup_job_path(job), class: "text-sm font-medium text-primary-500 hover:text-indigo-500" %>
                  <p class="text-sm text-gray-500"><%= job.database_config.name %> &middot; <%= job.schedule_type.titleize %></p>
                </div>
                <div class="flex items-center space-x-4">
                  <%= status_badge(job.enabled? ? "enabled" : "disabled") %>
                  <span class="text-xs text-gray-500"><%= job.backups.count %> backups</span>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="px-4 py-5 sm:px-6 text-center">
          <p class="text-sm text-gray-500">No backup jobs are using this storage backend.</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
