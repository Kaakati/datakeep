<%= form_with model: storage_backend, url: storage_backend.persisted? ? storage_backend_path(storage_backend) : storage_backends_path, class: "space-y-6", data: { controller: "storage-backend-form" } do |f| %>
  <% if storage_backend.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 dark:bg-red-900/20">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-red-800 dark:text-red-200">There were errors with your submission</h3>
          <div class="mt-2 text-sm text-red-700 dark:text-red-300">
            <ul class="list-disc space-y-1 pl-5">
              <% storage_backend.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="px-5 py-4 sm:px-6 sm:py-5">
      <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Basic Information</h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Configure the name and type of storage backend</p>
    </div>
    <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <%= f.label :name, class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= f.text_field :name, placeholder: "Production Backups", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
        </div>

        <div class="sm:col-span-2">
          <%= f.label :storage_type, "Storage Type", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <div class="relative">
            <%= f.select :storage_type, [["Local Storage", "local"], ["Amazon S3 / S3-Compatible", "s3"]], {}, class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90", data: { action: "change->storage-backend-form#toggleStorageType", storage_backend_form_target: "typeSelect" } %>
            <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
              </svg>
            </span>
          </div>
        </div>

        <div class="sm:col-span-2" x-data="{ checked: <%= storage_backend.is_default? ? 'true' : 'false' %> }">
          <label for="storage_backend_is_default" class="flex cursor-pointer items-center text-sm font-medium text-gray-700 select-none dark:text-gray-400">
            <div class="relative">
              <%= f.check_box :is_default, { class: "sr-only", "x-model": "checked" } %>
              <div :class="checked ? 'border-brand-500 bg-brand-500' : 'bg-transparent border-gray-300 dark:border-gray-700'" class="hover:border-brand-500 dark:hover:border-brand-500 mr-3 flex h-5 w-5 items-center justify-center rounded-md border-[1.25px]">
                <span :class="checked ? '' : 'opacity-0'">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11.6666 3.5L5.24992 9.91667L2.33325 7" stroke="white" stroke-width="1.94437" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </span>
              </div>
            </div>
            <div>
              <span class="text-sm font-medium text-gray-800 dark:text-white/90">Set as default storage</span>
              <p class="text-sm text-gray-500 dark:text-gray-400">New backup jobs will use this storage by default</p>
            </div>
          </label>
        </div>
      </div>
    </div>
  </div>

  <div id="local-storage-fields" class="<%= storage_backend.is_a?(StorageBackends::S3Storage) ? 'hidden' : '' %>" data-storage-backend-form-target="localFields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">Local Storage Configuration</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Configure the local filesystem path for backups</p>
      </div>
      <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div>
          <%= label_tag "storage_backend_config_path", "Storage Path", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
          <%= text_field_tag "storage_backend[config][path]", storage_backend.config&.dig(:path), id: "storage_backend_config_path", placeholder: "/var/backups/database-ops", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Absolute path where backup files will be stored</p>
        </div>
      </div>
    </div>
  </div>

  <div id="s3-storage-fields" class="<%= !storage_backend.is_a?(StorageBackends::S3Storage) ? 'hidden' : '' %>" data-storage-backend-form-target="s3Fields">
    <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
      <div class="px-5 py-4 sm:px-6 sm:py-5">
        <h3 class="text-base font-semibold text-gray-800 dark:text-white/90">S3 Configuration</h3>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Configure your S3 or S3-compatible storage credentials</p>
      </div>
      <div class="border-t border-gray-100 p-5 sm:p-6 dark:border-gray-800">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div>
            <%= label_tag "storage_backend_config_bucket", "Bucket", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= text_field_tag "storage_backend[config][bucket]", storage_backend.config&.dig(:bucket), id: "storage_backend_config_bucket", placeholder: "my-backup-bucket", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          </div>

          <div>
            <%= label_tag "storage_backend_config_region", "Region", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <%= select_tag "storage_backend[config][region]", options_for_select([
                ["Select a region", ""],
                ["US East (N. Virginia)", "us-east-1"],
                ["US East (Ohio)", "us-east-2"],
                ["US West (N. California)", "us-west-1"],
                ["US West (Oregon)", "us-west-2"],
                ["EU (Ireland)", "eu-west-1"],
                ["EU (London)", "eu-west-2"],
                ["EU (Frankfurt)", "eu-central-1"],
                ["Asia Pacific (Tokyo)", "ap-northeast-1"],
                ["Asia Pacific (Singapore)", "ap-southeast-1"],
                ["Asia Pacific (Sydney)", "ap-southeast-2"]
              ], storage_backend.config&.dig(:region)), id: "storage_backend_config_region", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full appearance-none rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" %>
              <span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 dark:text-gray-400">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                </svg>
              </span>
            </div>
          </div>

          <div class="sm:col-span-2">
            <%= label_tag "storage_backend_config_prefix", "Key Prefix (Optional)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= text_field_tag "storage_backend[config][prefix]", storage_backend.config&.dig(:prefix), id: "storage_backend_config_prefix", placeholder: "backups/production/", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">Optional prefix for organizing backups within the bucket</p>
          </div>

          <div class="sm:col-span-2">
            <%= label_tag "storage_backend_config_endpoint", "Custom Endpoint (Optional)", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= text_field_tag "storage_backend[config][endpoint]", storage_backend.config&.dig(:endpoint), id: "storage_backend_config_endpoint", placeholder: "https://s3.example.com", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
            <p class="mt-1.5 text-sm text-gray-500 dark:text-gray-400">For S3-compatible services (MinIO, DigitalOcean Spaces, etc.)</p>
          </div>

          <div>
            <%= label_tag "storage_backend_config_access_key_id", "Access Key ID", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <%= text_field_tag "storage_backend[config][access_key_id]", storage_backend.config&.dig(:access_key_id), id: "storage_backend_config_access_key_id", class: "shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30" %>
          </div>

          <div x-data="{ showPassword: false }">
            <%= label_tag "storage_backend_config_secret_access_key", "Secret Access Key", class: "mb-1.5 block text-sm font-medium text-gray-700 dark:text-gray-400" %>
            <div class="relative">
              <input
                type="password"
                name="storage_backend[config][secret_access_key]"
                id="storage_backend_config_secret_access_key"
                placeholder="<%= storage_backend.persisted? ? "Leave blank to keep current" : "" %>"
                :type="showPassword ? 'text' : 'password'"
                class="shadow-theme-xs focus:border-brand-300 focus:ring-brand-500/10 dark:focus:border-brand-800 h-11 w-full rounded-lg border border-gray-300 bg-transparent px-4 py-2.5 pr-11 text-sm text-gray-800 placeholder:text-gray-400 focus:ring-3 focus:outline-hidden dark:border-gray-700 dark:bg-gray-900 dark:text-white/90 dark:placeholder:text-white/30"
              />
              <button
                type="button"
                @click="showPassword = !showPassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200"
              >
                <svg x-show="!showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <svg x-show="showPassword" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display: none;">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="flex justify-end space-x-3">
    <%= link_to "Cancel", storage_backends_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03]" %>
    <%= f.submit storage_backend.persisted? ? "Update Storage" : "Create Storage", class: "inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white shadow-theme-xs hover:bg-brand-600 cursor-pointer" %>
  </div>
<% end %>
