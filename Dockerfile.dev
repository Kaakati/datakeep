# syntax=docker/dockerfile:1

# Database-Ops Development Dockerfile
#
# This Dockerfile is optimized for development with:
# - PostgreSQL client tools for backup/restore operations
# - Development dependencies included
# - Volume mounts for live code reloading

ARG RUBY_VERSION=3.4.7
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# Rails app lives here
WORKDIR /rails

# Switch default repos to HTTPS and add PostgreSQL APT repository
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates gnupg lsb-release wget && \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/*.sources 2>/dev/null; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list 2>/dev/null; \
    echo "deb https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/postgresql.gpg && \
    apt-get update -qq && \
    rm -rf /var/lib/apt/lists/*

# Install build essentials, database client tools, and MongoDB tools
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libyaml-dev pkg-config curl \
      libpq-dev postgresql-client-17 \
      default-mysql-client libmariadb-dev \
      gzip bzip2 xz-utils \
      libvips nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Install MongoDB Database Tools (mongodump, mongorestore)
RUN curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/mongodb.gpg && \
    echo "deb https://repo.mongodb.org/apt/debian $(lsb_release -cs)/mongodb-org/7.0 main" > /etc/apt/sources.list.d/mongodb-org.list && \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y mongodb-database-tools && \
    rm -rf /var/lib/apt/lists/*

# Install VPN client tools (separate layer to isolate potential conflicts)
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      openvpn strongswan strongswan-swanctl && \
    rm -rf /var/lib/apt/lists/*

# Set development environment
ENV RAILS_ENV=development \
    BUNDLE_PATH="/usr/local/bundle" \
    PATH="/rails/bin:${PATH}"

# Install bundler
RUN gem install bundler

# Copy Gemfile first for better caching
COPY Gemfile Gemfile.lock ./

# Install gems (including development and test groups)
RUN bundle install

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p storage backups tmp/pids tmp/cache log && \
    chmod -R 755 storage backups tmp log

# Default command
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
