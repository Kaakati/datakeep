# syntax=docker/dockerfile:1

# Database-Ops Development Dockerfile
#
# This Dockerfile is optimized for development with:
# - PostgreSQL client tools for backup/restore operations
# - Development dependencies included
# - Volume mounts for live code reloading

ARG RUBY_VERSION=3.4.2
FROM docker.io/library/ruby:$RUBY_VERSION-slim

# Rails app lives here
WORKDIR /rails

# Install system dependencies including PostgreSQL client tools
# Add PostgreSQL APT repository for latest client tools
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      ca-certificates \
      gnupg \
      lsb-release \
      wget && \
    echo "deb http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list && \
    wget --quiet -O - https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/trusted.gpg.d/postgresql.gpg && \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      # Build essentials for native gem extensions
      build-essential \
      git \
      libyaml-dev \
      pkg-config \
      # PostgreSQL development libraries and client tools
      libpq-dev \
      postgresql-client-18 \
      # Compression utilities
      gzip \
      bzip2 \
      xz-utils \
      # Process management
      curl \
      # Image processing
      libvips \
      # Node.js for JavaScript tooling (optional)
      nodejs \
      npm && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Set development environment
ENV RAILS_ENV=development \
    BUNDLE_PATH="/usr/local/bundle" \
    PATH="/rails/bin:${PATH}"

# Install bundler
RUN gem install bundler

# Copy Gemfile first for better caching
COPY Gemfile Gemfile.lock ./

# Install gems (including development and test groups)
RUN bundle install

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p storage backups tmp/pids tmp/cache log && \
    chmod -R 755 storage backups tmp log

# Default command
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
